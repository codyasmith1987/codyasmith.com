<script is:inline>
(function() {
  // Pricing constants tracking business-design-v2: Web Management is
  // Ecosystem A (under 30 pages); the Raised Bar Builders build is one
  // Small build at $5,625. F3 takeover onboarding is a flat $800
  // (heavier than a standard multi-site addition because of the audit
  // work). The Tailwater micro-site, when present, is an additional
  // managed site that takes the 0.80 per-site floor. Marketing
  // Consulting is Ecosystem B (Growing/Regional, $1M-$10M).
  var MGMT_TIERS = {
    good:   { name: 'Good',   base: 297,  onb: 800,  hoursBase: 3 },
    better: { name: 'Better', base: 497,  onb: 800,  hoursBase: 5 },
    best:   { name: 'Best',   base: 647,  onb: 1000, hoursBase: 8 }
  };
  var CONSULTING_TIERS = {
    good:   { name: 'Good',   monthly: 497,  audit: 1500 },
    better: { name: 'Better', monthly: 997,  audit: 2500 },
    best:   { name: 'Best',   monthly: 1497, audit: 4000 }
  };
  var BUILD_BUILDERS = 5625;
  var BUILD_TAILWATER = 4500;
  var F3_ONBOARDING = 800;

  var state = {
    mgmtTier: null,
    option: null,
    consulting: null,
    consultingTier: null
  };

  function money(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function moneyInt(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function mgmtMonthly(tier, option) {
    if (!tier) return 0;
    var base = MGMT_TIERS[tier].base;
    var sites = option === 'o2' ? 3 : 2;
    return base + (sites - 1) * base * 0.80;
  }
  function mgmtMultiSiteExtraOnb(tier, option) {
    if (option !== 'o2') return 0;
    return MGMT_TIERS[tier].onb * 0.25;
  }
  function oneTimeBreakdown() {
    var rows = [];
    if (state.mgmtTier && state.option) {
      var mgmtOnb = MGMT_TIERS[state.mgmtTier].onb;
      rows.push(['Builders site build', BUILD_BUILDERS]);
      rows.push(['Builders Web Management onboarding', mgmtOnb]);
      rows.push(['F3 Properties takeover onboarding', F3_ONBOARDING]);
      if (state.option === 'o2') {
        rows.push(['Tailwater micro-site build', BUILD_TAILWATER]);
        rows.push(['Tailwater multi-site onboarding addition', mgmtMultiSiteExtraOnb(state.mgmtTier, state.option)]);
      }
      if (state.consulting === 'yes' && state.consultingTier) {
        rows.push(['Marketing Consulting initial audit', CONSULTING_TIERS[state.consultingTier].audit]);
      }
    }
    return rows;
  }
  function oneTimeTotal() {
    return oneTimeBreakdown().reduce(function(s, r) { return s + r[1]; }, 0);
  }
  function monthlyTotal() {
    var m = mgmtMonthly(state.mgmtTier, state.option);
    if (state.consulting === 'yes' && state.consultingTier) {
      m += CONSULTING_TIERS[state.consultingTier].monthly;
    }
    return m;
  }
  function complete() {
    if (!state.mgmtTier || !state.option) return false;
    if (state.consulting === 'no') return true;
    if (state.consulting === 'yes' && state.consultingTier) return true;
    return false;
  }

  // Signer role from <body data-signer-role="..."> set by the Astro
  // frontmatter. 'jason' and 'kevin' are real signers; 'admin' is the
  // owner previewing; 'other' should never happen because middleware
  // gates non-Roth-Group clients away earlier.
  var SIGNER_ROLE = document.body.getAttribute('data-signer-role') || 'other';
  var DRAFT_URL = '/portal/api/proposals/raised-bar/accept';

  function getCsrf() {
    var el = document.querySelector('meta[name="csrf-token"]');
    return el ? (el.getAttribute('content') || '') : '';
  }

  function saveDraft(payload) {
    if (SIGNER_ROLE !== 'jason' && SIGNER_ROLE !== 'kevin') {
      return Promise.resolve(null);
    }
    return fetch(DRAFT_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrf() },
      body: JSON.stringify(payload || {}),
    }).then(function(res) {
      return res.json().then(function(data) { return { ok: res.ok, data: data }; });
    });
  }

  function loadDraft() {
    return fetch(DRAFT_URL, {
      method: 'GET',
      headers: { 'Accept': 'application/json' },
    }).then(function(res) {
      return res.json().then(function(data) { return { ok: res.ok, data: data }; });
    });
  }

  function applyDraftToState(draft) {
    if (!draft) return;
    state.mgmtTier = draft.mgmt_tier || null;
    state.option = draft.option || null;
    state.consulting = draft.consulting || null;
    state.consultingTier = draft.consulting_tier || null;
    state.jasonSig = draft.jason_signature || null;
    state.kevinSig = draft.kevin_signature || null;
    state.finalizedAt = draft.finalized_at || null;
  }

  state.jasonSig = null;
  state.kevinSig = null;
  state.finalizedAt = null;

  function setSummary(id, text, isSelected) {
    var el = document.getElementById(id);
    if (!el) return;
    el.textContent = text;
    el.classList.toggle('selected', !!isSelected);
  }

  function update() {
    // Mgmt tier highlight
    var tierCards = document.querySelectorAll('[data-tier]');
    for (var i = 0; i < tierCards.length; i++) {
      tierCards[i].classList.toggle('selected', tierCards[i].getAttribute('data-tier') === state.mgmtTier);
    }

    // Reveal Step 2 (option) when mgmt tier picked + update tier-keyed prices
    var optionChoice = document.getElementById('option-choice');
    var step2Prompt = document.getElementById('step2-prompt');
    if (state.mgmtTier) {
      if (optionChoice) optionChoice.classList.add('revealed');
      if (step2Prompt) step2Prompt.style.display = 'none';
      var o1mEl = document.getElementById('o1-monthly');
      var o2mEl = document.getElementById('o2-monthly');
      var o1onbEl = document.getElementById('o1-onb');
      var o2extraEl = document.getElementById('o2-extra-onb');
      if (o1mEl) o1mEl.textContent = money(mgmtMonthly(state.mgmtTier, 'o1'));
      if (o2mEl) o2mEl.textContent = money(mgmtMonthly(state.mgmtTier, 'o2'));
      if (o1onbEl) o1onbEl.textContent = moneyInt(MGMT_TIERS[state.mgmtTier].onb);
      if (o2extraEl) o2extraEl.textContent = moneyInt(MGMT_TIERS[state.mgmtTier].onb * 0.25);
    } else {
      if (optionChoice) optionChoice.classList.remove('revealed');
      if (step2Prompt) step2Prompt.style.display = '';
    }

    // Option highlight
    var optionCards = document.querySelectorAll('[data-option]');
    for (var j = 0; j < optionCards.length; j++) {
      optionCards[j].classList.toggle('selected', optionCards[j].getAttribute('data-option') === state.option);
    }

    // Reveal Step 3
    var consultingChoice = document.getElementById('consulting-choice');
    var step3Prompt = document.getElementById('step3-prompt');
    if (state.option) {
      if (consultingChoice) consultingChoice.classList.add('revealed');
      if (step3Prompt) step3Prompt.style.display = 'none';
    } else {
      if (consultingChoice) consultingChoice.classList.remove('revealed');
      if (step3Prompt) step3Prompt.style.display = '';
    }

    // Consulting yes/no highlight
    var consultingCards = document.querySelectorAll('[data-consulting]');
    for (var k = 0; k < consultingCards.length; k++) {
      consultingCards[k].classList.toggle('selected', consultingCards[k].getAttribute('data-consulting') === state.consulting);
    }

    // Reveal Step 4
    var consultingH2 = document.getElementById('consulting-step-h2');
    var step4Prompt = document.getElementById('step4-prompt');
    var consultingTiers = document.getElementById('consulting-tiers');
    if (state.consulting === 'yes') {
      if (consultingH2) consultingH2.classList.remove('step-hidden');
      if (step4Prompt) step4Prompt.classList.remove('step-hidden');
      if (consultingTiers) consultingTiers.classList.add('revealed');
    } else {
      if (consultingH2) consultingH2.classList.add('step-hidden');
      if (step4Prompt) step4Prompt.classList.add('step-hidden');
      if (consultingTiers) consultingTiers.classList.remove('revealed');
      if (state.consulting === 'no') state.consultingTier = null;
    }

    // Consulting tier highlight
    var consultingTierCards = document.querySelectorAll('[data-consulting-tier]');
    for (var n = 0; n < consultingTierCards.length; n++) {
      consultingTierCards[n].classList.toggle('selected', consultingTierCards[n].getAttribute('data-consulting-tier') === state.consultingTier);
    }

    // Form summary
    setSummary('summary-tier',
      state.mgmtTier ? MGMT_TIERS[state.mgmtTier].name : 'Pick above',
      !!state.mgmtTier);
    if (state.option === 'o1') setSummary('summary-option', 'Option 1: Single unified site', true);
    else if (state.option === 'o2') setSummary('summary-option', 'Option 2: Split setup (with micro-site)', true);
    else setSummary('summary-option', 'Pick above', false);
    if (state.consulting === 'no') setSummary('summary-consulting', 'Skipped', true);
    else if (state.consulting === 'yes' && state.consultingTier) setSummary('summary-consulting', 'Yes, ' + CONSULTING_TIERS[state.consultingTier].name, true);
    else if (state.consulting === 'yes') setSummary('summary-consulting', 'Yes, pick a level above', false);
    else setSummary('summary-consulting', 'Pick above', false);
    if (complete()) {
      setSummary('summary-onetime', moneyInt(oneTimeTotal()), true);
      setSummary('summary-monthly', money(monthlyTotal()) + ' / month', true);
    } else {
      setSummary('summary-onetime', '—', false);
      setSummary('summary-monthly', '—', false);
    }

    // Per-signer name field display.
    var jasonBlock = document.querySelector('[data-signer-block="jason"]');
    var kevinBlock = document.querySelector('[data-signer-block="kevin"]');
    var jasonInput = document.getElementById('jason-name');
    var kevinInput = document.getElementById('kevin-name');
    var jasonStatus = document.getElementById('jason-status');
    var kevinStatus = document.getElementById('kevin-status');

    function configureBlock(block, input, status, sig, role) {
      if (!block || !input || !status) return;
      if (sig) {
        // Already signed — show as static "Signed: <name>"
        block.classList.add('field-signed');
        block.classList.remove('field-readonly');
        status.classList.add('signed');
        status.textContent = sig;
      } else {
        status.classList.remove('signed');
        if (SIGNER_ROLE === role) {
          // Own field, editable
          block.classList.remove('field-readonly');
          input.disabled = false;
          status.textContent = '';
        } else if (SIGNER_ROLE === 'admin') {
          // Admin sees both but they are read-only
          block.classList.add('field-readonly');
          input.disabled = true;
          status.textContent = 'Awaiting ' + (role === 'jason' ? 'Jason' : 'Kevin') + '. (Admin preview)';
        } else {
          // Other-signer view: read-only, just shows status
          block.classList.add('field-readonly');
          input.disabled = true;
          input.placeholder = '(awaiting)';
          status.textContent = 'Awaiting ' + (role === 'jason' ? 'Jason Roth' : 'Kevin Adams') + '.';
        }
      }
    }

    configureBlock(jasonBlock, jasonInput, jasonStatus, state.jasonSig, 'jason');
    configureBlock(kevinBlock, kevinInput, kevinStatus, state.kevinSig, 'kevin');

    // Send button text + enable based on who is signing and state.
    var sendBtn = document.getElementById('send-proposal');
    var revokeBtn = document.getElementById('revoke-signature');
    var formNote = document.getElementById('form-note');
    if (sendBtn) {
      if (state.finalizedAt) {
        sendBtn.disabled = true;
        sendBtn.textContent = 'Engagement accepted';
        if (revokeBtn) revokeBtn.classList.add('step-hidden');
      } else if (SIGNER_ROLE === 'admin') {
        sendBtn.disabled = true;
        sendBtn.textContent = 'Admin preview — submit disabled';
        if (formNote) formNote.textContent = 'Admin preview. The proposal must be signed by Jason or Kevin.';
        if (revokeBtn) revokeBtn.classList.add('step-hidden');
      } else if (SIGNER_ROLE !== 'jason' && SIGNER_ROLE !== 'kevin') {
        sendBtn.disabled = true;
        sendBtn.textContent = 'Signing not available for this user';
        if (revokeBtn) revokeBtn.classList.add('step-hidden');
      } else {
        var myInput = SIGNER_ROLE === 'jason' ? jasonInput : kevinInput;
        var mySig = SIGNER_ROLE === 'jason' ? state.jasonSig : state.kevinSig;
        var otherSig = SIGNER_ROLE === 'jason' ? state.kevinSig : state.jasonSig;
        var myName = myInput ? myInput.value.trim() : '';
        if (mySig) {
          sendBtn.disabled = true;
          sendBtn.textContent = 'You signed. Waiting on the other.';
          if (formNote) formNote.textContent = 'Your signature is in. The other person will see your selections when they log in and can countersign. If you want to change anything, revoke your signature first.';
          if (revokeBtn) revokeBtn.classList.remove('step-hidden');
        } else {
          sendBtn.disabled = !(complete() && myName);
          if (otherSig) {
            sendBtn.textContent = 'Countersign and accept';
            if (formNote) formNote.textContent = 'The other person already signed. You can change any selection before countersigning — they will get an email about the change. Type your name and click countersign to accept and finalize.';
          } else {
            sendBtn.textContent = 'Save my signature';
            if (formNote) formNote.textContent = 'Your selections save as you go. Type your name and click to save your signature; the other person will get an email asking them to log in and countersign.';
          }
          if (revokeBtn) revokeBtn.classList.add('step-hidden');
        }
      }
    }

    // Partner banner near the top of the page. Shows when there is
    // visible activity from the OTHER signer (signature OR just
    // selections in progress) and the current user has not yet seen it.
    var banner = document.getElementById('partner-banner');
    var bannerText = document.getElementById('partner-banner-text');
    if (banner && bannerText) {
      var role = SIGNER_ROLE;
      var otherSigForBanner = role === 'jason' ? state.kevinSig
                              : role === 'kevin' ? state.jasonSig : null;
      var otherName = role === 'jason' ? 'Kevin' : role === 'kevin' ? 'Jason' : null;
      var anySelections = !!(state.mgmtTier || state.option || state.consulting);
      if (state.finalizedAt) {
        banner.classList.add('step-hidden');
      } else if (otherSigForBanner && otherName) {
        banner.classList.remove('step-hidden');
        bannerText.textContent = otherName + ' has signed under the selections below. Review them and countersign at the bottom of the page. Change any selection if you want different terms — ' + otherName + ' will get an email about the change.';
      } else if (anySelections && otherName && (role === 'jason' || role === 'kevin')) {
        // Other has started picking but not signed yet
        banner.classList.remove('step-hidden');
        bannerText.textContent = otherName + ' started picking and has not signed yet. The selections below are what they picked so far. Continue where they left off or change anything.';
      } else {
        banner.classList.add('step-hidden');
      }
    }
  }

  function scrollTo(id) {
    var target = document.getElementById(id);
    if (target) setTimeout(function() { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 140);
  }

  function persistSelections() {
    if (SIGNER_ROLE !== 'jason' && SIGNER_ROLE !== 'kevin') return;
    saveDraft({
      mgmt_tier: state.mgmtTier,
      option: state.option,
      consulting: state.consulting,
      consulting_tier: state.consultingTier,
    }).catch(function() { /* silent — UI is optimistic */ });
  }

  // Wire up mgmt tier cards
  var tierCards = document.querySelectorAll('[data-tier]');
  for (var ti = 0; ti < tierCards.length; ti++) {
    (function(card) {
      card.addEventListener('click', function() {
        if (state.finalizedAt) return;
        state.mgmtTier = card.getAttribute('data-tier');
        update();
        persistSelections();
        if (!state.option) scrollTo('option-choice');
      });
    })(tierCards[ti]);
  }

  // Wire up option (o1/o2) cards
  var optionCards = document.querySelectorAll('[data-option]');
  for (var oi = 0; oi < optionCards.length; oi++) {
    (function(card) {
      card.addEventListener('click', function() {
        if (state.finalizedAt) return;
        state.option = card.getAttribute('data-option');
        update();
        persistSelections();
        if (!state.consulting) scrollTo('consulting-choice');
      });
    })(optionCards[oi]);
  }

  // Wire up consulting yes/no cards
  var consultingCards = document.querySelectorAll('[data-consulting]');
  for (var ci = 0; ci < consultingCards.length; ci++) {
    (function(card) {
      card.addEventListener('click', function() {
        if (state.finalizedAt) return;
        state.consulting = card.getAttribute('data-consulting');
        update();
        persistSelections();
        if (state.consulting === 'yes' && !state.consultingTier) scrollTo('consulting-tiers');
        else if (state.consulting === 'no') scrollTo('proposal-form-container');
      });
    })(consultingCards[ci]);
  }

  // Wire up consulting tier cards
  var consultingTierCards = document.querySelectorAll('[data-consulting-tier]');
  for (var cti = 0; cti < consultingTierCards.length; cti++) {
    (function(card) {
      card.addEventListener('click', function() {
        if (state.finalizedAt) return;
        state.consultingTier = card.getAttribute('data-consulting-tier');
        update();
        persistSelections();
        scrollTo('proposal-form-container');
      });
    })(consultingTierCards[cti]);
  }

  // Wire up name inputs (only update UI; signature is persisted via Send click)
  var inputIds = ['jason-name', 'kevin-name'];
  for (var ii = 0; ii < inputIds.length; ii++) {
    var el = document.getElementById(inputIds[ii]);
    if (el) el.addEventListener('input', update);
  }

  // Wire up send (signs the current user's signature, finalizes if both signed)
  var sendBtn = document.getElementById('send-proposal');
  if (sendBtn) {
    sendBtn.addEventListener('click', function() {
      if (SIGNER_ROLE !== 'jason' && SIGNER_ROLE !== 'kevin') return;
      var myInput = SIGNER_ROLE === 'jason' ? document.getElementById('jason-name') : document.getElementById('kevin-name');
      var signature = myInput ? myInput.value.trim() : '';
      if (!signature) return;
      sendBtn.disabled = true;
      sendBtn.textContent = 'Saving...';
      saveDraft({
        mgmt_tier: state.mgmtTier,
        option: state.option,
        consulting: state.consulting,
        consulting_tier: state.consultingTier,
        signature: signature,
      }).then(function(result) {
        if (!result.ok) {
          var msg = (result.data && result.data.error) || 'Save failed. Email cody@codyasmith.com directly if this keeps happening.';
          alert(msg);
          update();
          return;
        }
        if (result.data && result.data.draft) {
          applyDraftToState(result.data.draft);
          if (result.data.status === 'finalized') state.finalizedAt = state.finalizedAt || new Date().toISOString();
        }
        if (result.data && result.data.status === 'finalized') {
          var container = document.getElementById('proposal-form-container');
          var emails = (result.data && result.data.confirmation_emails) || 'you both and Cody';
          container.innerHTML =
            '<div class="success-message">' +
              '<h3>Engagement accepted.</h3>' +
              '<p>Both signatures are in. Cody will send the formal contracts and the first invoice in the next few days. Reach him at <a href="mailto:cody@codyasmith.com">cody@codyasmith.com</a> or call or text any time with questions.</p>' +
              '<p class="success-note">Confirmation sent to ' + emails + '.</p>' +
            '</div>';
          window.scrollTo({ top: container.offsetTop - 32, behavior: 'smooth' });
        } else {
          update();
        }
      }).catch(function() {
        alert('Connection error. Try again or email cody@codyasmith.com.');
        update();
      });
    });
  }

  // Wire up revoke (clears the current signer's own signature)
  var revokeBtn = document.getElementById('revoke-signature');
  if (revokeBtn) {
    revokeBtn.addEventListener('click', function() {
      if (SIGNER_ROLE !== 'jason' && SIGNER_ROLE !== 'kevin') return;
      if (!confirm('Revoke your signature on the Raised Bar proposal? The other person will get an email about this. You can re-sign after.')) return;
      revokeBtn.disabled = true;
      revokeBtn.textContent = 'Revoking...';
      saveDraft({ revoke: true }).then(function(result) {
        if (!result.ok) {
          alert((result.data && result.data.error) || 'Revoke failed.');
          revokeBtn.disabled = false;
          revokeBtn.textContent = 'Revoke my signature';
          return;
        }
        if (result.data && result.data.draft) applyDraftToState(result.data.draft);
        revokeBtn.disabled = false;
        revokeBtn.textContent = 'Revoke my signature';
        update();
      }).catch(function() {
        alert('Connection error. Try again or email cody@codyasmith.com.');
        revokeBtn.disabled = false;
        revokeBtn.textContent = 'Revoke my signature';
      });
    });
  }

  // Initial load: pull the draft from the server, populate state, render.
  loadDraft().then(function(result) {
    if (result.ok && result.data && result.data.draft) {
      applyDraftToState(result.data.draft);
    }
    update();
    if (state.finalizedAt) {
      // Already finalized — collapse the form into a static confirmation panel.
      var container = document.getElementById('proposal-form-container');
      if (container) {
        container.innerHTML =
          '<div class="success-message">' +
            '<h3>Engagement accepted.</h3>' +
            '<p>Both signatures are in. Formal contracts and the first invoice follow within the week.</p>' +
          '</div>';
      }
    }
  }).catch(function() {
    // If draft fetch fails, still render UI from empty state.
    update();
  });
})();
</script>
</body>
</html>
