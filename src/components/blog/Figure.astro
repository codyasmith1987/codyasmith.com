---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  credit?: string;
  wide?: boolean;
  // Optional explicit dimensions. When passed, the browser reserves
  // layout space before the image loads, eliminating CLS. See
  // seo-audit-2026-05-12 round 2 SEO2-004.
  width?: number;
  height?: number;
}

const { src, alt, caption, credit, wide = false, width, height } = Astro.props;
---

<figure class={`blog-figure my-10 ${wide ? 'blog-figure-wide' : ''}`}>
  <img
    src={src}
    alt={alt}
    loading="lazy"
    decoding="async"
    width={width}
    height={height}
    class="w-full rounded-lg block"
  />
  {(caption || credit) && (
    <figcaption class="mt-3 text-[0.85rem] text-neutral-500 leading-relaxed flex justify-between gap-4">
      {caption && <span>{caption}</span>}
      {credit && <span class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-600 whitespace-nowrap">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .blog-figure-wide {
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    max-width: 100vw;
  }
  @media (min-width: 1024px) {
    .blog-figure-wide {
      margin-left: -8rem;
      margin-right: -8rem;
      max-width: none;
    }
  }
</style>
