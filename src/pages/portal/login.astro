---
import '../../styles/global.css';
export const prerender = false;

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('portal_session')?.value;
if (token) {
  const { validateSession } = await import('../../lib/auth');
  const result = await validateSession(token);
  if (result) return Astro.redirect('/portal/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Log In — Client Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-300 font-sans flex items-center justify-center relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[400px] bg-amber-500/[0.04] rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative w-full max-w-sm mx-auto px-6">
      <!-- Back link -->
      <a href="/" class="inline-flex items-center gap-2 text-xs text-neutral-600 hover:text-amber-400 transition-colors duration-300 mb-12">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        codyasmith.com
      </a>

      <div class="text-center mb-10">
        <h1 class="font-serif text-4xl text-neutral-100 mb-3">Client Portal</h1>
      </div>

      <div id="login-form-container">
        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-all duration-300"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label for="password" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-all duration-300"
              placeholder="Your password"
            />
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none"
          >
            Log in
          </button>
        </form>
      </div>

      <div id="error-message" class="hidden mt-6 p-4 bg-red-500/5 border border-red-500/15 rounded-lg text-sm text-red-400 leading-relaxed"></div>

      <p class="text-center text-xs text-neutral-700 mt-12">
        Don't have access yet? <a href="mailto:cody@codyasmith.com?subject=Portal%20Access%20Request" class="text-neutral-500 hover:text-amber-400 transition-colors duration-300">Request it here</a>
      </p>
    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('error-message')!;

      // Show error from redirect (e.g. expired session, inactive account)
      const urlError = new URLSearchParams(window.location.search).get('error');
      if (urlError === 'expired') {
        errorEl.textContent = 'Your session has expired. Please log in again.';
        errorEl.classList.remove('hidden');
      } else if (urlError === 'inactive') {
        errorEl.textContent = 'Your account is currently inactive. Contact Cody if you think this is a mistake.';
        errorEl.classList.remove('hidden');
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Logging in...';
        errorEl.classList.add('hidden');

        const email = (form.querySelector('#email') as HTMLInputElement).value;
        const password = (form.querySelector('#password') as HTMLInputElement).value;

        try {
          const res = await fetch('/portal/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const data = await res.json();

          if (res.ok) {
            window.location.href = '/portal/dashboard';
          } else {
            errorEl.textContent = data.error || 'Login failed';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Log in';
          }
        } catch (err: any) {
          errorEl.textContent = 'Connection error. Try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Log in';
        }
      });
    </script>
  </body>
</html>
