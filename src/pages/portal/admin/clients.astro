---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
export const prerender = false;

const clients = await getAllClients();
---

<Portal title="Manage Clients">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-semibold text-neutral-100">Clients</h1>
    </div>

    <!-- Create client form -->
    <form id="create-client-form" class="bg-neutral-900/50 border border-white/5 rounded-xl p-6 mb-8">
      <h2 class="text-sm font-medium text-neutral-300 mb-4">Add new client</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="client-name" class="block text-xs text-neutral-500 mb-1">Business name</label>
          <input
            type="text"
            id="client-name"
            name="name"
            required
            class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40"
            placeholder="ZipKit Homes"
          />
        </div>
        <div>
          <label for="client-slug" class="block text-xs text-neutral-500 mb-1">Slug (URL-safe)</label>
          <input
            type="text"
            id="client-slug"
            name="slug"
            required
            pattern="[a-z0-9\-]+"
            class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40"
            placeholder="zipkit-homes"
          />
        </div>
      </div>
      <button type="submit" class="mt-4 px-4 py-2 bg-amber-500 text-neutral-950 font-medium text-sm rounded-lg hover:bg-amber-400 transition-colors">
        Create client
      </button>
      <p id="client-msg" class="mt-3 text-sm hidden"></p>
    </form>

    <!-- Client list -->
    {clients.length > 0 ? (
      <div class="space-y-3">
        {clients.map(client => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-lg p-4 flex items-center justify-between group" data-client-row={client.id}>
            <div>
              <p class="text-sm font-medium text-neutral-200">{client.name}</p>
              <p class="text-xs text-neutral-500">{client.slug}</p>
            </div>
            <div class="flex items-center gap-3">
              <span
                data-client-badge={client.id}
                class:list={[
                  'text-xs px-2 py-0.5 rounded-full',
                  client.active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-700 text-neutral-400',
                ]}
              >
                {client.active ? 'Active' : 'Inactive'}
              </span>
              <button
                data-toggle-client={client.id}
                data-client-active={client.active ? '1' : '0'}
                class="text-xs text-neutral-500 hover:text-amber-400 transition-colors opacity-0 group-hover:opacity-100"
              >
                {client.active ? 'Deactivate' : 'Activate'}
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-neutral-500">No clients yet. Create one above.</p>
    )}
  </div>

  <script>
    // Toggle active/inactive
    document.querySelectorAll('[data-toggle-client]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const clientId = (btn as HTMLElement).dataset.toggleClient!;
        const isActive = (btn as HTMLElement).dataset.clientActive === '1';

        if (isActive && !confirm('Deactivate this client? Their users won\'t be able to log in.')) return;

        const res = await fetch('/portal/api/admin/toggle-client', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ client_id: clientId }),
        });

        if (res.ok) {
          const data = await res.json();
          const badge = document.querySelector(`[data-client-badge="${clientId}"]`)!;
          badge.textContent = data.active ? 'Active' : 'Inactive';
          badge.className = `text-xs px-2 py-0.5 rounded-full ${data.active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-700 text-neutral-400'}`;
          (btn as HTMLElement).textContent = data.active ? 'Deactivate' : 'Activate';
          (btn as HTMLElement).dataset.clientActive = data.active ? '1' : '0';
        }
      });
    });

    const form = document.getElementById('create-client-form') as HTMLFormElement;
    const msg = document.getElementById('client-msg')!;
    const nameInput = document.getElementById('client-name') as HTMLInputElement;
    const slugInput = document.getElementById('client-slug') as HTMLInputElement;

    // Auto-generate slug from name
    nameInput.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }
    });
    slugInput.addEventListener('input', () => { slugInput.dataset.manual = '1'; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const res = await fetch('/portal/api/admin/create-client', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          slug: slugInput.value.trim(),
        }),
      });

      const data = await res.json();
      if (res.ok) {
        msg.textContent = `Created "${data.name}"`;
        msg.className = 'mt-3 text-sm text-emerald-400';
        msg.classList.remove('hidden');
        form.reset();
        slugInput.dataset.manual = '';
        setTimeout(() => location.reload(), 800);
      } else {
        msg.textContent = data.error || 'Failed';
        msg.className = 'mt-3 text-sm text-red-400';
        msg.classList.remove('hidden');
      }
    });
  </script>
</Portal>
