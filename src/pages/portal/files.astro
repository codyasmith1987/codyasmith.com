---
import Portal from '../../layouts/Portal.astro';
import { getFilesForClient, getAllFilesAdmin, fileCategoryLabel, ISSUABLE_FILE_CATEGORIES, FILE_CATEGORY_LABELS } from '../../lib/storage';
import { getAllClients } from '../../lib/auth';
export const prerender = false;

// Categories an admin can assign at upload (excludes internal_draft, which is
// admin-only auto-generated, and the legacy 'report'). Labels come from the
// canonical taxonomy so this can't drift from storage.ts.
const UPLOAD_CATEGORY_KEYS = ['strategic_recommendation', 'performance_summary', 'site_health_report', 'advisory', 'research', 'invoice', 'spreadsheet', 'general'];
const uploadCategories = UPLOAD_CATEGORY_KEYS.map(k => ({ value: k, label: FILE_CATEGORY_LABELS[k] || k }));

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';

const files = isAdmin
  ? await getAllFilesAdmin()
  : user.client_id
    ? await getFilesForClient(user.client_id)
    : [];

const clients = isAdmin ? await getAllClients() : [];

// Group files by month
const byMonth = new Map<string, typeof files>();
for (const f of files) {
  const month = f.month;
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(f);
}
const months = [...byMonth.keys()].sort().reverse();

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

const categoryLabel = fileCategoryLabel;
---

<Portal title="Files">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Deliverables</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Files</h1>
      </div>
    </div>

    {/* Admin upload form */}
    {isAdmin && (
      <form id="upload-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
        <p class="text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-5">Upload files</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Client</label>
            <select id="upload-client" name="client_id" required class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
              <option value="">Select...</option>
              {clients.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Month (default)</label>
            <input type="month" id="upload-month" name="month" required
              value={new Date().toISOString().slice(0, 7)}
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Files</label>
            <input type="file" id="upload-file" name="file" multiple required
              accept=".pdf,.docx,.xlsx,.xls,.csv,.png,.jpg,.jpeg,.webp"
              class="w-full text-sm text-neutral-500 file:mr-3 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-500 file:text-neutral-950 hover:file:bg-amber-400 file:cursor-pointer file:transition-colors file:duration-300" />
            <p class="text-[10px] text-neutral-500 mt-2 leading-relaxed">Drop several at once. Each file's site, type, and month are auto-detected from its name (fix any before uploading). Strategic Recommendations, Performance Summaries, Site Health Reports, Advisories, and Research Reports stay private until you send them; everything else is visible to the client right away.</p>
          </div>
        </div>

        {/* Per-file auto-tagged rows, populated by JS after files are picked. */}
        <div id="file-stage" class="hidden mt-6 space-y-2"></div>

        <div class="mt-6 flex items-center gap-4">
          <button type="submit" id="upload-btn" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)] disabled:opacity-50 disabled:hover:shadow-none">
            Upload all
          </button>
          <span id="upload-progress" class="text-sm text-neutral-400 hidden"></span>
        </div>

        <script type="application/json" id="upload-categories" set:html={JSON.stringify(uploadCategories)}></script>
      </form>
    )}

    {/* File list grouped by month */}
    {months.length > 0 ? (
      months.map(month => (
        <div class="mb-10">
          <p class="text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-4">
            {new Date(month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          </p>
          <div class="space-y-2">
            {byMonth.get(month)!.map(f => {
              const issuable = isAdmin && ISSUABLE_FILE_CATEGORIES.includes(f.category);
              const issued = issuable && !!f.issued_at;
              return (
              <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-center justify-between group hover:border-white/10 transition-all duration-300">
                <div class="flex items-center gap-4 min-w-0">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-200 truncate">{f.original_name}</p>
                    <div class="flex items-center gap-3 mt-1">
                      <span class="text-[10px] font-mono text-neutral-400">{formatBytes(f.size_bytes)}</span>
                      <span class="text-[10px] text-neutral-500">{categoryLabel(f.category)}</span>
                      {'client_name' in f && <span class="text-[10px] text-neutral-500">{f.client_name}</span>}
                      {issuable && !issued && <span class="px-2 py-0.5 text-[10px] font-mono uppercase rounded bg-neutral-700/40 text-neutral-400" data-issue-badge={f.id}>Private</span>}
                      {issued && <span class="px-2 py-0.5 text-[10px] font-mono uppercase rounded bg-emerald-500/10 text-emerald-400" data-issue-badge={f.id}>Sent</span>}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  {issuable && !issued && (
                    <button
                      data-issue-file={f.id}
                      data-issue-name={f.original_name}
                      class="px-4 py-2 text-xs font-medium text-emerald-400 border border-emerald-500/30 rounded-lg hover:bg-emerald-500/10 transition-all duration-300"
                    >
                      Send to client
                    </button>
                  )}
                  <a
                    href={`/portal/api/files/download?id=${f.id}`}
                    class="px-4 py-2 text-xs font-medium text-amber-600 border border-amber-500/20 rounded-lg hover:bg-amber-500/10 transition-all duration-300"
                  >
                    Download
                  </a>
                  {isAdmin && (
                    <button
                      data-delete-file={f.id}
                      class="px-4 py-2 text-xs text-neutral-400 border border-white/5 rounded-lg hover:text-red-400 hover:border-red-500/20 transition-all duration-300 opacity-0 group-hover:opacity-100"
                    >
                      Delete
                    </button>
                  )}
                </div>
              </div>
              );
            })}
          </div>
        </div>
      ))
    ) : (
      <div class="text-center py-24">
        <p class="font-serif text-2xl text-neutral-100 mb-3">No files yet</p>
        <p class="text-sm text-neutral-500 leading-relaxed max-w-xs mx-auto">
          {isAdmin ? 'Use the form above to upload reports, invoices, and deliverables.' : 'Your files and deliverables will appear here.'}
        </p>
      </div>
    )}
  </div>

  <script>
    // Upload handler
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    if (form) {
      const btn = document.getElementById('upload-btn') as HTMLButtonElement;
      const progress = document.getElementById('upload-progress')!;
      const fileInput = document.getElementById('upload-file') as HTMLInputElement;
      const clientSel = document.getElementById('upload-client') as HTMLSelectElement;
      const monthDefault = document.getElementById('upload-month') as HTMLInputElement;
      const stage = document.getElementById('file-stage')!;
      const uploadCategories: Array<{ value: string; label: string }> =
        JSON.parse(document.getElementById('upload-categories')?.textContent || '[]');

      // The picked File objects, paired with their rendered editable rows.
      let staged: Array<{ file: File; row: HTMLElement }> = [];
      // Generation guard: a slow detect-tags response from an earlier pick must
      // not overwrite a newer one if the user changes files/client rapidly.
      let restageGen = 0;

      const esc = (s: any) => String(s ?? '')
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

      const catOptions = (selected: string) => uploadCategories
        .map(c => `<option value="${esc(c.value)}"${c.value === selected ? ' selected' : ''}>${esc(c.label)}</option>`)
        .join('');

      const siteOptions = (sites: Array<{ id: string; domain: string; is_primary: boolean }>, selectedId: string | null) =>
        ['<option value="">Not site-specific</option>']
          .concat(sites.map(s => `<option value="${esc(s.id)}"${s.id === selectedId ? ' selected' : ''}>${esc(s.domain)}${s.is_primary ? ' (primary)' : ''}</option>`))
          .join('');

      // On every file/client change, ask the server to auto-tag the filenames
      // for the picked client and render an editable row per file.
      async function restage() {
        const gen = ++restageGen;
        const files = Array.from(fileInput.files || []);
        const clientId = clientSel.value;
        staged = [];
        if (files.length === 0) { stage.classList.add('hidden'); stage.innerHTML = ''; return; }
        stage.classList.remove('hidden');
        if (!clientId) { stage.innerHTML = '<p class="text-xs text-amber-500/90">Pick a client first to auto-detect site and type.</p>'; return; }

        stage.innerHTML = '<p class="text-xs text-neutral-400">Reading filenames...</p>';
        let detect: any;
        try {
          const res = await fetch('/portal/api/files/detect-tags', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ client_id: clientId, filenames: files.map(f => f.name) }),
          });
          detect = await res.json();
          if (!res.ok) throw new Error(detect.error || 'Auto-detect failed');
        } catch {
          // Detection is best-effort; fall back to blank tags so upload still works.
          detect = { sites: [], results: files.map(f => ({ filename: f.name, site_id: null, category: null, month: null })) };
        }
        if (gen !== restageGen) return; // a newer file/client pick superseded this one
        const sites = detect.sites || [];
        const multiSite = sites.length > 1;
        stage.innerHTML = '';
        files.forEach((file, i) => {
          const tag = (detect.results && detect.results[i]) || {};
          const row = document.createElement('div');
          row.className = 'bg-neutral-900/40 border border-white/5 rounded-lg p-3 flex flex-wrap items-center gap-2';
          row.innerHTML = `
            <div class="flex-1 min-w-0"><p class="text-xs text-neutral-200 truncate" title="${esc(file.name)}">${esc(file.name)}</p></div>
            ${multiSite ? `<select data-row-site class="px-2 py-1.5 bg-neutral-900/60 border border-white/5 rounded text-xs text-neutral-300">${siteOptions(sites, tag.site_id || null)}</select>` : ''}
            <select data-row-category class="px-2 py-1.5 bg-neutral-900/60 border border-white/5 rounded text-xs text-neutral-300">${catOptions(tag.category || 'general')}</select>
            <input data-row-month type="month" value="${esc(tag.month || monthDefault.value)}" class="px-2 py-1.5 bg-neutral-900/60 border border-white/5 rounded text-xs text-neutral-300" />
            <span data-row-status class="text-[10px] font-mono text-neutral-500 w-16 text-right"></span>
          `;
          stage.appendChild(row);
          staged.push({ file, row });
        });
      }

      fileInput.addEventListener('change', restage);
      clientSel.addEventListener('change', restage);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const clientId = clientSel.value;
        if (!clientId) { (window as any).__toast('Pick a client first.', 'error'); return; }
        if (staged.length === 0) { (window as any).__toast('Pick at least one file.', 'error'); return; }

        const origText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Uploading...';
        progress.classList.remove('hidden');

        let done = 0, failed = 0;
        for (let i = 0; i < staged.length; i++) {
          const { file, row } = staged[i];
          const status = row.querySelector('[data-row-status]')!;
          const siteSel = row.querySelector('[data-row-site]') as HTMLSelectElement | null;
          const catSel = row.querySelector('[data-row-category]') as HTMLSelectElement;
          const monthInp = row.querySelector('[data-row-month]') as HTMLInputElement;
          status.textContent = 'Uploading';
          status.className = 'text-[10px] font-mono text-amber-500/90 w-16 text-right';
          progress.textContent = `Uploading ${i + 1} of ${staged.length}: ${file.name}`;

          const fd = new FormData();
          fd.append('file', file);
          fd.append('client_id', clientId);
          fd.append('month', monthInp.value || monthDefault.value);
          fd.append('category', catSel.value);
          if (siteSel && siteSel.value) fd.append('site_id', siteSel.value);
          try {
            const res = await fetch('/portal/api/files/upload', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken }, body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Upload failed');
            status.textContent = 'Done';
            status.className = 'text-[10px] font-mono text-emerald-400 w-16 text-right';
            done++;
          } catch (err: any) {
            status.textContent = 'Failed';
            status.className = 'text-[10px] font-mono text-red-400 w-16 text-right';
            (row as HTMLElement).title = err?.message || 'Upload failed';
            failed++;
          }
        }

        progress.textContent = `Done. ${done} uploaded${failed ? `, ${failed} failed` : ''}.`;
        (window as any).__toast(`Uploaded ${done} file${done === 1 ? '' : 's'}${failed ? `, ${failed} failed` : ''}.`, failed ? 'error' : 'success');
        btn.textContent = origText;
        btn.disabled = false;
        if (failed === 0) setTimeout(() => location.reload(), 1200);
      });
    }

    // Delete handlers
    document.querySelectorAll('[data-delete-file]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const confirmed = await (window as any).__confirm({
          title: 'Delete file',
          message: 'This file will be permanently deleted. This cannot be undone.',
          confirmLabel: 'Delete',
          danger: true,
        });
        if (!confirmed) return;
        const fileId = (btn as HTMLElement).dataset.deleteFile;
        const res = await fetch('/portal/api/files/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ file_id: fileId }),
        });
        if (res.ok) {
          const row = (btn as HTMLElement).closest('.group');
          if (row) {
            row.style.opacity = '0';
            row.style.transform = 'translateY(-8px)';
            row.style.transition = 'all 0.3s ease';
            setTimeout(() => row.remove(), 300);
          }
        }
      });
    });

    // Send-to-client handlers. Sending is the delivery event: it makes the
    // private file visible on the client's documents hub and notifies +
    // emails them.
    document.querySelectorAll('[data-issue-file]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLButtonElement;
        const fileId = el.dataset.issueFile;
        const name = el.dataset.issueName || 'this file';
        const confirmed = await (window as any).__confirm({
          title: 'Send to client',
          message: `Send "${name}" to the client? They will see it in their documents and get an email.`,
          confirmLabel: 'Send',
        });
        if (!confirmed) return;
        try {
          await (window as any).__withButtonLoading(el, 'Sending...', async () => {
            const res = await fetch('/portal/api/files/issue', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
              body: JSON.stringify({ file_id: fileId }),
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Send failed');
            (window as any).__toast(`Sent "${name}"`, 'success');
            const badge = document.querySelector(`[data-issue-badge="${fileId}"]`);
            if (badge) {
              badge.textContent = 'Sent';
              badge.className = 'px-2 py-0.5 text-[10px] font-mono uppercase rounded bg-emerald-500/10 text-emerald-400';
            }
            el.remove();
          });
        } catch (err: any) {
          (window as any).__toast(err.message || 'Send failed', 'error');
        }
      });
    });
  </script>
</Portal>
