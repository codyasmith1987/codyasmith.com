---
import Portal from '../../../layouts/Portal.astro';
import { getPendingApprovals, getApprovalsByContract } from '../../../lib/invoices';
import { getAllContracts, getContract } from '../../../lib/contracts';
import { getAllClients } from '../../../lib/auth';
export const prerender = false;

const contractId = Astro.url.searchParams.get('contract');
const showAll = Astro.url.searchParams.get('all') === 'true';

let approvals;
if (contractId) {
  approvals = await getApprovalsByContract(contractId);
} else if (showAll) {
  // Show all approvals across contracts — gather from all contracts
  const contracts = await getAllContracts();
  const allApprovals = [];
  for (const c of contracts) {
    const ca = await getApprovalsByContract(c.id);
    allApprovals.push(...ca.map(a => ({ ...a, _contractTitle: c.title })));
  }
  approvals = allApprovals;
} else {
  approvals = await getPendingApprovals();
}

const clients = await getAllClients();
const contracts = await getAllContracts();

const statusColors: Record<string, string> = {
  pending: 'bg-amber-500/10 text-amber-400',
  approved: 'bg-emerald-500/10 text-emerald-400',
  rejected: 'bg-red-500/10 text-red-400',
  revision_requested: 'bg-purple-500/10 text-purple-400',
};
---

<Portal title="Approvals">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Approvals</h1>
    </div>

    <div class="flex items-center gap-3 mb-8">
      <a href="/portal/admin/approvals" class:list={['px-3 py-1.5 rounded-lg text-xs transition-colors', !contractId && !showAll ? 'bg-amber-500/10 text-amber-400' : 'text-neutral-500 hover:text-neutral-300']}>Pending</a>
      <a href="/portal/admin/approvals?all=true" class:list={['px-3 py-1.5 rounded-lg text-xs transition-colors', showAll ? 'bg-amber-500/10 text-amber-400' : 'text-neutral-500 hover:text-neutral-300']}>All</a>
    </div>

    {approvals.length > 0 ? (
      <div class="space-y-3">
        {approvals.map(async (a) => {
          const contract = a._contractTitle ? null : await getContract(a.contract_id);
          const contractTitle = a._contractTitle || contract?.title || '';
          return (
            <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5" data-approval-id={a.id}>
              <div class="flex items-start justify-between">
                <div>
                  <p class="text-sm font-medium text-neutral-200">{a.title}</p>
                  <p class="text-xs text-neutral-600 mt-1">{contractTitle}</p>
                  {a.description && <p class="text-xs text-neutral-500 mt-2">{a.description}</p>}
                  {a.response_note && (
                    <p class="text-xs text-neutral-400 mt-2 border-l-2 border-white/10 pl-3 italic">{a.response_note}</p>
                  )}
                </div>
                <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full shrink-0 ${statusColors[a.status] || ''}`}>{a.status.replace(/_/g, ' ')}</span>
              </div>
              <div class="flex items-center gap-3 mt-3 text-[10px] text-neutral-700">
                <span>Requested: {new Date(a.requested_at).toLocaleDateString()}</span>
                {a.responded_at && <span>Responded: {new Date(a.responded_at).toLocaleDateString()}</span>}
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">{contractId || showAll ? 'No approvals found' : 'No pending approvals'}</p>
        <p class="text-sm text-neutral-500">Create approvals from a contract's detail page.</p>
      </div>
    )}
  </div>
</Portal>
