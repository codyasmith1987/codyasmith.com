# codyasmith.com environment variables.
# Copy to .env (gitignored) and fill in real values before running the app.
# In production, missing CSRF_SECRET or REPORT_SECRET will throw at boot.

# --- Database (Turso / libSQL) -----------------------------------------------
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# --- Signing secrets (NEVER reuse other secrets) -----------------------------
# Generate with: openssl rand -base64 48
CSRF_SECRET=
REPORT_SECRET=

# --- Email (Brevo) -----------------------------------------------------------
BREVO_API_KEY=

# --- Sentiment scanner (Serper search + Gemini analysis) ---------------------
SERPER_API_KEY=
GEMINI_API_KEY=

# --- Object storage (DigitalOcean Spaces, S3-compatible) ---------------------
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_REGION=us-east-1
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
STORAGE_KEY_PREFIX=portal/

# --- Site canonical (used in absolute URLs, sitemap, RSS) --------------------
SITE=https://codyasmith.com
