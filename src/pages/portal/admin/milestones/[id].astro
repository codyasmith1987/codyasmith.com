---
import Portal from '../../../../layouts/Portal.astro';
import { getMilestone, getProject, getContract, getTasksByMilestone } from '../../../../lib/contracts';
export const prerender = false;

const { id } = Astro.params;
const milestone = await getMilestone(id!);
if (!milestone) return Astro.redirect('/portal/admin/contracts');

const project = await getProject(milestone.project_id);
const contract = project ? await getContract(project.contract_id) : null;
const tasks = await getTasksByMilestone(id!);

const statusColors: Record<string, string> = {
  not_started: 'bg-neutral-700/30 text-neutral-400',
  in_progress: 'bg-blue-500/10 text-blue-400',
  completed: 'bg-emerald-500/10 text-emerald-400',
  todo: 'bg-neutral-700/30 text-neutral-400',
  review: 'bg-purple-500/10 text-purple-400',
  done: 'bg-emerald-500/10 text-emerald-400',
  blocked: 'bg-red-500/10 text-red-400',
};

const priorityColors: Record<string, string> = {
  low: 'text-neutral-400',
  normal: 'text-neutral-400',
  high: 'text-amber-600',
  urgent: 'text-red-400',
};
---

<Portal title={milestone.title}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <a href={`/portal/admin/projects/${milestone.project_id}`} class="text-xs text-neutral-400 hover:text-amber-600 transition-colors">&larr; {project?.title || 'Project'}</a>
    </div>

    <div class="flex items-start justify-between mb-8">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-2">Milestone</p>
        <h1 class="font-serif text-3xl text-neutral-100">{milestone.title}</h1>
      </div>
      <div class="flex items-center gap-3">
        <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[milestone.status] || ''}`}>{milestone.status.replace(/_/g, ' ')}</span>
        <button id="delete-ms" class="text-xs text-neutral-400 hover:text-red-400 transition-colors">Delete</button>
      </div>
    </div>

    <!-- Milestone fields -->
    <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Status</label>
          <select id="f-status" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            {['not_started', 'in_progress', 'completed'].map(s => (
              <option value={s} selected={s === milestone.status}>{s.replace(/_/g, ' ')}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Due date</label>
          <input type="date" id="f-due" value={milestone.due_date || ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Client visible</label>
          <select id="f-visible" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            <option value="1" selected={milestone.client_visible === 1}>Yes</option>
            <option value="0" selected={milestone.client_visible === 0}>No</option>
          </select>
        </div>
      </div>
      <div class="mt-5">
        <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Description</label>
        <textarea id="f-desc" rows="2" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">{milestone.description || ''}</textarea>
      </div>
      <div class="mt-5">
        <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Client update text</label>
        <textarea id="f-client-text" rows="2" placeholder="What the client sees about this milestone's progress..." class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">{milestone.client_update_text || ''}</textarea>
      </div>
      <button id="save-ms" class="mt-6 px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300">Save changes</button>
    </div>

    <!-- Tasks -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <p class="text-[10px] font-mono text-neutral-500 tracking-[0.15em] uppercase">Tasks ({tasks.length})</p>
        <button id="show-add-task" class="text-xs text-amber-600 hover:text-amber-600 transition-colors">+ Add task</button>
      </div>

      <form id="add-task-form" class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 mb-4 hidden">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <input type="text" id="at-title" required placeholder="Task title" class="sm:col-span-2 px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
          <select id="at-priority" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            <option value="normal">Normal</option>
            <option value="low">Low</option>
            <option value="high">High</option>
            <option value="urgent">Urgent</option>
          </select>
          <div class="flex gap-3">
            <button type="submit" class="px-5 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Create</button>
            <button type="button" id="cancel-add-task" class="text-sm text-neutral-500 hover:text-neutral-300">Cancel</button>
          </div>
        </div>
      </form>

      {tasks.length > 0 ? (
        <div class="space-y-2">
          {tasks.map(t => (
            <a href={`/portal/admin/tasks/${t.id}`} class="block bg-neutral-900/30 border border-white/5 rounded-xl p-4 hover:border-white/10 transition-all group">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <span class={`text-[10px] font-mono ${priorityColors[t.priority] || ''}`}>{t.priority === 'normal' ? '' : t.priority.toUpperCase()}</span>
                  <p class="text-sm text-neutral-200 group-hover:text-amber-600 transition-colors">{t.title}</p>
                </div>
                <div class="flex items-center gap-3">
                  {t.estimated_hours != null && <span class="text-[10px] text-neutral-500 font-mono">{t.estimated_hours}h est</span>}
                  <span class={`text-[10px] font-mono tracking-wide uppercase px-2 py-0.5 rounded-full ${statusColors[t.status] || ''}`}>{t.status}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-neutral-400 py-4">No tasks yet. Add tasks to track the work inside this milestone.</p>
      )}
    </div>
  </div>

  <script define:vars={{ milestoneId: id, projectId: milestone.project_id }}>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    document.getElementById('save-ms')?.addEventListener('click', async (e) => {
      await window.__withButtonLoading(e.currentTarget, 'Saving...', async () => {
        const res = await fetch(`/portal/api/admin/milestones/${milestoneId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({
            status: document.getElementById('f-status').value,
            due_date: document.getElementById('f-due').value || null,
            client_visible: Number(document.getElementById('f-visible').value),
            description: document.getElementById('f-desc').value.trim() || null,
            client_update_text: document.getElementById('f-client-text').value.trim() || null,
          }),
        });
        if (res.ok) window.__toast({ type: 'success', message: 'Milestone updated' });
        else window.__toast({ type: 'error', message: 'Failed to save' });
      });
    });

    document.getElementById('delete-ms')?.addEventListener('click', async (e) => {
      const confirmed = await window.__confirm({
        title: 'Delete milestone', message: 'This will delete this milestone and all its tasks.',
        confirmLabel: 'Delete', danger: true,
      });
      if (!confirmed) return;
      await window.__withButtonLoading(e.currentTarget, 'Deleting...', async () => {
        const res = await fetch(`/portal/api/admin/milestones/${milestoneId}`, {
          method: 'DELETE', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        });
        if (res.ok) {
          window.__toast({ type: 'success', message: 'Milestone deleted' });
          setTimeout(() => window.location.href = `/portal/admin/projects/${projectId}`, 600);
        } else window.__toast({ type: 'error', message: 'Failed to delete' });
      });
    });

    const taskForm = document.getElementById('add-task-form');
    document.getElementById('show-add-task')?.addEventListener('click', () => taskForm.classList.remove('hidden'));
    document.getElementById('cancel-add-task')?.addEventListener('click', () => taskForm.classList.add('hidden'));

    taskForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = document.getElementById('at-title').value.trim();
      const priority = document.getElementById('at-priority').value;
      if (!title) return;
      const submitBtn = taskForm.querySelector('button[type="submit"]');
      await window.__withButtonLoading(submitBtn, 'Creating...', async () => {
        const res = await fetch('/portal/api/admin/tasks/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ milestone_id: milestoneId, title, priority }),
        });
        if (res.ok) {
          window.__toast({ type: 'success', message: 'Task created' });
          setTimeout(() => location.reload(), 600);
        } else window.__toast({ type: 'error', message: 'Failed to create task' });
      });
    });
  </script>
</Portal>
