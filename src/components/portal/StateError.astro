---
interface Props {
  id?: string;
  detailId?: string;
  retryFn?: string;
}

const { id = 'error-state', detailId = 'error-detail', retryFn = '' } = Astro.props;
---

<div id={id} class="hidden text-center py-24">
  <p class="font-serif text-2xl text-neutral-100 mb-3">Something went wrong</p>
  <p id={detailId} class="text-sm text-neutral-500 mb-8 leading-relaxed"></p>
  {retryFn && (
    <button
      onclick={`${retryFn}()`}
      class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]"
    >
      Retry
    </button>
  )}
</div>
