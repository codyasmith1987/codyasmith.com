---
import Portal from '../../../../layouts/Portal.astro';
import { getInvoice, getInvoiceItems, getPaymentsByInvoice } from '../../../../lib/invoices';
import { getContract } from '../../../../lib/contracts';
import { getAllClients } from '../../../../lib/auth';
export const prerender = false;

const { id } = Astro.params;
const invoice = await getInvoice(id!);
if (!invoice) return Astro.redirect('/portal/admin/invoices');

const contract = await getContract(invoice.contract_id);
const clients = await getAllClients();
const client = clients.find(c => c.id === invoice.client_id);
const items = await getInvoiceItems(id!);
const payments = await getPaymentsByInvoice(id!);

const statusColors: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  sent: 'bg-blue-500/10 text-blue-400',
  paid: 'bg-emerald-500/10 text-emerald-400',
  partial: 'bg-amber-500/10 text-amber-600',
  overdue: 'bg-red-500/10 text-red-400',
  cancelled: 'bg-red-500/10 text-red-400',
};
---

<Portal title={invoice.invoice_number}>
  <div class="max-w-4xl mx-auto">
    <div class="mb-6">
      <a href={`/portal/admin/contracts/${invoice.contract_id}`} class="text-xs text-neutral-400 hover:text-amber-600 transition-colors">&larr; {contract?.title || 'Contract'}</a>
    </div>

    <div class="flex items-start justify-between mb-8">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-2">{client?.name}</p>
        <h1 class="font-serif text-3xl text-neutral-100 font-mono">{invoice.invoice_number}</h1>
      </div>
      <div class="flex items-center gap-3">
        <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[invoice.status] || ''}`}>{invoice.status}</span>
        {invoice.last_reminder_sent && <span class="text-[10px] text-neutral-400">Reminder sent {invoice.last_reminder_sent.split('T')[0]}</span>}
        <button id="duplicate-invoice" class="text-xs text-amber-600 hover:text-amber-600 transition-colors">Duplicate</button>
        <a href={`/portal/api/admin/invoices/${id}/pdf`} class="text-xs text-amber-600 hover:text-amber-600 transition-colors">Download PDF</a>
        <button id="delete-invoice" class="text-xs text-neutral-400 hover:text-red-400 transition-colors">Delete</button>
      </div>
    </div>

    <!-- Invoice fields -->
    <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-8">
      <div class="grid grid-cols-1 sm:grid-cols-4 gap-5">
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2" title="draft: not yet sent | sent: emailed to client, awaiting payment | paid: full balance received | partial: payment received but balance remains | overdue: past due date, not paid | cancelled: voided, no payment expected">Status</label>
          <select id="f-status" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            {['draft', 'sent', 'paid', 'partial', 'overdue', 'cancelled'].map(s => (
              <option value={s} selected={s === invoice.status}>{s}</option>
            ))}
          </select>
          <details class="mt-2 group">
            <summary class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase cursor-pointer hover:text-amber-600 transition-colors select-none">What each status means</summary>
            <div class="mt-2 text-[11px] text-neutral-400 space-y-1">
              <p><strong class="text-neutral-200">draft:</strong> Not yet sent to client.</p>
              <p><strong class="text-neutral-200">sent:</strong> Emailed to client, awaiting payment.</p>
              <p><strong class="text-neutral-200">paid:</strong> Full balance received.</p>
              <p><strong class="text-neutral-200">partial:</strong> Some payment received, balance remains.</p>
              <p><strong class="text-neutral-200">overdue:</strong> Past due date, no payment received.</p>
              <p><strong class="text-neutral-200">cancelled:</strong> Voided. No payment expected.</p>
            </div>
          </details>
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Issued date</label>
          <input type="date" id="f-issued" value={invoice.issued_date || ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Due date</label>
          <input type="date" id="f-due" value={invoice.due_date || ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Client visible</label>
          <select id="f-visible" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            <option value="1" selected={invoice.client_visible === 1}>Yes</option>
            <option value="0" selected={invoice.client_visible === 0}>No</option>
          </select>
        </div>
      </div>
      <div class="mt-5">
        <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Notes</label>
        <textarea id="f-notes" rows="2" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">{invoice.notes || ''}</textarea>
      </div>
      <button id="save-invoice" class="mt-6 px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300">Save changes</button>
    </div>

    <!-- Line items -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <p class="text-[10px] font-mono text-neutral-500 tracking-[0.15em] uppercase">Line items</p>
        <button id="show-add-item" class="text-xs text-amber-600 hover:text-amber-600 transition-colors">+ Add item</button>
      </div>

      <form id="add-item-form" class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 mb-4 hidden">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <input type="text" id="ai-desc" required placeholder="Description" class="sm:col-span-2 px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
          <input type="number" id="ai-qty" value="1" min="1" step="1" placeholder="Qty" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
          <input type="number" id="ai-price" required step="0.01" placeholder="Unit price" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div class="flex gap-3 mt-4">
          <button type="submit" class="px-5 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Add</button>
          <button type="button" id="cancel-add-item" class="text-sm text-neutral-500 hover:text-neutral-300">Cancel</button>
        </div>
      </form>

      {items.length > 0 ? (
        <div class="bg-neutral-900/30 border border-white/5 rounded-xl overflow-hidden">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/5">
                <th class="text-left px-5 py-3 text-[10px] font-mono text-neutral-400 uppercase tracking-wide">Description</th>
                <th class="text-right px-5 py-3 text-[10px] font-mono text-neutral-400 uppercase tracking-wide">Qty</th>
                <th class="text-right px-5 py-3 text-[10px] font-mono text-neutral-400 uppercase tracking-wide">Price</th>
                <th class="text-right px-5 py-3 text-[10px] font-mono text-neutral-400 uppercase tracking-wide">Amount</th>
                <th class="w-10"></th>
              </tr>
            </thead>
            <tbody>
              {items.map(item => (
                <tr class="border-b border-white/5 last:border-0 group">
                  <td class="px-5 py-3 text-neutral-300">{item.description}</td>
                  <td class="px-5 py-3 text-right text-neutral-400 font-mono">{item.quantity}</td>
                  <td class="px-5 py-3 text-right text-neutral-400 font-mono">${item.unit_price.toFixed(2)}</td>
                  <td class="px-5 py-3 text-right text-neutral-200 font-mono">${item.amount.toFixed(2)}</td>
                  <td class="px-3 py-3">
                    <button data-delete-item={item.id} class="text-neutral-500 hover:text-red-400 transition-colors opacity-0 group-hover:opacity-100 text-xs">&times;</button>
                  </td>
                </tr>
              ))}
            </tbody>
            <tfoot>
              <tr class="border-t border-white/10">
                <td colspan="3" class="px-5 py-3 text-right text-[10px] font-mono text-neutral-400 uppercase">Subtotal</td>
                <td class="px-5 py-3 text-right text-neutral-200 font-mono font-medium">${invoice.subtotal.toFixed(2)}</td>
                <td></td>
              </tr>
              {invoice.tax > 0 && (
                <tr>
                  <td colspan="3" class="px-5 py-2 text-right text-[10px] font-mono text-neutral-400 uppercase">Tax</td>
                  <td class="px-5 py-2 text-right text-neutral-400 font-mono">${invoice.tax.toFixed(2)}</td>
                  <td></td>
                </tr>
              )}
              <tr>
                <td colspan="3" class="px-5 py-3 text-right text-[10px] font-mono text-neutral-500 uppercase font-semibold">Total</td>
                <td class="px-5 py-3 text-right text-amber-600 font-mono font-semibold">${invoice.total.toFixed(2)}</td>
                <td></td>
              </tr>
            </tfoot>
          </table>
        </div>
      ) : (
        <p class="text-sm text-neutral-400 py-4">No line items. Add items to calculate the invoice total.</p>
      )}
    </div>

    <!-- Payments -->
    <div class="mb-8">
      <div class="flex items-center justify-between mb-4">
        <p class="text-[10px] font-mono text-neutral-500 tracking-[0.15em] uppercase">Payments (${invoice.amount_paid.toFixed(2)} of ${invoice.total.toFixed(2)})</p>
        <button id="show-add-payment" class="text-xs text-amber-600 hover:text-amber-600 transition-colors">+ Record payment</button>
      </div>

      <form id="add-payment-form" class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 mb-4 hidden">
        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <input type="number" id="ap-amount" required step="0.01" placeholder="Amount" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
          <select id="ap-method" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            <option value="">Payment method...</option>
            <option value="check">Check</option>
            <option value="transfer">Bank transfer</option>
            <option value="card">Credit card</option>
            <option value="cash">Cash</option>
            <option value="other">Other</option>
          </select>
          <input type="date" id="ap-date" required class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
          <input type="text" id="ap-ref" placeholder="Reference #" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div class="flex gap-3 mt-4">
          <button type="submit" class="px-5 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Record</button>
          <button type="button" id="cancel-add-payment" class="text-sm text-neutral-500 hover:text-neutral-300">Cancel</button>
        </div>
      </form>

      {payments.length > 0 ? (
        <div class="space-y-2">
          {payments.map(p => (
            <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-4 flex items-center justify-between">
              <div>
                <p class="text-sm font-mono text-emerald-400">${p.amount.toFixed(2)}</p>
                <p class="text-xs text-neutral-400 mt-0.5">{p.paid_at.split('T')[0]} {p.payment_method ? `via ${p.payment_method}` : ''} {p.reference ? `(${p.reference})` : ''}</p>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-sm text-neutral-400 py-4">No payments recorded.</p>
      )}
    </div>
  </div>

  <script define:vars={{ invoiceId: id, contractId: invoice.contract_id }}>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    // Save invoice
    document.getElementById('save-invoice')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      await window.__withButtonLoading(btn, 'Saving…', async () => {
        const res = await fetch(`/portal/api/admin/invoices/${invoiceId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({
            status: document.getElementById('f-status').value,
            issued_date: document.getElementById('f-issued').value || null,
            due_date: document.getElementById('f-due').value || null,
            client_visible: Number(document.getElementById('f-visible').value),
            notes: document.getElementById('f-notes').value.trim() || null,
          }),
        });
        if (res.ok) window.__toast('Invoice saved.', 'success');
        else window.__toast('Failed to save invoice.', 'error');
      });
    });

    // Delete invoice
    document.getElementById('delete-invoice')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const confirmed = await window.__confirm({
        title: 'Delete invoice', message: 'This will permanently delete this invoice, all line items, and payment records.',
        confirmLabel: 'Delete', danger: true,
      });
      if (!confirmed) return;
      await window.__withButtonLoading(btn, 'Deleting…', async () => {
        const res = await fetch(`/portal/api/admin/invoices/${invoiceId}`, {
          method: 'DELETE', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        });
        if (res.ok) {
          window.__toast('Invoice deleted.', 'success');
          setTimeout(() => window.location.href = `/portal/admin/contracts/${contractId}`, 600);
        } else window.__toast('Failed to delete invoice.', 'error');
      });
    });

    // Duplicate invoice -> new draft, then open it
    document.getElementById('duplicate-invoice')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      await window.__withButtonLoading(btn, 'Duplicating…', async () => {
        const res = await fetch(`/portal/api/admin/invoices/${invoiceId}/duplicate`, {
          method: 'POST', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        });
        if (res.ok) {
          const data = await res.json();
          window.__toast('Invoice duplicated. Opening the new draft.', 'success');
          setTimeout(() => window.location.href = `/portal/admin/invoices/${data.id}`, 600);
        } else window.__toast('Failed to duplicate invoice.', 'error');
      });
    });

    // Add line item
    const itemForm = document.getElementById('add-item-form');
    document.getElementById('show-add-item')?.addEventListener('click', () => itemForm.classList.remove('hidden'));
    document.getElementById('cancel-add-item')?.addEventListener('click', () => itemForm.classList.add('hidden'));

    itemForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = itemForm.querySelector('button[type="submit"]');
      await window.__withButtonLoading(btn, 'Adding…', async () => {
        const res = await fetch(`/portal/api/admin/invoices/${invoiceId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({
            action: 'add_item',
            description: document.getElementById('ai-desc').value.trim(),
            quantity: Number(document.getElementById('ai-qty').value),
            unit_price: Number(document.getElementById('ai-price').value),
          }),
        });
        if (res.ok) {
          window.__toast('Line item added. Totals recalculated.', 'success');
          setTimeout(() => location.reload(), 600);
        } else window.__toast('Failed to add line item.', 'error');
      });
    });

    // Delete line items
    document.querySelectorAll('[data-delete-item]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const itemId = btn.dataset.deleteItem;
        await window.__withButtonLoading(btn, '…', async () => {
          const res = await fetch(`/portal/api/admin/invoices/${invoiceId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ action: 'delete_item', item_id: itemId }),
          });
          if (res.ok) {
            window.__toast('Line item removed. Totals recalculated.', 'success');
            setTimeout(() => location.reload(), 600);
          } else window.__toast('Failed to remove line item.', 'error');
        });
      });
    });

    // Record payment
    const payForm = document.getElementById('add-payment-form');
    document.getElementById('show-add-payment')?.addEventListener('click', () => payForm.classList.remove('hidden'));
    document.getElementById('cancel-add-payment')?.addEventListener('click', () => payForm.classList.add('hidden'));

    payForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = payForm.querySelector('button[type="submit"]');
      await window.__withButtonLoading(btn, 'Recording…', async () => {
        const res = await fetch('/portal/api/admin/payments/record', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({
            invoice_id: invoiceId,
            amount: Number(document.getElementById('ap-amount').value),
            payment_method: document.getElementById('ap-method').value || undefined,
            paid_at: document.getElementById('ap-date').value + 'T12:00:00Z',
            reference: document.getElementById('ap-ref').value.trim() || undefined,
          }),
        });
        if (res.ok) {
          window.__toast('Payment recorded. Invoice totals updated.', 'success');
          setTimeout(() => location.reload(), 600);
        } else window.__toast('Failed to record payment.', 'error');
      });
    });
  </script>
</Portal>
