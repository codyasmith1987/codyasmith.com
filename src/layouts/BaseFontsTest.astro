---
// Diagnostic-only layout. Forked from Base.astro for /font-test-base
// to bisect between (a) Base wrapper code (Tailwind v4, ClientRouter,
// first-paint script, global.css) and (b) homepage page components
// (Quiz overlay, personalization JS) as the cause of the iOS Safari
// grey-blank symptom seen in PR #11 and PR #12.
//
// Differences from Base.astro:
//  - Imports self-hosted fonts.css instead of the Google Fonts <link>.
//  - <Quiz /> component is not rendered.
//  - The bottom <script> block (initPersonalization, initReveals,
//    initThemeSwitcher) is not included.
//
// Everything else (head meta, ClientRouter, first-paint inline script,
// global.css, Nav, Footer) is verbatim from Base.astro.
import '../styles/global.css';
import '../styles/fonts.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description = "Cody Smith: web management, marketing strategy, and consulting for small businesses in Cedar City, Utah and beyond.", ogImage, ogType = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, 'https://codyasmith.com');
const resolvedOgImage = new URL(ogImage ?? '/og-default.png', 'https://codyasmith.com').href;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Cody Smith" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        var root = document.documentElement;
        var t = new URLSearchParams(window.location.search).get('theme');
        if (t) localStorage.setItem('cs-theme', t);
        var saved = localStorage.getItem('cs-theme');
        // Migrate 3-part theme names from before Q4 was added
        if (saved && saved.split('-').length === 3) {
          saved = saved + '-stars';
          localStorage.setItem('cs-theme', saved);
        }
        if (saved) root.setAttribute('data-theme', saved);

        // First paint decision: does the quiz overlay show or not?
        // Runs before <body> renders, so returning visitors never flash the quiz
        // and first-time visitors never flash the raw page before the quiz appears.
        var quizDone = localStorage.getItem('cs-quiz-done');
        if (quizDone || t) {
          root.classList.add('cs-no-quiz');
        } else {
          root.classList.add('quiz-active');
        }
      })();
    </script>
    <style is:inline>
      html.cs-no-quiz #quiz { display: none !important; }
      /* While the quiz is showing, keep page content rendered (the blur needs
         to see it for reactive theming) but block scroll on the body. */
      html.quiz-active, html.quiz-active body { overflow: hidden; }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:px-4 focus:py-2 focus:bg-amber-500 focus:text-neutral-950 focus:text-sm focus:font-semibold focus:rounded-lg">
      Skip to content
    </a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
