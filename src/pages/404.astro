---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | Cody Smith" description="This page doesn't exist. Here's how to get where you're going." noIndex={true} ogImage="/og/404.png" ogImageAlt="404: This page doesn't exist.">
  <section class="pt-40 pb-32 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-amber-400 font-mono text-xs tracking-[0.2em] uppercase mb-8">404</p>
      <h1 class="font-serif text-5xl md:text-7xl text-neutral-100 leading-[1.05] mb-10">
        This page doesn't exist.
      </h1>
      <p class="text-neutral-400 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-14">
        Either something moved, something broke, or you typed something creative into the address bar. No judgment. Here's where you probably meant to go.
      </p>

      <div class="grid sm:grid-cols-2 gap-4 max-w-lg mx-auto">
        <a href="/" class="inline-flex items-center justify-center px-6 py-4 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-colors duration-200">
          Go home
        </a>
        <a href="/services" class="inline-flex items-center justify-center px-6 py-4 border border-white/10 text-neutral-300 font-medium text-sm rounded-lg hover:border-white/25 hover:text-neutral-100 transition-colors duration-200">
          See services
        </a>
        <a href="/contact" class="inline-flex items-center justify-center px-6 py-4 border border-white/10 text-neutral-300 font-medium text-sm rounded-lg hover:border-white/25 hover:text-neutral-100 transition-colors duration-200">
          Get in touch
        </a>
        <a href="/about" class="inline-flex items-center justify-center px-6 py-4 border border-white/10 text-neutral-300 font-medium text-sm rounded-lg hover:border-white/25 hover:text-neutral-100 transition-colors duration-200">
          About me
        </a>
      </div>
    </div>
  </section>
</Base>
