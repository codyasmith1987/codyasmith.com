---
// Server-rendered, never prerendered. Prerendered HTML can be served as
// static files outside the middleware chain in some adapter modes, which
// would let an unauthenticated visitor read the proposal directly. Every
// other /portal/* page in this repo is also prerender=false for the same
// reason — keep the consistency.
export const prerender = false;

import { getClientBySlug } from '../../../lib/auth';

// Access gate. Authenticated portal users in general can hit /portal/*,
// but only the proposal's intended client (Roth Family Companies) and
// the practice owner should see the body of this offer. Anyone else
// gets bounced to their dashboard.
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/portal/login');
}
const rothFamily = await getClientBySlug('raised-bar-group').catch(() => null);
const isAuthorized = user.role === 'admin' || (!!rothFamily && user.client_id === rothFamily.id);
if (!isAuthorized) {
  return Astro.redirect('/portal/dashboard');
}

// CSRF token for the interactive accept form below.
const csrfToken = Astro.locals.csrfToken || '';

// Signer identification. Jason and Kevin sign their own field; admin
// can view but cannot persist or sign. Email match is case-insensitive.
const emailLc = (user.email || '').toLowerCase().trim();
const isAdmin = user.role === 'admin';
const signerRole = isAdmin
  ? 'admin'
  : (emailLc === 'jasonroth1122@gmail.com' ? 'jason'
      : (emailLc === 'kevo.adams@gmail.com' ? 'kevin' : 'other'));
