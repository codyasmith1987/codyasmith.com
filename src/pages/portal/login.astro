---
import '../../styles/global.css';
import '../../styles/portal.css';
export const prerender = false;

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('portal_session')?.value;
if (token) {
  const { validateSession } = await import('../../lib/auth');
  const result = await validateSession(token);
  if (result) return Astro.redirect('/portal/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Log In | Client Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Editorial type stack — match the rest of the site. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="portal-editorial min-h-screen bg-neutral-950 text-neutral-300 font-sans flex items-center justify-center relative overflow-hidden">
    <!-- Ambient glow -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[400px] bg-amber-500/[0.04] rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative w-full max-w-sm mx-auto px-6">
      <!-- Back link -->
      <a href="/" class="inline-flex items-center gap-2 text-xs text-neutral-400 hover:text-amber-600 transition-colors duration-300 mb-12">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        codyasmith.com
      </a>

      <div class="text-center mb-10">
        <h1
          class="text-5xl text-neutral-100 mb-3"
          style="font-family: var(--font-display); font-variation-settings: 'opsz' 96, 'SOFT' 30, 'WONK' 0; letter-spacing: -0.028em; font-weight: 500;"
        >Client Portal</h1>
      </div>

      <div id="login-form-container">
        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="block text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-all duration-300"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label for="password" class="block text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-2">Password</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="w-full px-4 py-3 pr-12 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-all duration-300"
                placeholder="Your password"
              />
              <button type="button" id="toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-neutral-400 transition-colors" aria-label="Show password">
                <svg id="eye-closed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                <svg id="eye-open" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
              </button>
            </div>
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)] disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:shadow-none"
          >
            Log in
          </button>
        </form>
      </div>

      {/* Self-serve recovery. Both actions always render for every visitor and
          show an identical confirmation regardless of account state, so they
          cannot be used to probe who has an account or a password. */}
      <div class="mt-6 flex flex-col items-center gap-2 text-xs">
        <button type="button" id="forgot-btn" class="text-neutral-500 hover:text-amber-600 transition-colors duration-300">Forgot your password?</button>
        <p class="text-neutral-600 text-center leading-relaxed">
          First time here, or your invite link expired?<br />
          <button type="button" id="signin-link-btn" class="text-neutral-500 hover:text-amber-600 transition-colors duration-300 underline-offset-2">Email me a sign-in link</button>
        </p>
      </div>

      <div id="error-message" role="status" aria-live="polite" class="hidden mt-6 p-4 bg-red-500/5 border border-red-500/15 rounded-lg text-sm text-red-400 leading-relaxed"></div>

      <p class="text-center text-xs text-neutral-500 mt-12">
        Don't have access yet? <a href="mailto:cody@codyasmith.com?subject=Portal%20Access%20Request" class="text-neutral-500 hover:text-amber-600 transition-colors duration-300">Request it here</a>
      </p>
    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('error-message')!;
      const emailInput = form.querySelector('#email') as HTMLInputElement;

      // One message slot, reused for errors (red) and confirmations (emerald).
      function showMessage(text: string, kind: 'error' | 'success') {
        errorEl.textContent = text;
        errorEl.classList.remove('hidden');
        if (kind === 'success') {
          errorEl.classList.remove('bg-red-500/5', 'border-red-500/15', 'text-red-400');
          errorEl.classList.add('bg-emerald-500/5', 'border-emerald-500/20', 'text-emerald-400');
        } else {
          errorEl.classList.remove('bg-emerald-500/5', 'border-emerald-500/20', 'text-emerald-400');
          errorEl.classList.add('bg-red-500/5', 'border-red-500/15', 'text-red-400');
        }
      }

      // Show status from a redirect: expired link/session, inactive account,
      // or a just-completed password set / reset.
      const params = new URLSearchParams(window.location.search);
      const urlError = params.get('error');
      if (urlError === 'expired') {
        showMessage('Your link or session has expired. Log in with your password below, or use one of the options under the form to email yourself a fresh link.', 'error');
      } else if (urlError === 'inactive') {
        showMessage('Your account is currently inactive. Contact Cody if you think this is a mistake.', 'error');
      } else if (params.get('passwordSet') === '1') {
        showMessage('Password set. Sign in with your new password.', 'success');
      } else if (params.get('passwordReset') === '1') {
        showMessage('Password reset. Sign in with your new password.', 'success');
      }

      document.getElementById('toggle-pw')!.addEventListener('click', () => {
        const pw = document.getElementById('password') as HTMLInputElement;
        const show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        document.getElementById('eye-closed')!.classList.toggle('hidden', show);
        document.getElementById('eye-open')!.classList.toggle('hidden', !show);
      });

      // Self-serve link requests. Always show the same confirmation regardless
      // of whether an email was actually sent — the endpoints return ok
      // uniformly so neither the response nor the UI leaks who has an account.
      const emailPattern = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
      async function requestLink(endpoint: string, successText: string) {
        const email = emailInput.value.trim();
        if (!emailPattern.test(email)) {
          showMessage('Enter your email in the field above first.', 'error');
          emailInput.focus();
          return;
        }
        try {
          await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
        } catch {
          // Keep the confirmation uniform even on a network hiccup; the user
          // can retry. Never reveal request outcome details.
        }
        showMessage(successText, 'success');
      }

      document.getElementById('forgot-btn')!.addEventListener('click', () =>
        requestLink('/portal/auth/request-reset', 'If your email has portal access, a password reset link is on its way. Check your inbox and spam folder.'));
      document.getElementById('signin-link-btn')!.addEventListener('click', () =>
        requestLink('/portal/auth/send-link', 'If your email has portal access, a sign-in link is on its way. Check your inbox and spam folder.'));

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Logging in...';
        errorEl.classList.add('hidden');

        const email = emailInput.value;
        const password = (form.querySelector('#password') as HTMLInputElement).value;

        try {
          const res = await fetch('/portal/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const data = await res.json();

          if (res.ok) {
            window.location.href = '/portal/dashboard';
          } else {
            showMessage(data.error || 'Login failed', 'error');
            btn.disabled = false;
            btn.textContent = 'Log in';
          }
        } catch (err: any) {
          showMessage('Connection error. Try again.', 'error');
          btn.disabled = false;
          btn.textContent = 'Log in';
        }
      });
    </script>
  </body>
</html>
