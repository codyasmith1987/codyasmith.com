---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Quiz from '../components/Quiz.astro';
import { ClientRouter } from 'astro:transitions';

interface ArticleMeta {
  publishedTime: string;        // ISO 8601
  modifiedTime?: string;        // ISO 8601
  author?: string;
  section?: string;             // e.g. "Articles" or "Case studies"
  tags?: string[];
}

interface Breadcrumb {
  name: string;
  url: string;                  // absolute URL on this site
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  article?: ArticleMeta;
  breadcrumbs?: Breadcrumb[];   // when set, emits BreadcrumbList JSON-LD
  noIndex?: boolean;            // when true, emits robots noindex,nofollow
}

const DEFAULT_DESCRIPTION = "Cody Smith: web management, strategy consulting, implementation, and training for businesses that have outgrown their website.";
const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  article,
  breadcrumbs,
  noIndex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://codyasmith.com');
const resolvedOgImage = new URL(ogImage ?? '/og-default.png', 'https://codyasmith.com').href;
const resolvedOgImageAlt = ogImageAlt
  ?? (ogType === 'article' ? title : 'Cody Smith: web management, strategy consulting, implementation, and training');

const breadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: b.url,
  })),
}) : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={canonicalURL.href} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Cody Smith" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />

    {ogType === 'article' && article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        {article.author && <meta property="article:author" content={article.author} />}
        {article.section && <meta property="article:section" content={article.section} />}
        {article.tags && article.tags.map(tag => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />

    {breadcrumbJsonLd && (
      <script type="application/ld+json" set:html={breadcrumbJsonLd} />
    )}

    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Preload the fonts CSS as a stylesheet, then load it non-render-blocking.
        The print-media trick promotes it to all media once the browser parses it,
        eliminating one critical-path round trip without dropping font-display:swap. */}
    {/* Editorial type stack: Fraunces (display, variable opsz+soft+wonk axes for
        dramatic large sizes and refined body), Newsreader (designed for screen
        reading, has actual stroke contrast), JetBrains Mono (marginalia and code).
        Google Fonts CDN, no self-hosting per prior iOS regression. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    </noscript>
    <ClientRouter />
    <script is:inline>
      (function() {
        var root = document.documentElement;
        var t = new URLSearchParams(window.location.search).get('theme');
        if (t) localStorage.setItem('cs-theme', t);
        var saved = localStorage.getItem('cs-theme');
        // Migrate 3-part theme names from before Q4 was added
        if (saved && saved.split('-').length === 3) {
          saved = saved + '-stars';
          localStorage.setItem('cs-theme', saved);
        }
        if (saved) root.setAttribute('data-theme', saved);

        // First paint decision: does the quiz overlay show or not?
        // Runs before <body> renders, so returning visitors never flash the quiz
        // and first-time visitors never flash the raw page before the quiz appears.
        var quizDone = localStorage.getItem('cs-quiz-done');
        if (quizDone || t) {
          root.classList.add('cs-no-quiz');
        } else {
          root.classList.add('quiz-active');
        }
      })();
    </script>
    <style is:inline>
      html.cs-no-quiz #quiz { display: none !important; }
      /* iOS Safari belt-and-suspenders. After quiz completion or skip,
         the quiz overlay is display:none but the backdrop-filter GPU
         layer can persist and render as grey on iOS. This rule guarantees
         the backdrop-filter is gone whenever the quiz is gone, regardless
         of whether the JS __fieldStop path ran. See memory entry
         project_ios_quiz_grey_screen. */
      html.cs-no-quiz #quiz-backdrop {
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        background: transparent !important;
      }
      /* While the quiz is showing, keep page content rendered (the blur needs
         to see it for reactive theming) but block scroll on the body. */
      html.quiz-active, html.quiz-active body { overflow: hidden; }
    </style>
  </head>
  <body class="site-editorial min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:px-4 focus:py-2 focus:bg-amber-500 focus:text-neutral-950 focus:text-sm focus:font-semibold focus:rounded-lg">
      Skip to content
    </a>
    <Nav />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Quiz />

    <script>
      function initPersonalization() {
        let quizData: Record<string, string> = {};
        try {
          quizData = JSON.parse(localStorage.getItem('cs-quiz-answers') || '{}');
        } catch { /* empty */ }

        const name = quizData.name || '';
        const email = quizData.email || '';
        const firstName = name.split(' ')[0] || '';
        const frame = quizData['1'] || '';   // sun or moon (regulatory focus)
        const place = quizData['2'] || '';   // beach or mountain (Cialdini)
        const season = quizData['3'] || '';  // spring or fall (construal level)
        const processing = quizData['4'] || ''; // stars or clouds (ELM)

        // ---- Name injections ----
        document.querySelectorAll('[data-personalize="name-comma"]').forEach(el => {
          if (firstName) {
            (el as HTMLElement).textContent = `, ${firstName}`;
            (el as HTMLElement).style.display = '';
          } else {
            (el as HTMLElement).style.display = 'none';
          }
        });

        // Hero name: "{Name}, " before the headline
        document.querySelectorAll('[data-personalize="hero-name"]').forEach(el => {
          if (firstName) {
            (el as HTMLElement).textContent = `${firstName}, `;
            (el as HTMLElement).style.display = '';
          }
        });

        // ---- Pre-fill form inputs ----
        const nameInput = document.querySelector('[data-personalize="prefill-name"]') as HTMLInputElement;
        const emailInput = document.querySelector('[data-personalize="prefill-email"]') as HTMLInputElement;
        if (nameInput && name && !nameInput.value) nameInput.value = name;
        if (emailInput && email && !emailInput.value) emailInput.value = email;

        // ---- Personality-aware copy (composable variant system) ----
        // Each axis swaps its own data-attribute independently

        // Variant elements (h1, h2, p) stack server-rendered for SEO weight on
        // segment-targeted copy and for no-JS access. swapAxis reveals the active
        // variant and hides the default; non-active alternates stay hidden via the
        // static inline display:none on their markup.
        // aria-hidden tracks what assistive tech announces: the active variant has
        // it removed, the default gets it set when hidden, alternates carry it from
        // the static markup. This keeps multi-H1/H2 patterns accessible without
        // collapsing variants into a single element (which would lose SEO weight on
        // segment-targeted copy).
        function swapAxis(attr: string, value: string) {
          if (!value) return;
          document.querySelectorAll(`[data-${attr}]`).forEach(el => {
            const v = (el as HTMLElement).dataset[attr];
            if (v === value) {
              (el as HTMLElement).style.removeProperty('display');
              (el as HTMLElement).removeAttribute('aria-hidden');
            } else if (v === 'default') {
              (el as HTMLElement).style.display = 'none';
              (el as HTMLElement).setAttribute('aria-hidden', 'true');
            }
          });
        }

        swapAxis('vibe', place);       // Beach/Mountain (Cialdini)
        swapAxis('frame', frame);      // Sun/Moon (Regulatory Focus)
        swapAxis('phase', season);     // Spring/Fall (Construal Level)
        swapAxis('processing', processing); // Stars/Clouds (ELM)

        // ---- Returning visitor detection ----
        // Count one visit per browser session, not one per page navigation.
        // sessionStorage is per-tab and survives view-transition swaps but
        // resets when the tab closes, which matches "a new visit" intent.
        let visitCount = parseInt(localStorage.getItem('cs-visit-count') || '0', 10);
        if (!sessionStorage.getItem('cs-session-counted')) {
          visitCount += 1;
          localStorage.setItem('cs-visit-count', String(visitCount));
          sessionStorage.setItem('cs-session-counted', '1');
        }
        const isReturning = visitCount > 1;

        if (isReturning && localStorage.getItem('cs-quiz-done')) {
          // Show returning visitor elements, hide first-visit ones
          document.querySelectorAll('[data-personalize="returning"]').forEach(el => {
            (el as HTMLElement).style.display = '';
          });
          document.querySelectorAll('[data-personalize="first-visit"]').forEach(el => {
            (el as HTMLElement).style.display = 'none';
          });
        }
      }

      // Expose for quiz to call after completion
      (window as any).__initPersonalization = initPersonalization;

      function initReveals() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('in-view');
            }
          });
        }, { threshold: 0.1 });
        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      }

      initReveals();
      initPersonalization();
      document.addEventListener('astro:after-swap', () => {
        // Re-apply theme from localStorage after view transition swap
        var saved = localStorage.getItem('cs-theme');
        if (saved) document.documentElement.setAttribute('data-theme', saved);
        initReveals();
        initPersonalization();
      });
    </script>
  </body>
</html>
