---
import Base from '../../layouts/Base.astro';
import { getArticles, getCaseStudies, getAllTags, formatDate, readingTime, tagSlug } from '../../lib/blog';

export const prerender = true;

const [articles, caseStudies, tags] = await Promise.all([
  getArticles(),
  getCaseStudies(),
  getAllTags(),
]);

const latestCase = caseStudies[0];
const recentArticles = articles.slice(0, 5);
const otherCases = caseStudies.slice(1, 4);
const hasAny = articles.length + caseStudies.length > 0;

const breadcrumbs = [
  { name: 'Home', url: 'https://codyasmith.com/' },
  { name: 'Blog', url: 'https://codyasmith.com/blog' },
];

const blogItems = [
  ...recentArticles.map((a, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://codyasmith.com/blog/articles/${a.id}`,
    name: a.data.title,
  })),
  ...caseStudies.slice(0, 4).map((c, i) => ({
    '@type': 'ListItem',
    position: recentArticles.length + i + 1,
    url: `https://codyasmith.com/blog/case-studies/${c.id}`,
    name: c.data.title,
  })),
];
const itemListJsonLd = blogItems.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: blogItems,
}) : null;
---

<Base
  title="Blog | Cody Smith"
  description="Articles and case studies from a working consultancy. Thinking, evidence, and receipts from the projects that shaped how I work."
  breadcrumbs={breadcrumbs}
>
  {itemListJsonLd && (
    <script type="application/ld+json" set:html={itemListJsonLd} />
  )}

  <section class="pt-40 pb-16 px-6">
    <div class="max-w-5xl mx-auto">
      <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400 mb-8">Blog</p>
      <h1 class="font-serif text-5xl md:text-7xl leading-[1.05] text-neutral-100 tracking-tight">
        Fifteen years writing nice things for other people's businesses.<br />
        <span class="font-quote italic">Not here.</span>
      </h1>
      <p class="mt-8 text-lg md:text-xl text-neutral-400 leading-relaxed max-w-3xl">
        Articles on whatever I can't stop thinking about. Case studies on clients my lawyer cleared. LinkedIn voice barred at the door.
      </p>
    </div>
  </section>

  {!hasAny && (
    <section class="px-6 pb-28">
      <div class="max-w-3xl mx-auto p-10 rounded-lg surface-1 border border-white/5 text-center">
        <p class="font-mono text-[10px] tracking-[0.25em] uppercase text-neutral-500 mb-4">Nothing yet</p>
        <p class="font-serif text-2xl text-neutral-200 leading-snug">Either Cody hasn't written anything yet, or he's having another identity crisis. Come back Tuesday (unless it's Tuesday, then just piss off).</p>
      </div>
    </section>
  )}

  {latestCase && (
    <section class="px-6 pb-20">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-baseline justify-between mb-8">
          <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400">Latest receipt</p>
          <a href="/blog/case-studies" class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 hover:text-amber-400 transition-colors">All case studies &rarr;</a>
        </div>
        <a href={`/blog/case-studies/${latestCase.id}`} class="block rounded-xl bg-neutral-900 border border-neutral-800 p-8 md:p-10 group hover:border-amber-500/40 transition-colors duration-200">
          <div class="flex items-center gap-3 mb-4 font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500">
            <span>{latestCase.data.clientAnonymized ? 'Confidential' : latestCase.data.client}</span>
            <span class="text-neutral-700">&middot;</span>
            <span>{latestCase.data.sector}</span>
            <span class="text-neutral-700">&middot;</span>
            <span>{formatDate(latestCase.data.publishDate)}</span>
          </div>
          <h2 class="font-serif text-3xl md:text-4xl text-neutral-100 leading-tight mb-4 group-hover:text-amber-400 transition-colors">
            {latestCase.data.title}
          </h2>
          <p class="text-neutral-400 text-lg leading-relaxed mb-6 max-w-3xl">{latestCase.data.description}</p>
          {latestCase.data.metrics.length > 0 && (
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-6 border-t border-white/5">
              {latestCase.data.metrics.slice(0, 4).map((m) => {
                const arrow = m.direction === 'up' ? '↑' : m.direction === 'down' ? '↓' : '';
                return (
                  <div>
                    <p class="font-mono text-[9px] tracking-[0.2em] uppercase text-neutral-600 mb-1">{m.label}</p>
                    <p class="font-serif text-2xl md:text-3xl text-neutral-100 leading-none">
                      {arrow && <span class="text-amber-400 text-xl mr-1">{arrow}</span>}{m.value}
                    </p>
                  </div>
                );
              })}
            </div>
          )}
        </a>
      </div>
    </section>
  )}

  {recentArticles.length > 0 && (
    <section class="px-6 py-20 surface-1">
      <div class="max-w-5xl mx-auto">
        <div class="flex items-baseline justify-between mb-10">
          <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400">On the desk</p>
          <a href="/blog/articles" class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 hover:text-amber-400 transition-colors">All articles &rarr;</a>
        </div>
        <ul class="divide-y divide-white/5">
          {recentArticles.map((a) => (
            <li>
              <a href={`/blog/articles/${a.id}`} class="group block py-6 md:py-8 md:grid md:grid-cols-[9rem_1fr] md:gap-8">
                <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 mb-2 md:mb-0 md:mt-1 flex md:block items-center gap-3">
                  <time datetime={a.data.publishDate.toISOString()}>{formatDate(a.data.publishDate)}</time>
                  <span class="md:hidden text-neutral-700">&middot;</span>
                  <span class="md:block md:mt-1">{readingTime(a.body)} min</span>
                </div>
                <div>
                  <h3 class="font-serif text-2xl md:text-[1.7rem] text-neutral-100 leading-tight group-hover:text-amber-400 transition-colors">
                    {a.data.title}
                  </h3>
                  <p class="text-neutral-400 mt-2 leading-relaxed">{a.data.description}</p>
                  {a.data.tags.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {a.data.tags.slice(0, 4).map((tag) => (
                        <span class="text-[10px] text-neutral-500 font-mono tracking-wide">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otherCases.length > 0 && (
    <section class="px-6 py-20">
      <div class="max-w-5xl mx-auto">
        <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400 mb-10">Other receipts</p>
        <div class="grid md:grid-cols-3 gap-6">
          {otherCases.map((c) => (
            <a href={`/blog/case-studies/${c.id}`} class="rounded-xl bg-neutral-900 border border-neutral-800 p-6 block group hover:border-amber-500/40 transition-colors duration-200">
              <p class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 mb-3">{c.data.sector}</p>
              <h3 class="font-serif text-xl text-neutral-100 leading-tight mb-3 group-hover:text-amber-400 transition-colors">
                {c.data.title}
              </h3>
              <p class="text-sm text-neutral-400 leading-relaxed">{c.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {tags.length > 0 && (
    <section class="px-6 py-16">
      <div class="max-w-5xl mx-auto">
        <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400 mb-6">Patterns I can't shake</p>
        <div class="flex flex-wrap gap-3">
          {tags.map(({ tag, count }) => (
            <a
              href={`/blog/tags/${tagSlug(tag)}`}
              class="group inline-flex items-baseline gap-2 text-sm text-neutral-300 hover:text-amber-400 border border-white/5 hover:border-amber-500/30 rounded px-3 py-2 transition-colors font-mono tracking-wide"
            >
              <span>{tag}</span>
              <span class="text-[10px] text-neutral-600 group-hover:text-amber-500">{count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}


</Base>
