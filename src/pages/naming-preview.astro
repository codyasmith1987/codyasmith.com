---
import Base from '../layouts/Base.astro';
export const prerender = false;
---

<Base title="Naming preview | Cody Smith" description="100 domain names. Real availability. Ranked. Free preview." noIndex={true}>
  <!-- Hero -->
  <section class="relative pt-40 pb-16 px-6 overflow-hidden">
    <div class="absolute top-0 left-1/3 w-[400px] h-[400px] bg-amber-500/5 rounded-full blur-3xl pointer-events-none"></div>
    <div class="relative max-w-4xl mx-auto">
      <p class="reveal text-amber-400 font-mono text-xs tracking-[0.2em] uppercase mb-8">Naming preview</p>
      <h1 class="reveal font-serif text-5xl md:text-7xl text-neutral-100 leading-[1.05] mb-10">
        100 domain names.<br />Real availability.<br />Ranked.
      </h1>
      <p class="reveal text-neutral-400 text-lg md:text-xl leading-relaxed max-w-2xl">
        Free preview.
      </p>
    </div>
  </section>

  <!-- Form -->
  <section class="pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <form id="naming-form" class="reveal flex gap-3">
        <!-- Honeypot field for bots -->
        <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="flex-1">
          <label for="seed-input" class="sr-only">Seed term</label>
          <input
            type="text"
            id="seed-input"
            name="seed"
            required
            aria-required="true"
            placeholder="marketing strategy"
            maxlength="200"
            class="w-full bg-transparent border-b border-white/10 pb-3 text-neutral-100 text-lg focus:border-amber-400 focus:outline-none transition-colors duration-300 placeholder:text-neutral-700"
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex items-center justify-center px-8 py-4 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.25)] disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
        >
          Generate
        </button>
      </form>

      <!-- Advanced toggle (hides creativity slider) -->
      <button id="advanced-toggle" type="button" class="mt-4 text-neutral-500 text-xs hover:text-neutral-400 transition-colors flex items-center gap-1">
        <span id="advanced-arrow" class="transition-transform duration-200">&#9654;</span> Advanced <span class="text-neutral-500">(optional)</span>
      </button>
      <div id="advanced-fields" class="hidden mt-4">
        <label for="creativity-slider" class="block text-neutral-500 text-xs tracking-[0.1em] uppercase mb-2">
          Creativity: <span id="creativity-value" class="text-neutral-300 font-mono">5</span>
        </label>
        <input
          type="range"
          id="creativity-slider"
          min="1"
          max="10"
          value="5"
          step="1"
          class="w-full max-w-md accent-amber-500"
        />
        <p class="text-neutral-600 text-xs mt-2">1 stays grounded and literal. 10 drifts toward inventive and abstract.</p>
      </div>

      <p id="form-error" class="hidden text-red-400 text-sm mt-4"></p>
    </div>
  </section>

  <!-- Loading -->
  <section id="loading" class="hidden pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="glow-card p-8">
        <div class="flex items-center gap-3">
          <div class="w-5 h-5 border-2 border-amber-400 border-t-transparent rounded-full animate-spin"></div>
          <p id="loading-text" class="text-neutral-300 text-sm font-medium">Forging names...</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Results -->
  <section id="results" class="hidden pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="text-neutral-500 text-xs tracking-[0.15em] uppercase mb-4">Top 5 .com candidates</p>
      <div id="results-list" class="space-y-3"></div>
      <button id="reset-btn" type="button" class="mt-8 text-neutral-500 text-xs hover:text-amber-400 transition-colors">
        Run another &#8594;
      </button>
    </div>
  </section>

  <!-- Error state -->
  <section id="error-state" class="hidden pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <div class="bg-neutral-900/50 border border-red-500/20 rounded-xl p-6 text-center">
        <p class="text-neutral-300 text-sm mb-4">Something went wrong. Try again in a minute.</p>
        <button id="try-again-btn" type="button" class="inline-flex items-center justify-center px-5 py-2 border border-white/10 text-neutral-300 font-medium text-xs rounded-lg hover:border-amber-500/40 hover:text-amber-400 transition-all duration-300">
          Try Again
        </button>
      </div>
    </div>
  </section>

  <!-- Bottom spacer -->
  <div class="pb-20"></div>

  <script>
    function initNamingPreview() {
      const pageLoadTime = Date.now();

      const form = document.getElementById('naming-form') as HTMLFormElement;
      const seedInput = document.getElementById('seed-input') as HTMLInputElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('form-error')!;
      const loading = document.getElementById('loading')!;
      const loadingText = document.getElementById('loading-text')!;
      const results = document.getElementById('results')!;
      const resultsList = document.getElementById('results-list')!;
      const errorState = document.getElementById('error-state')!;
      const resetBtn = document.getElementById('reset-btn')!;
      const tryAgainBtn = document.getElementById('try-again-btn')!;

      if (!form || !submitBtn) return;

      // Advanced toggle (creativity slider)
      const advancedToggle = document.getElementById('advanced-toggle');
      const advancedFields = document.getElementById('advanced-fields');
      const advancedArrow = document.getElementById('advanced-arrow');
      if (advancedToggle && advancedFields) {
        advancedToggle.addEventListener('click', () => {
          const open = !advancedFields.classList.contains('hidden');
          advancedFields.classList.toggle('hidden');
          if (advancedArrow) advancedArrow.style.transform = open ? '' : 'rotate(90deg)';
        });
      }

      const creativitySlider = document.getElementById('creativity-slider') as HTMLInputElement | null;
      const creativityValue = document.getElementById('creativity-value');
      if (creativitySlider && creativityValue) {
        creativitySlider.addEventListener('input', () => {
          creativityValue.textContent = creativitySlider.value;
        });
      }

      const LOADING_MESSAGES = ['Forging names...', 'Checking availability...', 'Filtering the obvious...'];
      let loadingIntervalId: number | null = null;
      function startLoadingMessages() {
        let i = 0;
        loadingText.textContent = LOADING_MESSAGES[0];
        loadingIntervalId = window.setInterval(() => {
          i = (i + 1) % LOADING_MESSAGES.length;
          loadingText.textContent = LOADING_MESSAGES[i];
        }, 1500);
      }
      function stopLoadingMessages() {
        if (loadingIntervalId !== null) {
          window.clearInterval(loadingIntervalId);
          loadingIntervalId = null;
        }
      }

      function availabilityBadge(available: boolean | null): string {
        if (available === true) {
          return '<span class="px-2 py-0.5 rounded-full text-xs font-medium border bg-emerald-500/10 text-emerald-400 border-emerald-500/20">available</span>';
        }
        if (available === false) {
          return '<span class="px-2 py-0.5 rounded-full text-xs font-medium border bg-red-500/10 text-red-400 border-red-500/20">taken</span>';
        }
        return '<span class="px-2 py-0.5 rounded-full text-xs font-medium border bg-neutral-500/10 text-neutral-400 border-neutral-500/20">couldn\'t check</span>';
      }

      function renderResults(names: Array<{ name: string; available: boolean | null; rationale: string }>) {
        resultsList.innerHTML = names.map((n) => `
          <div class="bg-neutral-900/30 border border-white/5 rounded-lg p-5 hover:border-white/10 transition-all duration-300">
            <div class="flex items-start justify-between gap-4 mb-2">
              <p class="text-neutral-100 text-lg font-semibold font-serif">${n.name}.com</p>
              ${availabilityBadge(n.available)}
            </div>
            <p class="text-neutral-400 text-sm leading-relaxed">${n.rationale}</p>
          </div>
        `).join('');
      }

      function showError() {
        loading.classList.add('hidden');
        results.classList.add('hidden');
        errorState.classList.remove('hidden');
      }

      function resetToIdle() {
        errorState.classList.add('hidden');
        results.classList.add('hidden');
        loading.classList.add('hidden');
        errorEl.classList.add('hidden');
        seedInput.focus();
      }

      resetBtn.addEventListener('click', resetToIdle);
      tryAgainBtn.addEventListener('click', resetToIdle);

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Honeypot
        const honeypot = (form.querySelector('input[name="website"]') as HTMLInputElement)?.value;
        if (honeypot) return;

        // Bot guard: require at least 2 seconds between page load and submission
        if (Date.now() - pageLoadTime < 2000) {
          errorEl.textContent = 'Please wait a moment before submitting.';
          errorEl.classList.remove('hidden');
          return;
        }

        const seed = seedInput.value.trim();
        if (!seed) {
          errorEl.textContent = 'Enter a seed term.';
          errorEl.classList.remove('hidden');
          return;
        }

        const creativity = creativitySlider ? parseInt(creativitySlider.value, 10) || 5 : 5;

        errorEl.classList.add('hidden');
        results.classList.add('hidden');
        errorState.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Generating...';

        loading.classList.remove('hidden');
        startLoadingMessages();

        try {
          const res = await fetch('/api/naming/preview', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ seed, creativity }),
          });

          stopLoadingMessages();
          loading.classList.add('hidden');

          if (!res.ok) {
            // Read but do not surface backend error verbatim
            try { await res.json(); } catch { /* ignore parse errors */ }
            showError();
            return;
          }

          const data = await res.json();
          if (!data || !Array.isArray(data.names)) {
            showError();
            return;
          }

          renderResults(data.names);
          results.classList.remove('hidden');
        } catch {
          stopLoadingMessages();
          showError();
        }

        submitBtn.disabled = false;
        submitBtn.textContent = 'Generate';
      });
    }

    initNamingPreview();
    document.addEventListener('astro:after-swap', () => { initNamingPreview(); });
  </script>
</Base>
