---
import Portal from '../../layouts/Portal.astro';
import ClientSelector from '../../components/portal/ClientSelector.astro';
import PreviewBanner from '../../components/portal/PreviewBanner.astro';
import StateLoading from '../../components/portal/StateLoading.astro';
import StateError from '../../components/portal/StateError.astro';
import StateEmpty from '../../components/portal/StateEmpty.astro';
import { getAllClients } from '../../lib/auth';
import {
  generateOverviewVerdict,
  generateSlowdownVerdict,
  generateNowVerdict,
  generateNeedToKnowVerdict,
  type VerdictResult,
  type SlowdownResult,
  type NowResult,
  type NeedToKnowResult,
  type FactKind,
} from '../../lib/client-narrator';
import {
  getLatestTrafficPeriodId,
  getTrafficMetricsForPeriod,
  type TrafficMetrics,
} from '../../lib/traffic-metrics';
import { buildTrafficSummary, type ClientSummary } from '../../lib/client-page-summary';
import ClientSummaryBlock from '../../components/portal/ClientSummary.astro';
export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';
const isPreview = isAdmin && Astro.url.searchParams.get('as_client') === '1';

// Admins land on their action queue, not the client-facing story page.
// The only exception is explicit preview mode (?as_client=1), which
// drops the admin into the real client-facing page with a clearly
// marked preview banner.
if (isAdmin && !isPreview) {
  return Astro.redirect('/portal/admin/');
}

const clients = isAdmin ? await getAllClients() : [];

// Resolve which client to generate the verdict for.
//   - client users: their own client_id, always. Forged ?client_id= is
//     ignored — non-admins cannot read another client's dashboard.
//   - admin in preview mode: ?client_id=X or fallback to first client.
const selectedClientId = isAdmin
  ? (Astro.url.searchParams.get('client_id') || clients[0]?.id || null)
  : (user.client_id ?? null);

let verdict: VerdictResult | null = null;
let slowdown: SlowdownResult | null = null;
let now: NowResult | null = null;
let needToKnow: NeedToKnowResult | null = null;
let previewClientName: string | null = null;
if (selectedClientId) {
  verdict = await generateOverviewVerdict(selectedClientId);
  // Slice 3: second sentence directly below the verdict. Pass slice 1's
  // winning fact kind so slice 3 never re-renders the same signal — if
  // slice 1 already rendered a negative delta as its best-available
  // truth, slice 3 falls through to the current-period issue rank.
  const excludeFactKind =
    verdict.confidence === 'comparative'
      ? (verdict.basis.winning_fact as FactKind | undefined)
      : undefined;
  slowdown = await generateSlowdownVerdict(selectedClientId, { excludeFactKind });
  // Slice 4: third sentence — "what is happening now?". Present-tense
  // truth about active delivery work, or when none exists, the honest
  // current refresh / tracking state. Project shells do not qualify.
  now = await generateNowVerdict(selectedClientId);
  // Slice 5: fourth sentence — "what do I need to know?". Single most
  // time-sensitive client-facing fact. Draft invoices are never
  // surfaced. Notifications are filtered via entity join so test
  // pollution and deleted rows cannot produce client-facing lies.
  // Slice 12b: pass the viewer's email so the approval branch can
  // decide whether to say "your" (viewer is the approval contact) or
  // name the approver ("Kelsey's"). Admins in preview mode have no
  // natural "viewer as approver" semantics, so passing their email
  // is fine — it won't match a client contact in practice.
  needToKnow = await generateNeedToKnowVerdict(
    selectedClientId,
    Astro.locals.user?.email ?? undefined
  );
  if (isPreview) {
    // Admin already has getAllClients() loaded above. Look the name up
    // locally instead of issuing another query.
    previewClientName = clients.find((c) => c.id === selectedClientId)?.name ?? 'unknown client';
  }
}

// Slice 18b — minimal traffic card. Renders only when GA4 is
// actually connected and synced for this client. If no data:
// no card. Zero decorative placeholders.
let traffic: TrafficMetrics | null = null;
let trafficPeriodId: string | null = null;
if (selectedClientId) {
  trafficPeriodId = await getLatestTrafficPeriodId(selectedClientId);
  if (trafficPeriodId) {
    traffic = await getTrafficMetricsForPeriod(selectedClientId, trafficPeriodId);
  }
}

// Slice 18c — plain-language traffic summary above the tile card.
// Builder always returns a populated ClientSummary (no-data,
// first-month, or compare). We only render when traffic data
// exists — the no-data case is technically available but suppressing
// it here keeps the dashboard quiet for clients without GA4.
let trafficSummary: ClientSummary | null = null;
if (selectedClientId && trafficPeriodId) {
  trafficSummary = await buildTrafficSummary(selectedClientId);
}
---

<Portal title="Dashboard">

  {isPreview && previewClientName && (
    <PreviewBanner clientName={previewClientName} />
  )}

  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-10">
      <p id="data-date" class="text-[10px] font-mono text-neutral-700 tracking-[0.15em] uppercase"></p>
      {isAdmin && <ClientSelector clients={clients} />}
    </div>

    {/* ═══════ SLICES 1 + 3: OVERVIEW VERDICT + SLOWDOWN (server-rendered) ═══════ */}
    {verdict && (
      <section class="mb-20">
        <p class="text-[11px] uppercase tracking-widest text-neutral-600 mb-5">Where you stand right now</p>
        <h1
          id="overview-verdict"
          class="text-[28px] md:text-4xl font-serif text-neutral-100 leading-tight max-w-[640px]"
          data-confidence={verdict.confidence}
        >
          {verdict.headline}
        </h1>
        {slowdown && (
          <p
            id="overview-slowdown"
            class="text-lg md:text-xl font-serif text-neutral-400 leading-snug mt-4 max-w-[640px]"
            data-source={slowdown.source}
          >
            {slowdown.headline}
          </p>
        )}
        {now && (
          <p
            id="overview-now"
            class="text-lg md:text-xl font-serif text-neutral-400 leading-snug mt-4 max-w-[640px]"
            data-source={now.source}
          >
            {now.headline}
          </p>
        )}
        {needToKnow && (
          <p
            id="overview-need-to-know"
            class="text-lg md:text-xl font-serif text-neutral-400 leading-snug mt-4 max-w-[640px]"
            data-source={needToKnow.source}
          >
            {needToKnow.headline}
          </p>
        )}
        {verdict.confidence === 'first_month' && (
          <p class="text-[11px] font-mono text-neutral-600 mt-5 tracking-wide">one month of data so far</p>
        )}
        {verdict.confidence === 'no_data' && (
          <p class="text-[11px] font-mono text-neutral-600 mt-5 tracking-wide">waiting on first import</p>
        )}
      </section>
    )}

    {/* ═══════ SLICE 18c: PLAIN-LANGUAGE TRAFFIC SUMMARY ═══════ */}
    {trafficSummary && <ClientSummaryBlock summary={trafficSummary} />}

    {/* ═══════ SLICE 18b: TRAFFIC CARD ═══════ */}
    {/* Renders only when GA4 is actually connected AND has real data
        for the latest available period. No data = no card. No
        decorative "waiting on Google" placeholder. */}
    {traffic && (
      <section class="mb-16">
        <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-3">Traffic this month</p>
        <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-6 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-[640px]">
          <div>
            <p class="text-2xl font-semibold text-neutral-100 tabular-nums">{traffic.sessions.toLocaleString()}</p>
            <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-wide mt-1">Visits</p>
          </div>
          <div>
            <p class="text-2xl font-semibold text-neutral-100 tabular-nums">{traffic.users.toLocaleString()}</p>
            <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-wide mt-1">People</p>
          </div>
          <div>
            <p class="text-2xl font-semibold text-neutral-100 tabular-nums">{traffic.page_views.toLocaleString()}</p>
            <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-wide mt-1">Page views</p>
          </div>
          <div>
            <p class="text-2xl font-semibold text-neutral-100 tabular-nums">{Math.round(traffic.engagement_rate * 100)}%</p>
            <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-wide mt-1">Engaged</p>
          </div>
        </div>
      </section>
    )}

    {/* Divider marking everything below as secondary context — the verdict
        above is the primary truth. Chapters 1–3 below are pre-slice
        leftovers kept for now; they will be replaced in later slices. */}
    <div class="border-t border-white/5 pt-6 mb-10">
      <p class="text-[10px] font-mono text-neutral-700 tracking-[0.15em] uppercase">More detail</p>
    </div>

    <div id="story" class="hidden opacity-90">

      <!-- ═══════ CHAPTER 1: SCORE (demoted from primary verdict) ═══════ -->
      <section class="story-section mb-16">
        <div class="flex flex-col items-center text-center">
          <div id="score-wrap" class="relative w-28 h-28 mb-5 score-glow rounded-full" style="--glow-color: rgba(38,38,38,0.05);">
            <canvas id="score-ring" role="img" aria-label="Website health score"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="score-number" class="text-3xl font-bold tracking-tight text-neutral-300" style="animation: countUp 0.8s ease-out 0.6s both;"></span>
            </div>
          </div>
          <p id="score-explain" class="text-[10px] text-neutral-700 max-w-sm"></p>
        </div>
      </section>

      <!-- ═══════ CHAPTER 2: GOOGLE ═══════ -->
      <section class="story-section mb-20">
        <p class="text-[11px] text-neutral-600 tracking-widest uppercase mb-8 text-center">How people find you on Google</p>

        <!-- Simulated search -->
        <div id="search-sim" class="rounded-2xl overflow-hidden mb-8 border border-white/[0.04]">
          <!-- Search bar -->
          <div class="bg-neutral-900/80 px-5 py-4 flex items-center gap-3">
            <svg class="w-4 h-4 text-neutral-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <span id="sim-query" class="text-sm text-neutral-300"></span>
          </div>
          <!-- Results -->
          <div id="sim-results" class="bg-neutral-950/60 px-5 py-4 space-y-3"></div>
        </div>

        <!-- Wins — horizontal stat bar -->
        <div class="grid grid-cols-3 gap-2 mb-8">
          <div class="relative overflow-hidden bg-gradient-to-b from-emerald-500/[0.07] to-transparent border border-emerald-500/10 rounded-xl p-5 text-center">
            <p id="win-top3" class="text-3xl font-bold text-emerald-400 mb-1">0</p>
            <p class="text-[10px] text-emerald-400/50 leading-tight">searches where<br/>you're #1, #2, or #3</p>
          </div>
          <div class="relative overflow-hidden portal-accent-bg-soft portal-accent-border border rounded-xl p-5 text-center">
            <p id="win-page1" class="text-3xl font-bold portal-accent-text mb-1">0</p>
            <p class="text-[10px] portal-accent-text leading-tight opacity-60">searches where you<br/>show up on page 1</p>
          </div>
          <div class="relative overflow-hidden bg-gradient-to-b from-neutral-400/[0.04] to-transparent border border-white/5 rounded-xl p-5 text-center">
            <p id="win-reach" class="text-3xl font-bold text-neutral-200 mb-1">0</p>
            <p class="text-[10px] text-neutral-500 leading-tight">people searching<br/>for these each month</p>
          </div>
        </div>

        <!-- Best keywords -->
        <div class="space-y-1" id="trophies"></div>

        <div class="text-center mt-5">
          <a href="/portal/keywords" class="text-[11px] text-neutral-600 portal-hover-accent transition-colors tracking-wide">ALL KEYWORDS →</a>
        </div>
      </section>

      <!-- ═══════ CHAPTER 3: CHECKUP ═══════ -->
      <section class="story-section mb-16">
        <p class="text-[11px] text-neutral-600 tracking-widest uppercase mb-8 text-center">Your website checkup</p>

        <div id="checkup" class="grid grid-cols-2 gap-3"></div>

        <div class="text-center mt-5">
          <a href="/portal/health" class="text-[11px] text-neutral-600 portal-hover-accent transition-colors tracking-wide">FULL REPORT →</a>
        </div>
      </section>

    </div>

    <StateLoading id="loading-state" message="Loading your dashboard..." />
    <StateError id="error-state" detailId="error-detail" retryFn="loadDashboard" />
    <StateEmpty
      id="empty-state"
      message="Once we upload your first round of data, this is where your full report lives."
      actionHref={isAdmin ? '/portal/admin/csv' : undefined}
      actionLabel={isAdmin ? 'Upload CSVs' : undefined}
    />
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" crossorigin="anonymous"></script>
  <script define:vars={{ clientId: user.client_id, isAdmin, firstClientId: clients[0]?.id || '' }}>
    let activeClientId = isAdmin ? firstClientId : clientId;
    let scoreChart = null;

    const selector = document.getElementById('client-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        // Full page reload on client switch so the server-rendered
        // verdict at the top re-generates for the new client. Without
        // this, the verdict would stay pinned to the initial client
        // while the lower chapters re-fetched their own data — a
        // split-brain view.
        const cid = encodeURIComponent(e.target.value);
        window.location.href = `/portal/dashboard?as_client=1&client_id=${cid}`;
      });
    }

    const CATS = [
      { key: 'images', label: 'Images', icon: '📸', ok: 'All images are optimized and accessible.', match: n => /^image/i.test(n) },
      { key: 'content', label: 'Content', icon: '📝', ok: 'Titles, headings, and descriptions are solid.', match: n => /^(h1|h2|content|meta|page title)/i.test(n) },
      { key: 'links', label: 'Links', icon: '🔗', ok: 'All links are working and well-structured.', match: n => /^(link|response)/i.test(n) },
      { key: 'security', label: 'Security', icon: '🔒', ok: 'Security headers are properly configured.', match: n => /^security/i.test(n) },
    ];

    // Friendly issue summaries
    const FRIENDLY = {
      'images': {
        high: 'Some images are causing real problems — broken, way too large, or completely inaccessible.',
        med: 'A number of images could be better — smaller files, better descriptions.',
        low: 'Small image tweaks. Nothing urgent.',
      },
      'content': {
        high: 'Page titles or headings have structural issues that confuse Google.',
        med: 'Some pages need better titles or descriptions to rank well.',
        low: 'Minor heading and content cleanups.',
      },
      'links': {
        high: 'Broken links on your site — visitors and Google are hitting dead ends.',
        med: 'Some links need cleanup or better anchor text.',
        low: 'Minor link housekeeping.',
      },
      'security': {
        high: 'Missing security settings that protect your visitors.',
        med: 'Some browser security headers should be added.',
        low: 'Optional security enhancements.',
      },
    };

    function computeScore(kws, issues) {
      let s = 50;
      if (kws.length > 0) {
        s += Math.round((kws.filter(k => k.position <= 10).length / kws.length) * 30);
        s += Math.round((kws.filter(k => k.position <= 3).length / kws.length) * 20);
      }
      const h = issues.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;
      const m = issues.filter(i => (i.priority||'').toLowerCase() === 'medium').length;
      s -= Math.min(30, h * 10 + m * 3);
      return Math.max(0, Math.min(100, s));
    }

    function scoreColor(s) {
      if (s >= 75) return '#10b981';
      if (s >= 50) return '#fbbf24';
      return '#ef4444';
    }

    async function loadDashboard() {
      const loadingEl = document.getElementById('loading-state');
      const errorEl = document.getElementById('error-state');
      const errorDetail = document.getElementById('error-detail');

      loadingEl.classList.remove('hidden');
      errorEl.classList.add('hidden');
      document.getElementById('empty-state').classList.add('hidden');
      document.getElementById('story').classList.add('hidden');

      if (!activeClientId) {
        loadingEl.classList.add('hidden');
        document.getElementById('empty-state').classList.remove('hidden');
        return;
      }

      try {
        const qs = `?client_id=${activeClientId}`;
        const [sumR, kwR, isR] = await Promise.all([
          fetch('/portal/api/dashboard/summary' + qs),
          fetch('/portal/api/dashboard/keywords' + qs + '&limit=200'),
          fetch('/portal/api/dashboard/issues' + qs),
        ]);

        if (!sumR.ok || !kwR.ok || !isR.ok) throw new Error('Failed to load dashboard data');

        const summary = await sumR.json();
        const kwData = await kwR.json();
        const isData = await isR.json();

        const kws = (kwData.keywords || []).filter(k => k.position);
        const issues = isData.issues || [];

        loadingEl.classList.add('hidden');

        if (!kws.length && !issues.length) {
          document.getElementById('empty-state').classList.remove('hidden');
          document.getElementById('story').classList.add('hidden');
          return;
        }
        document.getElementById('empty-state').classList.add('hidden');
        document.getElementById('story').classList.remove('hidden');

      const month = summary.current_month || kwData.month;
      const dateEl = document.getElementById('data-date');
      if (month) {
        dateEl.textContent = new Date(month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
      } else {
        dateEl.textContent = 'Date unavailable';
      }

      const score = computeScore(kws, issues);
      const color = scoreColor(score);
      const page1 = kws.filter(k => k.position <= 10).length;
      const top3 = kws.filter(k => k.position <= 3).length;
      const highIss = issues.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;

      // ── CHAPTER 1 ──
      const sn = document.getElementById('score-number');
      sn.textContent = score;
      sn.style.color = color;
      document.getElementById('score-ring').setAttribute('aria-label', `Website health score: ${score} out of 100`);

      // Glow color
      const wrap = document.getElementById('score-wrap');
      const glowAlpha = score >= 75 ? '0.12' : score >= 50 ? '0.08' : '0.08';
      const glowRgb = score >= 75 ? '16,185,129' : score >= 50 ? '251,191,36' : '239,68,68';
      wrap.style.setProperty('--glow-color', `rgba(${glowRgb},${glowAlpha})`);

      // Primary verdict is now server-rendered above from real snapshot
      // data (see src/lib/client-narrator.ts). The old client-side
      // score→sentence mapping used to live here — it wrote canned text
      // based on an integer score with no month-over-month awareness.
      // Removed as part of slice 1 of the client translation layer.
      document.getElementById('score-explain').textContent = `Score based on: ${page1} of ${kws.length} keywords on page 1, ${top3} in top 3, ${highIss} high-priority site issues.`;

      const ctx = document.getElementById('score-ring');
      try { if (scoreChart) scoreChart.destroy(); } catch {}
      scoreChart = null;
      scoreChart = new Chart(ctx, {
        type: 'doughnut',
        data: { datasets: [{ data: [score, 100 - score], backgroundColor: [color, 'rgba(38,38,38,0.3)'], borderWidth: 0 }] },
        options: {
          cutout: '78%', responsive: true, maintainAspectRatio: true,
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          animation: { animateRotate: true, duration: 1500, easing: 'easeOutQuart' },
        },
      });

      // ── CHAPTER 2 ──
      if (kws.length > 0) {
        const best = kws[0];
        document.getElementById('sim-query').textContent = best.keyword;

        // Build search simulation
        const sim = document.getElementById('sim-results');
        const pos = best.position;
        let html = '';
        const showPositions = [];
        for (let i = 1; i <= Math.min(Math.max(pos + 1, 4), 8); i++) {
          if (i > 3 && i < pos - 1 && pos > 5) {
            if (!showPositions.includes('dots')) showPositions.push('dots');
          } else {
            showPositions.push(i);
          }
        }

        showPositions.forEach((p, idx) => {
          const delay = 0.8 + idx * 0.12;
          if (p === 'dots') {
            html += `<div class="sim-result text-center py-1" style="animation-delay:${delay}s"><span class="text-neutral-800">⋯</span></div>`;
            return;
          }
          const isYou = p === pos;
          if (isYou) {
            html += `
              <div class="sim-result rounded-lg border border-emerald-500/20 bg-emerald-500/[0.06] px-4 py-3" style="animation-delay:${delay}s">
                <p class="text-xs text-emerald-400/70 mb-0.5">${best.url ? best.url.replace('https://', '').replace(/\/$/, '') : 'yoursite.com'}</p>
                <p class="text-sm text-emerald-300 font-medium">${best.keyword.charAt(0).toUpperCase() + best.keyword.slice(1)} — Your Site</p>
                <p class="text-xs text-emerald-500/40 mt-0.5">This is you, position #${pos}</p>
              </div>`;
          } else {
            html += `
              <div class="sim-result px-4 py-2.5 opacity-25" style="animation-delay:${delay}s">
                <div class="h-2 bg-neutral-800 rounded w-32 mb-1.5"></div>
                <div class="h-2.5 bg-neutral-800/70 rounded w-52"></div>
              </div>`;
          }
        });
        sim.innerHTML = html;

        // Wins
        const totalVol = kws.filter(k => k.position <= 10).reduce((s, k) => s + (k.search_volume || 0), 0);
        document.getElementById('win-top3').textContent = top3;
        document.getElementById('win-page1').textContent = page1;
        document.getElementById('win-reach').textContent = totalVol > 1000 ? Math.round(totalVol / 1000) + 'k+' : totalVol.toLocaleString();

        // Trophies
        const medals = ['🥇','🥈','🥉'];
        document.getElementById('trophies').innerHTML = kws.slice(0, 8).map((k, i) => {
          const medal = k.position <= 3 ? (medals[k.position-1] || '🏅') : k.position <= 10 ? '✓' : '·';
          const isMedal = k.position <= 3;
          const isPg1 = k.position <= 10;
          const delay = 1.2 + i * 0.08;
          return `
            <div class="trophy-row flex items-center gap-3 py-2.5 px-4 rounded-lg ${isMedal ? 'bg-emerald-500/[0.04]' : ''}" style="animation-delay:${delay}s">
              <span class="${isMedal ? 'text-lg' : isPg1 ? 'text-xs text-emerald-500 font-bold' : 'text-xs text-neutral-700'} w-7 text-center shrink-0">${medal}</span>
              <p class="text-sm ${isPg1 ? 'text-neutral-200' : 'text-neutral-500'} flex-1 truncate">${k.keyword}</p>
              <span class="text-xs font-mono tabular-nums ${isMedal ? 'text-emerald-400' : isPg1 ? 'text-neutral-400' : 'text-neutral-600'} shrink-0">#${k.position}</span>
              ${k.search_volume ? `<span class="text-[10px] text-neutral-700 w-14 text-right shrink-0">${k.search_volume >= 1000 ? (k.search_volume/1000).toFixed(1)+'k' : k.search_volume}/mo</span>` : ''}
            </div>`;
        }).join('');
      }

      // ── CHAPTER 3 ──
      if (issues.length > 0) {
        document.getElementById('checkup').innerHTML = CATS.map((cat, ci) => {
          const ci2 = issues.filter(i => cat.match(i.issue_name));
          const h = ci2.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;
          const m = ci2.filter(i => (i.priority||'').toLowerCase() === 'medium').length;
          const total = ci2.length;
          const delay = 1.4 + ci * 0.1;

          let status, statusColor, borderCol, bgCol, friendly;
          if (total === 0) {
            status = '✓ All clear';
            statusColor = 'text-emerald-400';
            borderCol = 'border-emerald-500/10';
            bgCol = 'bg-emerald-500/[0.03]';
            friendly = cat.ok;
          } else if (h > 0) {
            status = `${h + m} issue${(h+m) > 1 ? 's' : ''} found`;
            statusColor = 'text-red-400';
            borderCol = 'border-red-500/15';
            bgCol = 'bg-red-500/[0.03]';
            friendly = FRIENDLY[cat.key]?.high || '';
          } else if (m > 0) {
            status = `${m} to improve`;
            statusColor = 'text-amber-400';
            borderCol = 'border-amber-500/15';
            bgCol = 'bg-amber-500/[0.03]';
            friendly = FRIENDLY[cat.key]?.med || '';
          } else {
            status = '✓ Mostly good';
            statusColor = 'text-emerald-400/70';
            borderCol = 'border-white/5';
            bgCol = '';
            friendly = FRIENDLY[cat.key]?.low || '';
          }

          return `
            <div class="checkup-card border ${borderCol} ${bgCol} rounded-2xl p-6" style="animation-delay:${delay}s">
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl">${cat.icon}</span>
              </div>
              <p class="text-sm font-medium text-neutral-200 mb-1">${cat.label}</p>
              <p class="text-xs ${statusColor} font-medium mb-3">${status}</p>
              <p class="text-[11px] text-neutral-600 leading-relaxed">${friendly}</p>
            </div>`;
        }).join('');
      }
      } catch (err) {
        loadingEl.classList.add('hidden');
        errorDetail.textContent = err.message || 'Could not connect to the server. Please try again.';
        errorEl.classList.remove('hidden');
      }
    }

    loadDashboard();
  </script>
</Portal>
