---
import Portal from '../../layouts/Portal.astro';
import { getFilesForClient, getAllFilesAdmin } from '../../lib/storage';
import { getAllClients } from '../../lib/auth';
export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';

const files = isAdmin
  ? await getAllFilesAdmin()
  : user.client_id
    ? await getFilesForClient(user.client_id)
    : [];

const clients = isAdmin ? await getAllClients() : [];

// Group files by month
const byMonth = new Map<string, typeof files>();
for (const f of files) {
  const month = f.month;
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(f);
}
const months = [...byMonth.keys()].sort().reverse();

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

function categoryLabel(cat: string): string {
  const labels: Record<string, string> = {
    invoice: 'Invoice',
    report: 'Report',
    spreadsheet: 'Spreadsheet',
    general: 'General',
  };
  return labels[cat] || cat;
}
---

<Portal title="Files">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-semibold text-neutral-100">Files</h1>
        <p class="text-sm text-neutral-500 mt-1">Reports, invoices, and deliverables</p>
      </div>
    </div>

    {/* Admin upload form */}
    {isAdmin && (
      <form id="upload-form" class="bg-neutral-900/50 border border-white/5 rounded-xl p-6 mb-8">
        <h2 class="text-sm font-medium text-neutral-300 mb-4">Upload file</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div>
            <label class="block text-xs text-neutral-500 mb-1">Client</label>
            <select id="upload-client" name="client_id" required class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40">
              <option value="">Select...</option>
              {clients.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-xs text-neutral-500 mb-1">Month</label>
            <input type="month" id="upload-month" name="month" required
              value={new Date().toISOString().slice(0, 7)}
              class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40" />
          </div>
          <div>
            <label class="block text-xs text-neutral-500 mb-1">Category</label>
            <select id="upload-category" name="category" class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40">
              <option value="report">Report</option>
              <option value="invoice">Invoice</option>
              <option value="spreadsheet">Spreadsheet</option>
              <option value="general">General</option>
            </select>
          </div>
          <div>
            <label class="block text-xs text-neutral-500 mb-1">File</label>
            <input type="file" id="upload-file" name="file" required
              accept=".pdf,.docx,.xlsx,.xls,.csv,.png,.jpg,.jpeg,.webp"
              class="w-full text-sm text-neutral-400 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-amber-500 file:text-neutral-950 hover:file:bg-amber-400 file:cursor-pointer" />
          </div>
        </div>
        <div class="mt-4 flex items-center gap-4">
          <button type="submit" id="upload-btn" class="px-4 py-2 bg-amber-500 text-neutral-950 font-medium text-sm rounded-lg hover:bg-amber-400 transition-colors disabled:opacity-50">
            Upload
          </button>
          <p id="upload-msg" class="text-sm hidden"></p>
        </div>
      </form>
    )}

    {/* File list grouped by month */}
    {months.length > 0 ? (
      months.map(month => (
        <div class="mb-8">
          <h2 class="text-sm font-medium text-neutral-400 mb-3">
            {new Date(month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          </h2>
          <div class="space-y-2">
            {byMonth.get(month)!.map(f => (
              <div class="bg-neutral-900/30 border border-white/5 rounded-lg p-4 flex items-center justify-between group">
                <div class="flex items-center gap-4 min-w-0">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-200 truncate">{f.original_name}</p>
                    <div class="flex items-center gap-3 mt-0.5">
                      <span class="text-xs text-neutral-500">{formatBytes(f.size_bytes)}</span>
                      <span class="text-xs text-neutral-600">{categoryLabel(f.category)}</span>
                      {'client_name' in f && <span class="text-xs text-neutral-600">{f.client_name}</span>}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/portal/api/files/download?id=${f.id}`}
                    class="px-3 py-1.5 text-xs font-medium text-amber-400 border border-amber-500/20 rounded-lg hover:bg-amber-500/10 transition-colors"
                  >
                    Download
                  </a>
                  {isAdmin && (
                    <button
                      data-delete-file={f.id}
                      class="px-3 py-1.5 text-xs text-neutral-500 border border-white/5 rounded-lg hover:text-red-400 hover:border-red-500/20 transition-colors opacity-0 group-hover:opacity-100"
                    >
                      Delete
                    </button>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    ) : (
      <div class="bg-neutral-900/50 border border-white/5 rounded-xl p-12 text-center">
        <p class="text-neutral-500">No files yet.</p>
        {isAdmin && <p class="text-sm text-neutral-600 mt-2">Use the form above to upload deliverables.</p>}
      </div>
    )}
  </div>

  <script>
    // Upload handler
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    if (form) {
      const btn = document.getElementById('upload-btn') as HTMLButtonElement;
      const msg = document.getElementById('upload-msg')!;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Uploading...';
        msg.classList.add('hidden');

        const formData = new FormData();
        formData.append('file', (document.getElementById('upload-file') as HTMLInputElement).files![0]);
        formData.append('client_id', (document.getElementById('upload-client') as HTMLSelectElement).value);
        formData.append('month', (document.getElementById('upload-month') as HTMLInputElement).value);
        formData.append('category', (document.getElementById('upload-category') as HTMLSelectElement).value);

        try {
          const res = await fetch('/portal/api/files/upload', { method: 'POST', body: formData });
          const data = await res.json();

          if (res.ok) {
            msg.textContent = `Uploaded "${data.filename}"`;
            msg.className = 'text-sm text-emerald-400';
            msg.classList.remove('hidden');
            setTimeout(() => location.reload(), 800);
          } else {
            throw new Error(data.error || 'Upload failed');
          }
        } catch (err: any) {
          msg.textContent = err.message;
          msg.className = 'text-sm text-red-400';
          msg.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Upload';
        }
      });
    }

    // Delete handlers
    document.querySelectorAll('[data-delete-file]').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Delete this file?')) return;
        const fileId = (btn as HTMLElement).dataset.deleteFile;
        const res = await fetch('/portal/api/files/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ file_id: fileId }),
        });
        if (res.ok) location.reload();
      });
    });
  </script>
</Portal>
