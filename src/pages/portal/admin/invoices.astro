---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
import { getInvoicesByClient } from '../../../lib/invoices';
export const prerender = false;

const clients = await getAllClients();
const clientId = Astro.url.searchParams.get('client');
const invoices = clientId ? await getInvoicesByClient(clientId) : [];

const statusColors: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  sent: 'bg-blue-500/10 text-blue-400',
  paid: 'bg-emerald-500/10 text-emerald-400',
  partial: 'bg-amber-500/10 text-amber-600',
  overdue: 'bg-red-500/10 text-red-400',
  cancelled: 'bg-red-500/10 text-red-400',
};
---

<Portal title="Invoices">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Invoices</h1>
    </div>

    <form method="GET" class="mb-8">
      <select name="client" onchange="this.form.submit()" class="px-4 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-sm text-neutral-300 focus:outline-none focus:border-amber-500/30">
        <option value="">Select a client...</option>
        {clients.map(c => (
          <option value={c.id} selected={c.id === clientId}>{c.name}</option>
        ))}
      </select>
    </form>

    {!clientId ? (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">Select a client</p>
        <p class="text-sm text-neutral-500">Choose a client above to view their invoices.</p>
      </div>
    ) : invoices.length > 0 ? (
      <div class="space-y-3">
        {invoices.map(inv => (
          <a href={`/portal/admin/invoices/${inv.id}`} class="block bg-neutral-900/30 border border-white/5 rounded-xl p-5 hover:border-white/10 transition-all group">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium font-mono text-neutral-200 group-hover:text-amber-600 transition-colors">{inv.invoice_number}</p>
                <div class="flex items-center gap-4 mt-1 text-xs text-neutral-400">
                  {inv.issued_date && <span>Issued: {inv.issued_date}</span>}
                  {inv.due_date && <span>Due: {inv.due_date}</span>}
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <p class="text-sm font-mono text-neutral-300">${inv.total.toFixed(2)}</p>
                  {inv.amount_paid > 0 && inv.amount_paid < inv.total && (
                    <p class="text-[10px] text-neutral-400">Paid: ${inv.amount_paid.toFixed(2)}</p>
                  )}
                </div>
                <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[inv.status] || ''}`}>{inv.status}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No invoices</p>
        <p class="text-sm text-neutral-500">Create invoices from a contract's detail page.</p>
      </div>
    )}
  </div>
</Portal>
