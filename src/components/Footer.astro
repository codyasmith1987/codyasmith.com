---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/5 mt-32">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div>
        <p class="font-serif text-lg text-neutral-100 mb-1">Cody Smith</p>
        <p class="text-neutral-500 text-sm">Cedar City, Utah</p>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <a data-email class="text-neutral-500 hover:text-amber-400 text-sm transition-colors duration-200 cursor-pointer">
          <span class="email-placeholder">cody at codyasmith.com</span>
        </a>
        <a href="tel:+14358687133" class="text-neutral-500 hover:text-amber-400 text-sm transition-colors duration-200">
          (435) 868-7133
        </a>
      </div>
    </div>
    <div class="h-px bg-neutral-800 mt-10 mb-6"></div>
    <div class="flex items-center justify-between">
      <p class="text-neutral-700 text-xs">
        &copy; {year} Cody Smith. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href="/privacy" class="text-neutral-700 hover:text-amber-400 text-xs transition-colors duration-200">Privacy</a>
        <a href="/portal/login" class="text-neutral-700 hover:text-amber-400 text-xs transition-colors duration-200">Client Portal</a>
        <button id="repersonalize-btn" class="text-neutral-700 hover:text-amber-400 text-xs transition-colors duration-200 cursor-pointer" style="display:none">
          Repersonalize
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  function hydrateEmails() {
    const user = 'cody';
    const domain = 'codyasmith.com';
    document.querySelectorAll('[data-email]').forEach(el => {
      const addr = `${user}@${domain}`;
      el.setAttribute('href', `mailto:${addr}`);
      const placeholder = el.querySelector('.email-placeholder');
      if (placeholder) placeholder.textContent = addr;
    });
  }
  function initRepersonalize() {
    const btn = document.getElementById('repersonalize-btn');
    if (!btn) return;
    if (localStorage.getItem('cs-quiz-done')) btn.style.display = '';
    btn.addEventListener('click', () => {
      localStorage.removeItem('cs-quiz-done');
      localStorage.removeItem('cs-theme');
      localStorage.removeItem('cs-quiz-answers');
      document.documentElement.removeAttribute('data-theme');
      window.location.reload();
    });
  }

  hydrateEmails();
  initRepersonalize();
  document.addEventListener('astro:after-swap', () => { hydrateEmails(); initRepersonalize(); });
</script>
