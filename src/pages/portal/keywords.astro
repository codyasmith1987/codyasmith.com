---
import Portal from '../../layouts/Portal.astro';
import ClientSelector from '../../components/portal/ClientSelector.astro';
import StateLoading from '../../components/portal/StateLoading.astro';
import StateError from '../../components/portal/StateError.astro';
import StateEmpty from '../../components/portal/StateEmpty.astro';
import { getAllClients } from '../../lib/auth';
export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';
const clients = isAdmin ? await getAllClients() : [];
---

<Portal title="Keywords">

  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Search Visibility</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Keyword Rankings</h1>
      </div>
      <div class="flex items-center gap-3">
        {isAdmin && <ClientSelector clients={clients} />}
        <select id="kw-source" class="px-3 py-2 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-400 text-xs focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
          <option value="position_tracking">Tracked Rankings</option>
          <option value="keyword_research">All Keywords</option>
          <option value="keyword_suggestions">Opportunities</option>
        </select>
      </div>
    </div>

    <!-- Visibility summary -->
    <div id="kw-summary" class="mb-10 hidden kw-animate">
      <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8">
        <div class="grid grid-cols-4 gap-6 mb-8">
          <div class="text-center">
            <p id="kw-total" class="text-3xl font-bold text-neutral-100 mb-1">—</p>
            <p class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase">tracked</p>
          </div>
          <div class="text-center">
            <p id="kw-top3" class="text-3xl font-bold text-emerald-400 mb-1">—</p>
            <p class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase">top 3</p>
          </div>
          <div class="text-center">
            <p id="kw-page1" class="text-3xl font-bold text-amber-600 mb-1">—</p>
            <p class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase">page 1</p>
          </div>
          <div class="text-center">
            <p id="kw-buried" class="text-3xl font-bold text-neutral-400 mb-1">—</p>
            <p class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase">page 2+</p>
          </div>
        </div>
        <!-- Position distribution bar -->
        <div class="h-2 rounded-full overflow-hidden flex bg-neutral-800/50">
          <div id="bar-top3" class="bg-emerald-500 transition-all duration-700 ease-out"></div>
          <div id="bar-page1" class="bg-amber-500 transition-all duration-700 ease-out"></div>
          <div id="bar-page2" class="bg-neutral-600 transition-all duration-700 ease-out"></div>
        </div>
        <div class="flex justify-between mt-2.5">
          <span class="text-[10px] text-neutral-500">Position 1</span>
          <span class="text-[10px] text-neutral-500">Position 100+</span>
        </div>
        <p id="kw-narrative" class="text-sm text-neutral-400 mt-6 leading-relaxed"></p>
      </div>
    </div>

    <StateLoading id="kw-loading" message="Loading keywords..." />
    <StateError id="kw-error" detailId="kw-error-detail" retryFn="loadKeywords" />

    <!-- Search filter -->
    <div class="mb-6 hidden" id="kw-search-wrap">
      <input type="search" id="kw-search" placeholder="Search keywords..."
        class="w-full px-4 py-3 bg-neutral-900/30 border border-white/5 rounded-lg text-neutral-100 text-sm placeholder-neutral-700 focus:outline-none focus:border-amber-500/30 transition-all duration-300" />
    </div>

    <!-- Keyword list -->
    <div id="kw-list" class="space-y-1"></div>
    <div id="kw-load-more" class="hidden text-center mt-6">
      <button onclick="showMore()" class="px-6 py-3 border border-white/5 text-neutral-400 text-sm rounded-lg hover:border-amber-500/20 hover:text-amber-600 transition-all duration-300">
        Show more
      </button>
    </div>
    <p id="kw-count" class="mt-6 text-[10px] font-mono text-neutral-500 tracking-wide uppercase"></p>

    <StateEmpty
      id="kw-empty"
      title="No keyword data yet"
      message={isAdmin ? 'Upload a position tracking CSV to start seeing rankings here.' : 'Your keyword rankings will appear here once data is available.'}
    />
  </div>

  <script define:vars={{ clientId: user.client_id, isAdmin, firstClientId: clients[0]?.id || '' }}>
    function escapeHtml(s) {
      if (s == null) return '';
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    let activeClientId = isAdmin ? firstClientId : clientId;
    let allKeywords = [];
    let searchTimeout;
    let visibleCount = 100;

    const selector = document.getElementById('client-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        activeClientId = e.target.value;
        loadKeywords();
      });
    }

    async function loadKeywords() {
      const loadingEl = document.getElementById('kw-loading');
      const errorEl = document.getElementById('kw-error');
      const searchWrap = document.getElementById('kw-search-wrap');

      loadingEl.classList.remove('hidden');
      errorEl.classList.add('hidden');
      searchWrap.classList.add('hidden');
      document.getElementById('kw-summary').classList.add('hidden');
      document.getElementById('kw-empty').classList.add('hidden');
      document.getElementById('kw-list').innerHTML = '';
      document.getElementById('kw-count').textContent = '';

      const source = document.getElementById('kw-source').value;
      const cid = activeClientId;
      if (!cid) {
        loadingEl.classList.add('hidden');
        document.getElementById('kw-empty').classList.remove('hidden');
        return;
      }

      try {
        const res = await fetch(`/portal/api/dashboard/keywords?client_id=${cid}&source=${source}&limit=500`);
        if (!res.ok) throw new Error('Failed to load keyword data');
        const data = await res.json();
        allKeywords = data.keywords || [];

        loadingEl.classList.add('hidden');

        const summaryEl = document.getElementById('kw-summary');
        const emptyEl = document.getElementById('kw-empty');

        if (allKeywords.length === 0) {
          summaryEl.classList.add('hidden');
          emptyEl.classList.remove('hidden');
          return;
        }

        emptyEl.classList.add('hidden');
        summaryEl.classList.remove('hidden');
        searchWrap.classList.remove('hidden');

        const withPos = allKeywords.filter(k => k.position);
        const top3 = withPos.filter(k => k.position <= 3).length;
        const page1 = withPos.filter(k => k.position <= 10).length;
        const page2 = withPos.filter(k => k.position > 10 && k.position <= 20).length;
        const buried = withPos.filter(k => k.position > 20).length;
        const total = withPos.length;

        document.getElementById('kw-total').textContent = allKeywords.length;
        document.getElementById('kw-top3').textContent = top3;
        document.getElementById('kw-page1').textContent = page1;
        document.getElementById('kw-buried').textContent = (page2 + buried) || '0';

        // Distribution bar
        if (total > 0) {
          document.getElementById('bar-top3').style.width = `${(top3 / total) * 100}%`;
          document.getElementById('bar-page1').style.width = `${((page1 - top3) / total) * 100}%`;
          document.getElementById('bar-page2').style.width = `${((page2 + buried) / total) * 100}%`;
        }

        // Narrative
        const totalVol = withPos.filter(k => k.position <= 10).reduce((s, k) => s + (k.search_volume || 0), 0);
        let narr = '';
        if (source === 'position_tracking') {
          narr = `You're tracking ${total} keyword${total !== 1 ? 's' : ''}. ${page1} show${page1 !== 1 ? '' : 's'} up on Google's first page`;
          if (totalVol > 0) narr += `, reaching approximately ${totalVol.toLocaleString()} searches per month`;
          narr += `. ${top3 > 0 ? `${top3} keyword${top3 !== 1 ? 's rank' : ' ranks'} in the top 3. That's premium placement.` : ''}`;
          if (page2 > 0) narr += ` ${page2} keyword${page2 !== 1 ? 's are' : ' is'} on page 2, close to breaking onto page 1.`;
        } else if (source === 'keyword_research') {
          narr = `${allKeywords.length} keywords found across your site. These represent the search terms Google already associates with your content.`;
        } else {
          narr = `${allKeywords.length} keyword opportunities identified. These are searches your target audience is making that you could rank for with the right content.`;
        }
        document.getElementById('kw-narrative').textContent = narr;

        visibleCount = 100;
        renderList();
      } catch (err) {
        loadingEl.classList.add('hidden');
        document.getElementById('kw-error-detail').textContent = err.message || 'Could not connect to the server.';
        errorEl.classList.remove('hidden');
      }
    }

    function renderList() {
      const filter = (document.getElementById('kw-search').value || '').toLowerCase();
      const filtered = filter ? allKeywords.filter(k => k.keyword.toLowerCase().includes(filter)) : allKeywords;
      const list = document.getElementById('kw-list');
      const count = document.getElementById('kw-count');

      if (filtered.length === 0) {
        list.innerHTML = '<p class="text-sm text-neutral-400 py-8 text-center">No matches</p>';
        count.textContent = '';
        return;
      }

      const showing = filtered.slice(0, visibleCount);
      const loadMoreEl = document.getElementById('kw-load-more');
      loadMoreEl.classList.toggle('hidden', filtered.length <= visibleCount);

      list.innerHTML = showing.map((k, i) => {
        const pos = k.position;
        let posColor = 'text-neutral-400';
        let posBg = 'bg-neutral-800/50';
        if (pos && pos <= 3) { posColor = 'text-emerald-400'; posBg = 'bg-emerald-500/10'; }
        else if (pos && pos <= 10) { posColor = 'text-amber-600'; posBg = 'bg-amber-500/10'; }
        else if (pos && pos <= 20) { posColor = 'text-neutral-400'; posBg = 'bg-neutral-800'; }
        const delay = Math.min(i * 0.03, 1.5);

        const urlDisplay = k.url ? String(k.url).replace('https://', '') : '';
        return `
          <div class="kw-animate flex items-center justify-between py-3 px-4 rounded-lg hover:bg-white/[0.02] transition-all duration-300" style="animation-delay:${delay}s">
            <div class="flex items-center gap-4 min-w-0">
              <span class="text-xs font-mono ${posColor} ${posBg} w-10 text-center py-1.5 rounded-md shrink-0">
                ${pos ? '#' + pos : '—'}
              </span>
              <div class="min-w-0">
                <span class="text-sm text-neutral-200 block truncate">${escapeHtml(k.keyword)}</span>
                ${k.url ? `<a href="${escapeHtml(k.url)}" target="_blank" rel="noopener noreferrer" class="text-[10px] text-amber-600 hover:underline block truncate mt-0.5">${escapeHtml(urlDisplay)}</a>` : ''}
              </div>
            </div>
            <div class="flex items-center gap-5 shrink-0 ml-4">
              ${k.search_volume ? `<span class="text-xs font-mono text-neutral-400">${Number(k.search_volume).toLocaleString()}/mo</span>` : ''}
              ${k.seo_difficulty != null ? `<span class="text-xs font-mono ${k.seo_difficulty <= 30 ? 'text-emerald-600' : k.seo_difficulty <= 60 ? 'text-amber-600' : 'text-red-600'}">${Number(k.seo_difficulty)} SD</span>` : ''}
              ${k.change ? `<span class="text-xs font-mono ${k.change < 0 ? 'text-emerald-400' : 'text-red-400'}">${k.change < 0 ? '↑' : '↓'}${Math.abs(Number(k.change))}</span>` : ''}
            </div>
          </div>
        `;
      }).join('');

      count.textContent = filtered.length > visibleCount
        ? `Showing ${visibleCount} of ${filtered.length} keywords`
        : `${filtered.length} keyword${filtered.length !== 1 ? 's' : ''}`;
    }

    function showMore() {
      visibleCount += 100;
      renderList();
    }

    // Debounced search
    document.getElementById('kw-search').addEventListener('input', () => {
      clearTimeout(searchTimeout);
      visibleCount = 100;
      searchTimeout = setTimeout(renderList, 200);
    });
    document.getElementById('kw-source').addEventListener('change', loadKeywords);

    loadKeywords();
  </script>
</Portal>
