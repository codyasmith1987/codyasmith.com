---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
import { getInvoicesByClient } from '../../../lib/invoices';
import { getClientExpenses } from '../../../lib/client-expenses';
import { getClientMetadata } from '../../../lib/agreements';
export const prerender = false;

const clients = await getAllClients();
const clientId = Astro.url.searchParams.get('client');
const invoices = clientId ? await getInvoicesByClient(clientId) : [];
const expenses = clientId ? await getClientExpenses(clientId) : [];
const meta = clientId ? await getClientMetadata(clientId).catch(() => null) : null;

const statusColors: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  sent: 'bg-blue-500/10 text-blue-400',
  paid: 'bg-emerald-500/10 text-emerald-400',
  partial: 'bg-amber-500/10 text-amber-600',
  overdue: 'bg-red-500/10 text-red-400',
  cancelled: 'bg-red-500/10 text-red-400',
};
---

<Portal title="Invoices">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Invoices</h1>
    </div>

    <form method="GET" class="mb-8">
      <select name="client" onchange="this.form.submit()" class="px-4 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-sm text-neutral-300 focus:outline-none focus:border-amber-500/30">
        <option value="">Select a client...</option>
        {clients.map(c => (
          <option value={c.id} selected={c.id === clientId}>{c.name}</option>
        ))}
      </select>
    </form>

    {!clientId ? (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">Select a client</p>
        <p class="text-sm text-neutral-500">Choose a client above to view their invoices.</p>
      </div>
    ) : invoices.length > 0 ? (
      <div class="space-y-3">
        {invoices.map(inv => (
          <a href={`/portal/admin/invoices/${inv.id}`} class="block bg-neutral-900/30 border border-white/5 rounded-xl p-5 hover:border-white/10 transition-all group">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium font-mono text-neutral-200 group-hover:text-amber-600 transition-colors">{inv.invoice_number}</p>
                <div class="flex items-center gap-4 mt-1 text-xs text-neutral-400">
                  {inv.issued_date && <span>Issued: {inv.issued_date}</span>}
                  {inv.due_date && <span>Due: {inv.due_date}</span>}
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right">
                  <p class="text-sm font-mono text-neutral-300">${inv.total.toFixed(2)}</p>
                  {inv.amount_paid > 0 && inv.amount_paid < inv.total && (
                    <p class="text-[10px] text-neutral-400">Paid: ${inv.amount_paid.toFixed(2)}</p>
                  )}
                </div>
                <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[inv.status] || ''}`}>{inv.status}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No invoices</p>
        <p class="text-sm text-neutral-500">Create invoices from a contract's detail page.</p>
      </div>
    )}

    {clientId && (
      <div class="mt-14">
        <div class="mb-4">
          <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-1">Billing recipients</p>
          <p class="text-sm text-neutral-400">Who invoices and payment notices go to. The primary contact is the recipient; the accountant is CC'd on financial notices only. Leave a field blank to clear it. (A per-invoice extra recipient is set on the invoice itself.)</p>
        </div>
        <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Primary contact email</label>
              <input type="email" id="bc-primary" value={meta?.primary_contact_email || ''} placeholder="client@example.com" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Accountant CC email (optional)</label>
              <input type="email" id="bc-cc" value={meta?.billing_cc_email || ''} placeholder="accountant@example.com" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            </div>
          </div>
          <button id="save-billing-contacts" class="mt-4 px-5 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Save recipients</button>
        </div>
      </div>
    )}

    {clientId && (
      <div class="mt-14">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-1">Recurring expenses</p>
            <p class="text-sm text-neutral-400">Plugin and tool licenses you pay for and pass through. These auto-fill the Reimbursements section of this client's generated invoices.</p>
          </div>
          <button id="show-add-expense" class="text-xs text-amber-600 hover:text-amber-600 transition-colors shrink-0 ml-4">+ Add expense</button>
        </div>

        <form id="add-expense-form" class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 mb-4 hidden">
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <input type="text" id="ae-name" required placeholder="Name (e.g. Kadence Ultimate)" class="sm:col-span-2 px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            <input type="number" id="ae-amount" required step="0.01" min="0" placeholder="Amount" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            <select id="ae-frequency" class="px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
              <option value="monthly">Monthly</option>
              <option value="annual">Annual</option>
              <option value="one_time">One-time</option>
            </select>
          </div>
          <div class="flex gap-3 mt-4">
            <button type="submit" class="px-5 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Add</button>
            <button type="button" id="cancel-add-expense" class="text-sm text-neutral-500 hover:text-neutral-300">Cancel</button>
          </div>
        </form>

        {expenses.length > 0 ? (
          <div class="space-y-2">
            {expenses.map(e => (
              <div class={`bg-neutral-900/30 border border-white/5 rounded-xl p-4 flex items-center justify-between ${e.active === 0 ? 'opacity-50' : ''}`}>
                <div>
                  <p class="text-sm text-neutral-200">{e.name}<span class="ml-2 text-[10px] font-mono text-amber-600/80 uppercase">{e.frequency.replace('_', '-')}</span></p>
                  <p class="text-xs text-neutral-500 mt-0.5">${e.amount.toFixed(2)} {e.last_billed_on ? `(last billed ${e.last_billed_on})` : '(not yet billed)'}</p>
                </div>
                <div class="flex items-center gap-3">
                  <button data-toggle-expense={e.id} data-active={e.active} class="text-xs text-neutral-400 hover:text-amber-600 transition-colors">{e.active === 1 ? 'Pause' : 'Activate'}</button>
                  <button data-delete-expense={e.id} class="text-xs text-neutral-400 hover:text-red-400 transition-colors">Delete</button>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-sm text-neutral-500 py-3">No recurring expenses for this client yet.</p>
        )}
      </div>
    )}
  </div>

  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const clientId = new URLSearchParams(location.search).get('client');

    // Save billing recipients (primary contact + accountant CC)
    document.getElementById('save-billing-contacts')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const run = async () => {
        const res = await fetch('/portal/api/admin/clients/billing-contacts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({
            client_id: clientId,
            primary_contact_email: (document.getElementById('bc-primary') as HTMLInputElement).value.trim(),
            billing_cc_email: (document.getElementById('bc-cc') as HTMLInputElement).value.trim(),
          }),
        });
        if (res.ok) (window as any).__toast?.('Billing recipients saved.', 'success');
        else { const d = await res.json().catch(() => ({})); (window as any).__toast?.(d.error || 'Failed to save recipients.', 'error'); }
      };
      if ((window as any).__withButtonLoading) await (window as any).__withButtonLoading(btn, 'Saving…', run);
      else await run();
    });

    const form = document.getElementById('add-expense-form');
    document.getElementById('show-add-expense')?.addEventListener('click', () => form?.classList.remove('hidden'));
    document.getElementById('cancel-add-expense')?.addEventListener('click', () => form?.classList.add('hidden'));

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/portal/api/admin/expenses', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          client_id: clientId,
          name: (document.getElementById('ae-name') as HTMLInputElement).value.trim(),
          amount: Number((document.getElementById('ae-amount') as HTMLInputElement).value),
          frequency: (document.getElementById('ae-frequency') as HTMLSelectElement).value,
        }),
      });
      if (res.ok) location.reload();
      else { const d = await res.json().catch(() => ({})); (window as any).__toast?.(d.error || 'Failed to add expense', 'error'); }
    });

    document.querySelectorAll('[data-toggle-expense]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-toggle-expense');
        const active = btn.getAttribute('data-active') === '1';
        const res = await fetch(`/portal/api/admin/expenses/${id}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ active: !active }),
        });
        if (res.ok) location.reload();
      });
    });

    document.querySelectorAll('[data-delete-expense]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-delete-expense');
        const ok = await ((window as any).__confirm?.({ title: 'Delete expense', message: 'Remove this recurring expense template?', confirmLabel: 'Delete', danger: true }) ?? Promise.resolve(true));
        if (!ok) return;
        const res = await fetch(`/portal/api/admin/expenses/${id}`, { method: 'DELETE', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken } });
        if (res.ok) location.reload();
      });
    });
  </script>
</Portal>
