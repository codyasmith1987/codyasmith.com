---
import '../../styles/global.css';
export const prerender = false;

// If already logged in, redirect to dashboard
const token = Astro.cookies.get('portal_session')?.value;
if (token) {
  const { validateSession } = await import('../../lib/auth');
  const result = await validateSession(token);
  if (result) return Astro.redirect('/portal/dashboard');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Log In | Client Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-300 font-sans flex items-center justify-center">
    <div class="w-full max-w-sm mx-auto px-6">
      <!-- Back link -->
      <a href="/" class="inline-flex items-center gap-2 text-xs text-neutral-600 hover:text-amber-400 transition-colors duration-200 mb-12">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        codyasmith.com
      </a>

      <div class="text-center mb-10">
        <h1 class="font-serif text-4xl text-neutral-100 mb-3">Client Portal</h1>
      </div>

      <div id="login-form-container">
        <form id="login-form" class="space-y-5">
          <div>
            <label for="email" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
              placeholder="you@company.com"
            />
          </div>
          <div>
            <label for="password" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Password</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="current-password"
                class="w-full px-4 py-3 pr-12 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
                placeholder="Your password"
              />
              <button type="button" id="toggle-pw" class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-600 hover:text-neutral-400 transition-colors" aria-label="Show password">
                <svg id="eye-closed" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12c1.292 4.338 5.31 7.5 10.066 7.5.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" /></svg>
                <svg id="eye-open" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /></svg>
              </button>
            </div>
          </div>
          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Log in
          </button>
        </form>
      </div>

      <div id="error-message" class="hidden mt-6 p-4 bg-red-500/5 border border-red-500/15 rounded-lg text-sm text-red-400 leading-relaxed"></div>

      <p class="text-center text-xs text-neutral-700 mt-12">
        Don't have access yet? <a href="mailto:cody@codyasmith.com?subject=Portal%20Access%20Request" class="text-neutral-500 hover:text-amber-400 transition-colors duration-200">Request it here</a>
      </p>
    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('error-message')!;

      // Show error from redirect (e.g. expired session, inactive account)
      const urlError = new URLSearchParams(window.location.search).get('error');
      if (urlError === 'expired') {
        errorEl.textContent = 'Your session has expired. Please log in again.';
        errorEl.classList.remove('hidden');
      } else if (urlError === 'inactive') {
        errorEl.textContent = 'Your account is currently inactive. Contact Cody if you think this is a mistake.';
        errorEl.classList.remove('hidden');
      }

      document.getElementById('toggle-pw')!.addEventListener('click', () => {
        const pw = document.getElementById('password') as HTMLInputElement;
        const show = pw.type === 'password';
        pw.type = show ? 'text' : 'password';
        document.getElementById('eye-closed')!.classList.toggle('hidden', show);
        document.getElementById('eye-open')!.classList.toggle('hidden', !show);
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Logging in...';
        errorEl.classList.add('hidden');

        const email = (form.querySelector('#email') as HTMLInputElement).value;
        const password = (form.querySelector('#password') as HTMLInputElement).value;

        try {
          const res = await fetch('/portal/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password }),
          });

          const data = await res.json();

          if (res.ok) {
            window.location.href = '/portal/dashboard';
          } else {
            errorEl.textContent = data.error || 'Login failed';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Log in';
          }
        } catch (err: any) {
          errorEl.textContent = 'Connection error. Try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Log in';
        }
      });
    </script>
  </body>
</html>
