---
// Quiz lightbox - shown on first visit
// Four binary questions determine the site theme and persona
// Sun/Moon (energy) + Beach/Mountain (orientation) + Spring/Fall (phase) + Stars/Clouds (processing)
// Name + email captured as lead
---

<div id="quiz" class="fixed inset-0 z-[70]" style="display:none">
  <!-- Frosted glass: layered depth — blur + gradient vignette + grain -->
  <div id="quiz-backdrop" class="absolute inset-0 transition-all duration-1000 ease-out" style="backdrop-filter:blur(50px) saturate(1.1);-webkit-backdrop-filter:blur(50px) saturate(1.1);background:radial-gradient(ellipse at 50% 40%, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.85) 60%, rgba(0,0,0,0.92) 100%)"></div>
  <!-- Vortex: canvas-based particle system — real chaos, never repeats -->
  <canvas id="quiz-vortex" class="absolute inset-0 w-full h-full pointer-events-none" style="transition:opacity 1.2s ease"></canvas>
  <div class="relative z-10 min-h-screen flex items-center justify-center p-6">
    <div class="max-w-lg w-full">

      <!-- Step 0: Intro -->
      <div data-step="0" class="quiz-step text-center">
        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-8" style="color:#d4926a">Before we start</p>
        <h2 class="font-serif text-4xl md:text-5xl leading-tight mb-6" style="color:#f0e8df">
          Want to personalize<br/>your experience?
        </h2>
        <p class="text-lg mb-12" style="color:#a69a8e">Four questions. Fifteen seconds. The site adapts to you.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button data-action="next" class="px-8 py-4 font-semibold text-sm rounded-lg transition-all duration-300" style="background:#c47d5a;color:#15120f" onmouseover="this.style.background='#d4926a'" onmouseout="this.style.background='#c47d5a'">
            I sure would
          </button>
          <button data-action="skip" class="px-8 py-4 font-medium text-sm rounded-lg border transition-all duration-300" style="border-color:#302a23;color:#847a6e" onmouseover="this.style.borderColor='#4d453c';this.style.color='#a69a8e'" onmouseout="this.style.borderColor='#302a23';this.style.color='#847a6e'">
            Nah, I'm pretty bland
          </button>
        </div>
      </div>

      <!-- Step 1: Sun or Moon -->
      <div data-step="1" class="quiz-step text-center" style="display:none">
        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-10" style="color:#847a6e">1 of 4</p>
        <h2 class="font-serif text-5xl md:text-6xl mb-14" style="color:#f0e8df">Sun or moon?</h2>
        <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
          <button data-answer="sun" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#9728;&#65039;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Sun</span>
          </button>
          <button data-answer="moon" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#127769;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Moon</span>
          </button>
        </div>
      </div>

      <!-- Step 2: Beach or Mountain -->
      <div data-step="2" class="quiz-step text-center" style="display:none">
        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-10" style="color:#847a6e">2 of 4</p>
        <h2 class="font-serif text-5xl md:text-6xl mb-14" style="color:#f0e8df">Beach or mountain?</h2>
        <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
          <button data-answer="beach" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#127958;&#65039;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Beach</span>
          </button>
          <button data-answer="mountain" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#9968;&#65039;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Mountain</span>
          </button>
        </div>
      </div>

      <!-- Step 3: Spring or Fall -->
      <div data-step="3" class="quiz-step text-center" style="display:none">
        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-10" style="color:#847a6e">3 of 4</p>
        <h2 class="font-serif text-5xl md:text-6xl mb-14" style="color:#f0e8df">Spring or fall?</h2>
        <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
          <button data-answer="spring" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#127793;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Spring</span>
          </button>
          <button data-answer="fall" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#127810;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Fall</span>
          </button>
        </div>
      </div>

      <!-- Step 4: Stars or Clouds -->
      <div data-step="4" class="quiz-step text-center" style="display:none">
        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-10" style="color:#847a6e">4 of 4</p>
        <h2 class="font-serif text-5xl md:text-6xl mb-14" style="color:#f0e8df">Stars or clouds?</h2>
        <div class="grid grid-cols-2 gap-4 max-w-sm mx-auto">
          <button data-answer="stars" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#10024;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Stars</span>
          </button>
          <button data-answer="clouds" class="quiz-choice group relative p-8 rounded-xl border transition-all duration-300 cursor-pointer" style="border-color:#302a23;background:transparent" onmouseover="this.style.borderColor='#d4926a';this.style.background='rgba(196,125,90,0.05)'" onmouseout="this.style.borderColor='#302a23';this.style.background='transparent'">
            <span class="block text-3xl mb-3">&#9729;&#65039;</span>
            <span class="font-serif text-2xl" style="color:#f0e8df">Clouds</span>
          </button>
        </div>
      </div>

      <!-- Step 5: Lead capture -->
      <div data-step="5" class="quiz-step text-center" style="display:none">

        <p class="font-mono text-xs tracking-[0.2em] uppercase mb-8" style="color:#d4926a">Almost done</p>
        <h2 class="font-serif text-3xl md:text-4xl leading-tight mb-4" style="color:#f0e8df">
          Now I know how to set the room.
        </h2>
        <p class="text-lg mb-10" style="color:#a69a8e">Who am I building this for?</p>
        <form id="quiz-form" class="max-w-xs mx-auto space-y-5">
          <div>
            <input type="text" id="quiz-name" placeholder="Your name" required class="w-full bg-transparent border-b pb-3 text-lg focus:outline-none transition-colors duration-300 placeholder:opacity-40" style="border-color:#302a23;color:#f0e8df" onfocus="this.style.borderColor='#d4926a'" onblur="this.style.borderColor='#302a23'" />
          </div>
          <div>
            <input type="email" id="quiz-email" placeholder="Email" required class="w-full bg-transparent border-b pb-3 text-lg focus:outline-none transition-colors duration-300 placeholder:opacity-40" style="border-color:#302a23;color:#f0e8df" onfocus="this.style.borderColor='#d4926a'" onblur="this.style.borderColor='#302a23'" />
          </div>
          <div class="pt-4 space-y-3">
            <button type="submit" class="w-full px-8 py-4 font-semibold text-sm rounded-lg transition-all duration-300" style="background:#c47d5a;color:#15120f" onmouseover="this.style.background='#d4926a'" onmouseout="this.style.background='#c47d5a'">
              Make it mine
            </button>
            <button type="button" data-action="skip-lead" class="w-full px-4 py-2 text-xs transition-colors duration-300" style="color:#685e54" onmouseover="this.style.color='#a69a8e'" onmouseout="this.style.color='#685e54'">
              Skip this part
            </button>
          </div>
        </form>
      </div>

      <!-- Step 6: Reveal interstitial -->
      <div data-step="6" class="quiz-step text-center" style="display:none">
        <p class="font-quote italic text-3xl md:text-4xl leading-snug" style="color:#f0e8df">
          Setting the room<span id="reveal-name"></span>...
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  function initQuiz() {
    const quiz = document.getElementById('quiz');
    if (!quiz) return;

    // Don't show if already completed
    if (localStorage.getItem('cs-quiz-done')) return;

    // Don't show if theme already set via URL
    if (new URLSearchParams(window.location.search).get('theme')) return;

    quiz.style.display = '';
    quiz.style.opacity = '0';
    quiz.style.transition = 'opacity 0.5s ease';
    requestAnimationFrame(() => { quiz.style.opacity = '1'; });

    let currentStep = 0;
    const answers: Record<string, string> = {};
    const steps = quiz.querySelectorAll('.quiz-step');

    function showStep(n: number) {
      steps.forEach((s, i) => {
        const el = s as HTMLElement;
        if (i === currentStep) {
          el.style.opacity = '0';
          setTimeout(() => { el.style.display = 'none'; }, 200);
        }
      });
      setTimeout(() => {
        const next = steps[n] as HTMLElement;
        if (next) {
          next.style.display = '';
          next.style.opacity = '0';
          next.style.transition = 'opacity 0.4s ease';
          requestAnimationFrame(() => { next.style.opacity = '1'; });
        }
        currentStep = n;
      }, 250);
    }

    // Preview theme behind the frosted glass as answers come in
    function previewTheme() {
      const base = answers['1'] || 'moon';
      const place = answers['2'] || 'mountain';
      const season = answers['3'] || 'fall';
      const processing = answers['4'] || 'stars';
      const preview = `${base}-${place}-${season}-${processing}`;
      document.documentElement.setAttribute('data-theme', preview);
    }

    function closeQuiz() {
      const backdrop = document.getElementById('quiz-backdrop');
      const vortexCanvas = document.getElementById('quiz-vortex');
      const content = quiz.querySelector('.relative.z-10') as HTMLElement;

      // Signal vortex to accelerate (final pull-in)
      if ((window as any).__vortexAccelerate) (window as any).__vortexAccelerate();

      // Phase 1: Content fades
      if (content) {
        content.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
        content.style.opacity = '0';
        content.style.transform = 'scale(0.97)';
      }

      // Phase 2: Blur lifts, vortex fades
      setTimeout(() => {
        if (backdrop) {
          backdrop.style.transition = 'all 1.4s cubic-bezier(0.4, 0, 0.2, 1)';
          backdrop.style.backdropFilter = 'blur(0px) saturate(1)';
          (backdrop.style as any).webkitBackdropFilter = 'blur(0px) saturate(1)';
          backdrop.style.background = 'transparent';
        }
        if (vortexCanvas) {
          vortexCanvas.style.opacity = '0';
        }
      }, 600);

      // Phase 3: Full clear
      setTimeout(() => {
        quiz.style.transition = 'opacity 0.3s ease';
        quiz.style.opacity = '0';
      }, 1800);

      setTimeout(() => {
        quiz.style.display = 'none';
        if ((window as any).__vortexStop) (window as any).__vortexStop();
        if (typeof (window as any).__initPersonalization === 'function') {
          (window as any).__initPersonalization();
        }
      }, 2100);
    }

    function showRevealThenClose(nameStr?: string) {
      // Set the name in the reveal text
      const revealName = document.getElementById('reveal-name');
      if (revealName && nameStr) {
        revealName.textContent = ` for ${nameStr.split(' ')[0]}`;
      }
      showStep(6);
      setTimeout(closeQuiz, 1400);
    }

    function buildThemeName(): string {
      const base = answers['1'] || 'moon';
      const place = answers['2'] || 'mountain';
      const season = answers['3'] || 'fall';
      const processing = answers['4'] || 'stars';
      return `${base}-${place}-${season}-${processing}`;
    }

    function applyTheme(theme: string) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('cs-theme', theme);
      localStorage.setItem('cs-quiz-done', '1');
      localStorage.setItem('cs-quiz-answers', JSON.stringify(answers));
    }

    // Handle all clicks in the quiz
    quiz.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;

      const action = btn.getAttribute('data-action');
      const answer = btn.getAttribute('data-answer');

      if (action === 'next') {
        showStep(1);
      } else if (action === 'skip') {
        localStorage.setItem('cs-quiz-done', '1');
        closeQuiz();
      } else if (action === 'skip-lead') {
        const theme = buildThemeName();
        applyTheme(theme);
        showRevealThenClose();
      } else if (answer) {
        // Store answer for current step
        answers[String(currentStep)] = answer;

        // Preview the theme behind the frosted glass
        previewTheme();

        // Brief highlight on the clicked button
        btn.style.borderColor = '#d4926a';
        btn.style.background = 'rgba(196,125,90,0.1)';

        setTimeout(() => {
          if (currentStep < 4) {
            showStep(currentStep + 1);
          } else {
            // All 4 questions answered, show lead capture
            showStep(5);
          }
        }, 300);
      }
    });

    // Handle form submission
    const form = document.getElementById('quiz-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('quiz-name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('quiz-email') as HTMLInputElement)?.value || '';
      const theme = buildThemeName();

      // Save name and email for personalization across the site
      answers['name'] = name;
      answers['email'] = email;

      applyTheme(theme);

      // Send lead data in background
      try {
        fetch('/api/quiz', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, theme, answers }),
        });
      } catch {
        // Fail silently - the theme still applies
      }

      showRevealThenClose(name);
    });
  }

  initQuiz();
  document.addEventListener('astro:after-swap', initQuiz);
</script>

<script>
  // Vortex particle system — tornado from inside, Inkheart chaos
  // Each particle is an ink tendril spiraling inward with noise-driven turbulence
  function initVortex() {
    const canvas = document.getElementById('quiz-vortex') as HTMLCanvasElement;
    if (!canvas || canvas.dataset.init === '1') return;
    canvas.dataset.init = '1';

    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, cx = 0, cy = 0;
    let running = true;
    let accelerating = false;
    let accelStart = 0;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cx = w / 2;
      cy = h / 2;
    }
    resize();
    window.addEventListener('resize', resize);

    // Simple noise function (no library needed)
    function noise(x: number, y: number, t: number): number {
      const s = Math.sin(x * 12.9898 + y * 78.233 + t * 43.4321) * 43758.5453;
      return (s - Math.floor(s)) * 2 - 1;
    }

    // Read accent color from CSS custom properties
    function getAccentColor(): [number, number, number] {
      const style = getComputedStyle(document.documentElement);
      const hex = style.getPropertyValue('--color-amber-500').trim();
      if (hex.startsWith('#') && hex.length >= 7) {
        return [
          parseInt(hex.slice(1, 3), 16),
          parseInt(hex.slice(3, 5), 16),
          parseInt(hex.slice(5, 7), 16),
        ];
      }
      return [245, 158, 11]; // fallback amber
    }

    // Particle definition
    interface Particle {
      angle: number;       // current angle in radians
      radius: number;      // distance from center
      baseRadius: number;  // original distance (for drift)
      speed: number;       // angular velocity (rad/frame)
      drift: number;       // inward/outward drift speed
      size: number;        // length of the tendril
      thickness: number;   // width of the tendril
      opacity: number;
      noiseOffsetX: number;
      noiseOffsetY: number;
      trail: number[];     // recent angles for tail
      hueShift: number;    // slight color variation
    }

    const particles: Particle[] = [];
    const COUNT = 45;

    for (let i = 0; i < COUNT; i++) {
      const dist = 60 + Math.random() * Math.min(w, h) * 0.45;
      const speed = (0.003 + Math.random() * 0.008) * (Math.random() > 0.3 ? 1 : -1);
      particles.push({
        angle: Math.random() * Math.PI * 2,
        radius: dist,
        baseRadius: dist,
        speed,
        drift: (Math.random() - 0.5) * 0.15,
        size: 30 + Math.random() * 80,
        thickness: 1 + Math.random() * 3,
        opacity: 0.15 + Math.random() * 0.45,
        noiseOffsetX: Math.random() * 1000,
        noiseOffsetY: Math.random() * 1000,
        trail: [],
        hueShift: (Math.random() - 0.5) * 40,
      });
    }

    let time = 0;
    let accentRGB = getAccentColor();

    // Re-read accent color when theme changes
    const themeObserver = new MutationObserver(() => {
      accentRGB = getAccentColor();
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    function draw() {
      if (!running) return;
      ctx.clearRect(0, 0, w, h);
      time += 0.008;

      const speedMult = accelerating ? 3 + Math.min((Date.now() - accelStart) / 500, 5) : 1;

      for (const p of particles) {
        // Noise-driven turbulence
        const nx = noise(p.noiseOffsetX, time * 0.7, p.angle) * 20;
        const ny = noise(p.noiseOffsetY, time * 0.5, p.radius * 0.01) * 20;

        // Spiral motion — faster when closer to center
        const radiusFactor = Math.max(0.3, p.radius / p.baseRadius);
        p.angle += (p.speed / radiusFactor) * speedMult;

        // Drift inward slowly (tornado pull), with some particles drifting out
        p.radius += p.drift * (accelerating ? -2 : 1);

        // Keep particles in bounds
        if (p.radius < 20) {
          p.radius = 60 + Math.random() * Math.min(w, h) * 0.4;
          p.angle = Math.random() * Math.PI * 2;
        }
        if (p.radius > Math.min(w, h) * 0.6) {
          p.drift = -Math.abs(p.drift); // pull back in
        }
        if (p.radius < 80 && !accelerating) {
          p.drift = Math.abs(p.drift) * 0.3; // gentle push out near center
        }

        // Position
        const x = cx + Math.cos(p.angle) * p.radius + nx;
        const y = cy + Math.sin(p.angle) * p.radius + ny;

        // Store trail
        p.trail.push(p.angle);
        if (p.trail.length > 8) p.trail.shift();

        // Draw tendril as a tapered line along the orbit path
        const tailAngle = p.trail[0] || p.angle;
        const tx = cx + Math.cos(tailAngle) * (p.radius + 5) + nx * 0.5;
        const ty = cy + Math.sin(tailAngle) * (p.radius + 5) + ny * 0.5;

        // Color with per-particle hue shift
        const r = Math.min(255, Math.max(0, accentRGB[0] + p.hueShift));
        const g = Math.min(255, Math.max(0, accentRGB[1] + p.hueShift * 0.5));
        const b = Math.min(255, Math.max(0, accentRGB[2] - p.hueShift * 0.3));

        // Gradient along the tendril: bright head, fading tail
        const grad = ctx.createLinearGradient(x, y, tx, ty);
        grad.addColorStop(0, `rgba(${r},${g},${b},${p.opacity})`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);

        ctx.beginPath();
        ctx.moveTo(x, y);

        // Curved path through midpoints for organic shape
        const mx = cx + Math.cos((p.angle + tailAngle) / 2) * (p.radius * 1.02) + nx * 0.7;
        const my = cy + Math.sin((p.angle + tailAngle) / 2) * (p.radius * 1.02) + ny * 0.7;
        ctx.quadraticCurveTo(mx, my, tx, ty);

        ctx.strokeStyle = grad;
        ctx.lineWidth = p.thickness * (accelerating ? 0.5 : 1);
        ctx.lineCap = 'round';
        ctx.stroke();

        // Small bright dot at the head of fast particles
        if (p.opacity > 0.35) {
          ctx.beginPath();
          ctx.arc(x, y, p.thickness * 0.8, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(${r},${g},${b},${p.opacity * 0.6})`;
          ctx.fill();
        }
      }

      // Soft glow at center (the eye)
      const eyeGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 120);
      eyeGrad.addColorStop(0, `rgba(${accentRGB[0]},${accentRGB[1]},${accentRGB[2]},0.06)`);
      eyeGrad.addColorStop(0.5, `rgba(${accentRGB[0]},${accentRGB[1]},${accentRGB[2]},0.02)`);
      eyeGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = eyeGrad;
      ctx.fillRect(cx - 120, cy - 120, 240, 240);

      requestAnimationFrame(draw);
    }

    requestAnimationFrame(draw);

    // Expose controls for the reveal transition
    (window as any).__vortexAccelerate = () => {
      accelerating = true;
      accelStart = Date.now();
      // Pull all particles inward
      for (const p of particles) {
        p.drift = -Math.abs(p.drift) * 3 - 0.5;
      }
    };
    (window as any).__vortexStop = () => {
      running = false;
      themeObserver.disconnect();
      canvas.dataset.init = '';
    };
  }

  initVortex();
  document.addEventListener('astro:after-swap', initVortex);
</script>
