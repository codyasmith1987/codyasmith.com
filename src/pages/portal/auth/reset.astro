---
// Password reset page. Reached from the emailed reset link
// (/portal/auth/reset?token=...). Lives under /portal/auth/ so middleware lets
// it through without a session: the token is the authorization. We do a
// READ-ONLY validity check here (isPasswordResetTokenValid does NOT consume the
// token) so an email-client prefetch cannot burn it before the user submits;
// the token is only consumed when they POST the new password.
export const prerender = false;

import '../../../styles/global.css';
import '../../../styles/portal.css';
import { isPasswordResetTokenValid } from '../../../lib/auth';

const token = Astro.url.searchParams.get('token') || '';
const valid = token ? await isPasswordResetTokenValid(token) : false;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Reset password | Client Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Editorial type stack — match the rest of the site. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body class="portal-editorial min-h-screen bg-neutral-950 text-neutral-300 font-sans flex items-center justify-center">
    <div class="w-full max-w-sm mx-auto px-6">
      {valid ? (
        <div>
          <div class="text-center mb-10">
            <h1
              class="text-4xl text-neutral-100 mb-3"
              style="font-family: var(--font-display); font-variation-settings: 'opsz' 72, 'SOFT' 30, 'WONK' 0; letter-spacing: -0.022em; font-weight: 500;"
            >Reset your password</h1>
            <p class="text-neutral-500 text-sm leading-relaxed">
              Choose a new password for your portal account.
            </p>
          </div>

          <form id="reset-form" class="space-y-5">
            <input type="hidden" id="token" value={token} />
            <div>
              <label for="password" class="block text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-2">New password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                autocomplete="new-password"
                minlength="12"
                class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
                placeholder="At least 12 characters"
              />
            </div>
            <div>
              <label for="confirm" class="block text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-2">Confirm new password</label>
              <input
                type="password"
                id="confirm"
                name="confirm"
                required
                autocomplete="new-password"
                minlength="12"
                class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
                placeholder="Re-enter your new password"
              />
            </div>
            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
            >
              Set new password
            </button>
          </form>

          <div id="error-message" role="status" aria-live="polite" class="hidden mt-6 p-4 bg-red-500/5 border border-red-500/15 rounded-lg text-sm text-red-400 leading-relaxed"></div>
        </div>
      ) : (
        <div class="text-center">
          <h1
            class="text-4xl text-neutral-100 mb-3"
            style="font-family: var(--font-display); font-variation-settings: 'opsz' 72, 'SOFT' 30, 'WONK' 0; letter-spacing: -0.022em; font-weight: 500;"
          >Link expired</h1>
          <p class="text-neutral-500 text-sm leading-relaxed mb-8">
            This password reset link is invalid or has expired. Reset links are good for 1 hour. Head back to the login page to request a fresh one.
          </p>
          <a
            href="/portal/login"
            class="inline-block w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-colors duration-200"
          >
            Back to login
          </a>
        </div>
      )}
    </div>

    <script>
      const form = document.getElementById('reset-form') as HTMLFormElement | null;
      if (form) {
        const btn = document.getElementById('submit-btn') as HTMLButtonElement;
        const errorEl = document.getElementById('error-message')!;
        const tokenEl = document.getElementById('token') as HTMLInputElement;

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          errorEl.classList.add('hidden');

          const password = (form.querySelector('#password') as HTMLInputElement).value;
          const confirm = (form.querySelector('#confirm') as HTMLInputElement).value;
          if (password !== confirm) {
            errorEl.textContent = 'Passwords do not match.';
            errorEl.classList.remove('hidden');
            return;
          }

          btn.disabled = true;
          btn.textContent = 'Setting...';

          try {
            const res = await fetch('/portal/auth/reset-password', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ token: tokenEl.value, password }),
            });
            const data = await res.json();

            if (res.ok) {
              // setPassword revoked all sessions; send the user to login to
              // sign in with the new password.
              window.location.href = '/portal/login?passwordReset=1';
            } else {
              errorEl.textContent = data.error || 'Could not reset your password.';
              errorEl.classList.remove('hidden');
              btn.disabled = false;
              btn.textContent = 'Set new password';
            }
          } catch {
            errorEl.textContent = 'Connection error. Try again.';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Set new password';
          }
        });
      }
    </script>
  </body>
</html>
