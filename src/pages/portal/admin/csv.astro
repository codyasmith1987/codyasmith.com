---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
import { getRecentUploads } from '../../../lib/csv/index';
export const prerender = false;

const clients = await getAllClients();
const uploads = await getRecentUploads(undefined, 30);

function formatLabel(format: string): string {
  return format.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
}
---

<Portal title="CSV Upload">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">CSV Upload</h1>
      <p class="text-sm text-neutral-500 mt-3 leading-relaxed">Drop CSVs from Ubersuggest, Screaming Frog, and other tools. Format is auto-detected.</p>
    </div>

    <!-- Upload form -->
    <form id="csv-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Client</label>
          <select id="csv-client" required class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
            <option value="">Select...</option>
            {clients.map(c => <option value={c.id}>{c.name}</option>)}
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Month</label>
          <input type="month" id="csv-month" required
            value={new Date().toISOString().slice(0, 7)}
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">CSV files</label>
          <input type="file" id="csv-files" accept=".csv" multiple required
            class="w-full text-sm text-neutral-500 file:mr-3 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-500 file:text-neutral-950 hover:file:bg-amber-400 file:cursor-pointer file:transition-colors file:duration-300" />
        </div>
      </div>
      <div class="mt-6 flex items-center gap-5">
        <button type="submit" id="csv-btn" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)] disabled:opacity-50 disabled:hover:shadow-none">
          Upload & Process
        </button>
        <span id="csv-progress" class="text-sm text-neutral-600 hidden"></span>
      </div>
    </form>

    <!-- Upload results (populated by JS) -->
    <div id="csv-results" class="space-y-3 mb-10 hidden"></div>

    <!-- Manual metric entry -->
    <details class="mb-10 group">
      <summary class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase cursor-pointer hover:text-amber-400 transition-colors duration-300">Manual metric entry</summary>
      <form id="manual-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-6 mt-4">
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
          <select id="m-client" required class="px-3 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
            <option value="">Client</option>
            {clients.map(c => <option value={c.id}>{c.name}</option>)}
          </select>
          <input type="month" id="m-month" required value={new Date().toISOString().slice(0, 7)}
            class="px-3 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
          <input type="text" id="m-category" required placeholder="Category"
            class="px-3 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm placeholder-neutral-700 focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
          <input type="text" id="m-key" required placeholder="Metric key"
            class="px-3 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm placeholder-neutral-700 focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
          <div class="flex gap-2">
            <input type="number" id="m-value" required step="any" placeholder="Value"
              class="flex-1 px-3 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm placeholder-neutral-700 focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
            <button type="submit" class="px-4 py-2.5 bg-amber-500 text-neutral-950 text-sm font-semibold rounded-lg hover:bg-amber-400 transition-all duration-300">Save</button>
          </div>
        </div>
        <p id="m-msg" class="mt-3 text-sm hidden"></p>
      </form>
    </details>

    <!-- Recent uploads -->
    {uploads.length > 0 && (
      <div>
        <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-4">Recent uploads</p>
        <div class="space-y-2">
          {uploads.map(u => (
            <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-center justify-between hover:border-white/10 transition-all duration-300">
              <div>
                <p class="text-sm font-medium text-neutral-200">{u.original_name}</p>
                <div class="flex items-center gap-3 mt-1">
                  <span class="text-xs text-neutral-600">{u.client_name}</span>
                  <span class="text-xs font-mono text-neutral-700">{u.month}</span>
                  <span class:list={[
                    'text-[10px] font-mono tracking-wide px-2.5 py-0.5 rounded-full',
                    u.error ? 'bg-red-500/10 text-red-400' : 'bg-emerald-500/10 text-emerald-400',
                  ]}>
                    {u.error ? 'Error' : formatLabel(u.detected_format)}
                  </span>
                </div>
              </div>
              <span class="text-xs font-mono text-neutral-700">{u.row_count} rows</span>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const form = document.getElementById('csv-form') as HTMLFormElement;
    const btn = document.getElementById('csv-btn') as HTMLButtonElement;
    const progress = document.getElementById('csv-progress')!;
    const resultsDiv = document.getElementById('csv-results')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true;
      resultsDiv.innerHTML = '';
      resultsDiv.classList.remove('hidden');

      const files = (document.getElementById('csv-files') as HTMLInputElement).files!;
      const clientId = (document.getElementById('csv-client') as HTMLSelectElement).value;
      const month = (document.getElementById('csv-month') as HTMLInputElement).value;

      progress.classList.remove('hidden');

      for (let i = 0; i < files.length; i++) {
        const file = files[i];
        progress.textContent = `Processing ${i + 1}/${files.length}: ${file.name}...`;

        const formData = new FormData();
        formData.append('file', file);
        formData.append('client_id', clientId);
        formData.append('month', month);

        try {
          const res = await fetch('/portal/api/csv/upload', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken }, body: formData });
          const data = await res.json();

          const card = document.createElement('div');
          card.className = `csv-result bg-neutral-900/30 border rounded-xl p-5 ${data.error ? 'border-red-500/15' : 'border-emerald-500/15'}`;
          card.style.animationDelay = `${i * 0.1}s`;
          card.innerHTML = `
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm font-medium text-neutral-200">${file.name}</p>
                <p class="text-xs text-neutral-600 mt-1">
                  ${data.format !== 'unknown' ? `Detected: <span class="text-emerald-400">${data.format.replace(/_/g, ' ')}</span>` : ''}
                  ${data.row_count ? ` — ${data.row_count} rows processed` : ''}
                </p>
              </div>
              ${data.error ? `<span class="text-xs text-red-400">${data.error}</span>` : '<span class="text-[10px] font-mono text-emerald-400 tracking-wide uppercase">Done</span>'}
            </div>
          `;
          resultsDiv.appendChild(card);
        } catch (err: any) {
          const card = document.createElement('div');
          card.className = 'csv-result bg-neutral-900/30 border border-red-500/15 rounded-xl p-5';
          card.style.animationDelay = `${i * 0.1}s`;
          card.innerHTML = `<p class="text-sm text-red-400">${file.name}: ${err.message}</p>`;
          resultsDiv.appendChild(card);
        }
      }

      progress.textContent = `Done — ${files.length} file(s) processed`;
      btn.disabled = false;
    });

    // Manual metric form
    const mForm = document.getElementById('manual-form') as HTMLFormElement;
    const mMsg = document.getElementById('m-msg')!;

    mForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      mMsg.classList.add('hidden');

      const res = await fetch('/portal/api/metrics/manual', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          client_id: (document.getElementById('m-client') as HTMLSelectElement).value,
          month: (document.getElementById('m-month') as HTMLInputElement).value,
          category: (document.getElementById('m-category') as HTMLInputElement).value,
          metric_key: (document.getElementById('m-key') as HTMLInputElement).value,
          metric_value: (document.getElementById('m-value') as HTMLInputElement).value,
        }),
      });

      if (res.ok) {
        mMsg.textContent = 'Saved';
        mMsg.className = 'mt-3 text-sm text-emerald-400';
      } else {
        const data = await res.json();
        mMsg.textContent = data.error || 'Failed';
        mMsg.className = 'mt-3 text-sm text-red-400';
      }
      mMsg.classList.remove('hidden');
    });
  </script>
</Portal>
