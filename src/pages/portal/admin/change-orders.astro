---
import Portal from '../../../layouts/Portal.astro';
import { getChangeOrdersByContract } from '../../../lib/invoices';
import { getAllContracts, getContract } from '../../../lib/contracts';
export const prerender = false;

const contractId = Astro.url.searchParams.get('contract');
const contracts = await getAllContracts();

let changeOrders: any[] = [];
let selectedContract: any = null;
if (contractId) {
  selectedContract = await getContract(contractId);
  changeOrders = await getChangeOrdersByContract(contractId);
}

const statusColors: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  submitted: 'bg-blue-500/10 text-blue-400',
  approved: 'bg-emerald-500/10 text-emerald-400',
  rejected: 'bg-red-500/10 text-red-400',
};
---

<Portal title="Change Orders">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Change Orders</h1>
    </div>

    <form method="GET" class="mb-8">
      <select name="contract" onchange="this.form.submit()" class="px-4 py-2.5 bg-neutral-900/50 border border-white/5 rounded-lg text-sm text-neutral-300 focus:outline-none focus:border-amber-500/30">
        <option value="">Select contract...</option>
        {contracts.map(c => (
          <option value={c.id} selected={c.id === contractId}>{c.title}</option>
        ))}
      </select>
    </form>

    {!contractId ? (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">Select a contract</p>
        <p class="text-sm text-neutral-300">Choose a contract above to view its change orders.</p>
      </div>
    ) : (
      <>
        <div class="flex items-center justify-between mb-6">
          <p class="text-sm text-neutral-300">{selectedContract?.title}</p>
          <button id="show-create-co" class="px-5 py-2.5 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">New change order</button>
        </div>

        <form id="create-co-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-8 hidden">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="sm:col-span-2">
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Title</label>
              <input type="text" id="co-title" required class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" placeholder="Add blog section" />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Cost impact ($)</label>
              <input type="number" id="co-cost" step="0.01" value="0" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            </div>
            <div>
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Time impact (days)</label>
              <input type="number" id="co-days" value="0" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
            </div>
            <div class="sm:col-span-2">
              <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Description</label>
              <textarea id="co-desc" rows="3" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" placeholder="Scope change details..."></textarea>
            </div>
          </div>
          <div class="flex gap-3 mt-6">
            <button type="submit" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all">Create</button>
            <button type="button" id="cancel-create-co" class="text-sm text-neutral-300 hover:text-neutral-300">Cancel</button>
          </div>
        </form>

        {changeOrders.length > 0 ? (
          <div class="space-y-3">
            {changeOrders.map(co => (
              <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5" data-co-id={co.id}>
                <div class="flex items-start justify-between">
                  <div>
                    <p class="text-sm font-medium text-neutral-200">{co.title}</p>
                    {co.description && <p class="text-xs text-neutral-300 mt-2">{co.description}</p>}
                    <div class="flex items-center gap-4 mt-2 text-xs text-neutral-400">
                      <span>Cost: ${co.cost_impact.toFixed(2)}</span>
                      <span>Time: +{co.time_impact_days} days</span>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[co.status] || ''}`}>{co.status}</span>
                    {co.status !== 'approved' && (
                      <button data-approve-co={co.id} class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">Approve</button>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-16">
            <p class="font-serif text-xl text-neutral-100 mb-2">No change orders</p>
            <p class="text-sm text-neutral-300">Create one above if the scope has changed.</p>
          </div>
        )}
      </>
    )}
  </div>

  <script define:vars={{ contractId }}>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    const coForm = document.getElementById('create-co-form');
    document.getElementById('show-create-co')?.addEventListener('click', () => coForm?.classList.remove('hidden'));
    document.getElementById('cancel-create-co')?.addEventListener('click', () => coForm?.classList.add('hidden'));

    coForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const res = await fetch('/portal/api/admin/change-orders/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          contract_id: contractId,
          title: document.getElementById('co-title').value.trim(),
          description: document.getElementById('co-desc').value.trim() || undefined,
          cost_impact: Number(document.getElementById('co-cost').value),
          time_impact_days: Number(document.getElementById('co-days').value),
        }),
      });
      if (res.ok) {
        window.__toast({ type: 'success', message: 'Change order created' });
        setTimeout(() => location.reload(), 600);
      } else window.__toast({ type: 'error', message: 'Failed to create' });
    });

    document.querySelectorAll('[data-approve-co]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const coId = btn.dataset.approveCo;
        const res = await fetch(`/portal/api/admin/change-orders/${coId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ action: 'approve' }),
        });
        if (res.ok) {
          window.__toast({ type: 'success', message: 'Change order approved' });
          setTimeout(() => location.reload(), 600);
        } else {
          const err = await res.json().catch(() => ({}));
          window.__toast({ type: 'error', message: err.error || 'Failed to approve' });
        }
      });
    });
  </script>
</Portal>
