---
import Base from '../../../layouts/Base.astro';
import { getAllTags, getEntriesByTag, formatDate, tagSlug } from '../../../lib/blog';

export const prerender = true;

export async function getStaticPaths() {
  const tags = await getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag: tagSlug(tag) },
    props: { tagLabel: tag },
  }));
}

const { tag: tagParam } = Astro.params;
const { tagLabel } = Astro.props;
const entries = await getEntriesByTag(tagParam);

const breadcrumbs = [
  { name: 'Home', url: 'https://codyasmith.com/' },
  { name: 'Blog', url: 'https://codyasmith.com/blog' },
  { name: tagLabel, url: `https://codyasmith.com/blog/tags/${tagParam}` },
];

const itemListJsonLd = entries.length > 0 ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: entries.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `https://codyasmith.com${e.href}`,
    name: e.data.title,
  })),
}) : null;
---

<Base
  title={`${tagLabel} | Blog | Cody Smith`}
  description={`Articles and case studies tagged ${tagLabel}.`}
  breadcrumbs={breadcrumbs}
>
  {itemListJsonLd && (
    <script type="application/ld+json" set:html={itemListJsonLd} />
  )}

  <section class="pt-40 pb-12 px-6">
    <div class="max-w-4xl mx-auto">
      <p class="font-mono text-[11px] tracking-[0.25em] uppercase text-amber-400 mb-8">
        <a href="/blog" class="hover:text-amber-300">Blog</a>
        <span class="text-neutral-700 mx-2">/</span>
        <span class="text-neutral-400">Tagged</span>
      </p>
      <h1 class="font-serif text-5xl md:text-6xl leading-[1.05] text-neutral-100 tracking-tight">
        {tagLabel}.
      </h1>
      <p class="mt-6 text-sm text-neutral-500 font-mono tracking-[0.15em] uppercase">
        {entries.length} {entries.length === 1 ? 'entry' : 'entries'}
      </p>
    </div>
  </section>

  <section class="px-6 py-16">
    <div class="max-w-4xl mx-auto">
      <ul class="divide-y divide-white/5">
        {entries.map((e) => (
          <li>
            <a href={e.href} class="group block py-6 md:py-8 md:grid md:grid-cols-[10rem_1fr] md:gap-8">
              <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-neutral-500 mb-2 md:mb-0 md:mt-1 flex md:block items-center gap-3">
                <span class="text-amber-400/80">{e.kind === 'case-study' ? 'Case study' : 'Article'}</span>
                <span class="md:hidden text-neutral-700">&middot;</span>
                <time datetime={e.data.publishDate.toISOString()} class="md:block md:mt-1">{formatDate(e.data.publishDate)}</time>
              </div>
              <div>
                <h2 class="font-serif text-2xl md:text-[1.7rem] text-neutral-100 leading-tight group-hover:text-amber-400 transition-colors">
                  {e.data.title}
                </h2>
                <p class="text-neutral-400 mt-2 leading-relaxed">{e.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="px-6 py-12 border-t border-white/5">
    <div class="max-w-4xl mx-auto">
      <a href="/blog" class="inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.2em] uppercase text-neutral-500 hover:text-amber-400 transition-colors">
        <span aria-hidden="true">&larr;</span> Back to blog
      </a>
    </div>
  </section>
</Base>
