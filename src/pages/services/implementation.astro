---
import Base from '../../layouts/Base.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do you scope a project?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You describe the problem. I write a scope document listing every deliverable, integration point, testing criteria, and exclusion. Then I quote a fixed price against that scope. Nothing ambiguous. You know what you're getting and what it costs before you sign anything."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if scope changes mid-build?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Change orders get quoted separately before any additional work begins. I don't surprise you with a bigger invoice at the end. If you want to add something or pivot, we talk about it, I quote it, you approve, and then I build it. The original scope stays the original scope."
      }
    },
    {
      "@type": "Question",
      "name": "How long does a typical project take?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most projects scope in one to two weeks and deliver in two to four. Bigger builds run longer. The scope document includes the timeline so there's no guessing. If something is going to slip, you hear about it before the deadline, not after."
      }
    },
    {
      "@type": "Question",
      "name": "What happens after delivery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You get written handoff documentation covering configuration, credentials, and maintenance procedures. There's a short warranty window where I fix anything that breaks because of how it was built. After that, ongoing support is either a separate retainer or you handle it in-house. Your call."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with our existing systems or replace them?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Almost always I work with what you have. Most clients already have a CRM, an email tool, an analytics setup. They're just not connected to each other or configured correctly. Replacing a working system is usually the wrong move. I'll tell you when it isn't."
      }
    },
    {
      "@type": "Question",
      "name": "Do you fix things or only build new things?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Both. A lot of implementation work is fixing what's already there. Form submissions disappearing into a folder nobody checks. Analytics that's installed but not configured. Integrations that broke six months ago and nobody noticed. If it's a scoped project, I can take it on."
      }
    }
  ]
});

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Implementation",
  "url": "https://codyasmith.com/services/implementation",
  "description": "CRM integrations, page builds, analytics setup. Scoped projects with a start and a finish.",
  "provider": { "@id": "https://codyasmith.com/#organization" },
  "serviceType": "Implementation",
  "areaServed": { "@type": "Country", "name": "United States" },
  "termsOfService": "Fixed-price quotes against a written scope document. Payment at signing. Change orders quoted separately before execution. Production deployment with handoff documentation.",
  "offers": [
    {
      "@type": "Offer",
      "name": "Implementation work",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": 125,
        "priceCurrency": "USD",
        "unitText": "hour",
        "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "hour" }
      }
    },
    {
      "@type": "Offer",
      "name": "Advisory work",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": 150,
        "priceCurrency": "USD",
        "unitText": "hour",
        "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "hour" }
      }
    },
    {
      "@type": "Offer",
      "name": "Rush implementation",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": 187.50,
        "priceCurrency": "USD",
        "unitText": "hour",
        "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "hour" }
      }
    },
    {
      "@type": "Offer",
      "name": "Emergency implementation",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "price": 250,
        "priceCurrency": "USD",
        "unitText": "hour",
        "referenceQuantity": { "@type": "QuantitativeValue", "value": 1, "unitText": "hour" }
      }
    }
  ]
});
---

<Base title="Implementation | CRM Integrations, Page Builds & Analytics" description="CRM integrations, page builds, analytics setup. Scoped projects with a start and a finish." ogImage="/og/services/implementation.png" ogImageAlt="Implementation: scoped projects. Start, build, hand over.">
  <script type="application/ld+json" set:html={faqSchema} />
