</div>

<script is:inline>
(function() {
  var TIERS = {
    good:   { name: 'Good',   monthly: 1031.60, oneTime: 7925 },
    better: { name: 'Better', monthly: 1891.60, oneTime: 8925 },
    best:   { name: 'Best',   monthly: 2661.60, oneTime: 10625 }
  };
  var ADDON_MONTHLY = { good: 237.60, better: 397.60, best: 517.60 };
  var ADDON_ONETIME = 4500;

  var state = { tier: null, addOn: null };

  function money(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function moneyInt(n) {
    return '$' + n.toLocaleString('en-US');
  }

  function update() {
    var tierCards = document.querySelectorAll('[data-tier]');
    for (var i = 0; i < tierCards.length; i++) {
      var t = tierCards[i].getAttribute('data-tier');
      tierCards[i].classList.toggle('selected', t === state.tier);
    }

    var addonChoice = document.getElementById('addon-choice');
    var tierPrompt = document.getElementById('tier-prompt');
    if (state.tier) {
      if (addonChoice) addonChoice.classList.add('revealed');
      if (tierPrompt) tierPrompt.style.display = 'none';
      var mo = ADDON_MONTHLY[state.tier];
      var display = document.getElementById('addon-monthly-display');
      if (display) display.textContent = money(mo);
    } else {
      if (addonChoice) addonChoice.classList.remove('revealed');
      if (tierPrompt) tierPrompt.style.display = '';
    }

    var addonCards = document.querySelectorAll('[data-addon]');
    for (var j = 0; j < addonCards.length; j++) {
      var a = addonCards[j].getAttribute('data-addon');
      addonCards[j].classList.toggle('selected', a === state.addOn);
    }

    var sumTier = document.getElementById('summary-tier');
    var sumAddon = document.getElementById('summary-addon');
    var sumOnetime = document.getElementById('summary-onetime');
    var sumMonthly = document.getElementById('summary-monthly');

    if (state.tier) {
      sumTier.textContent = TIERS[state.tier].name;
      sumTier.classList.add('selected');
    } else {
      sumTier.textContent = 'Pick above';
      sumTier.classList.remove('selected');
    }
    if (state.addOn === 'yes') {
      sumAddon.textContent = 'Yes, add the micro-site';
      sumAddon.classList.add('selected');
    } else if (state.addOn === 'no') {
      sumAddon.textContent = 'No, single unified site';
      sumAddon.classList.add('selected');
    } else {
      sumAddon.textContent = 'Pick above';
      sumAddon.classList.remove('selected');
    }

    if (state.tier && state.addOn) {
      var tierData = TIERS[state.tier];
      var monthly = tierData.monthly + (state.addOn === 'yes' ? ADDON_MONTHLY[state.tier] : 0);
      var oneTime = tierData.oneTime + (state.addOn === 'yes' ? ADDON_ONETIME : 0);
      sumOnetime.textContent = moneyInt(oneTime);
      sumMonthly.textContent = money(monthly) + ' / month';
    } else {
      sumOnetime.textContent = '—';
      sumMonthly.textContent = '—';
    }

    var jasonInput = document.getElementById('jason-name');
    var kevinInput = document.getElementById('kevin-name');
    var jasonName = jasonInput ? jasonInput.value.trim() : '';
    var kevinName = kevinInput ? kevinInput.value.trim() : '';
    var sendBtn = document.getElementById('send-proposal');
    var canSend = !!(state.tier && state.addOn && jasonName && kevinName);
    if (sendBtn) sendBtn.disabled = !canSend;
  }

  var tierCards = document.querySelectorAll('[data-tier]');
  for (var i = 0; i < tierCards.length; i++) {
    (function(card) {
      card.addEventListener('click', function() {
        state.tier = card.getAttribute('data-tier');
        update();
        if (state.addOn === null) {
          var target = document.getElementById('addon-choice');
          if (target) setTimeout(function() { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 120);
        }
      });
    })(tierCards[i]);
  }

  var addonCards = document.querySelectorAll('[data-addon]');
  for (var k = 0; k < addonCards.length; k++) {
    (function(card) {
      card.addEventListener('click', function() {
        state.addOn = card.getAttribute('data-addon');
        update();
        if (state.tier) {
          var target = document.getElementById('proposal-form-container');
          if (target) setTimeout(function() { target.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 120);
        }
      });
    })(addonCards[k]);
  }

  var inputIds = ['jason-name', 'kevin-name'];
  for (var n = 0; n < inputIds.length; n++) {
    var el = document.getElementById(inputIds[n]);
    if (el) el.addEventListener('input', update);
  }

  var sendBtn = document.getElementById('send-proposal');
  if (sendBtn) {
    sendBtn.addEventListener('click', function() {
      sendBtn.disabled = true;
      sendBtn.textContent = 'Sending...';
      var csrf = document.querySelector('meta[name="csrf-token"]');
      var csrfToken = csrf ? csrf.getAttribute('content') : '';
      var jasonName = document.getElementById('jason-name').value.trim();
      var kevinName = document.getElementById('kevin-name').value.trim();
      fetch('/portal/api/proposals/raised-bar/accept', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken || '' },
        body: JSON.stringify({
          tier: state.tier,
          add_on: state.addOn,
          jason_name: jasonName,
          kevin_name: kevinName
        })
      }).then(function(res) {
        return res.json().then(function(data) { return { ok: res.ok, data: data }; });
      }).then(function(result) {
        if (result.ok) {
          var container = document.getElementById('proposal-form-container');
          var emails = (result.data && result.data.confirmation_emails) || 'you both';
          container.innerHTML =
            '<div class="success-message">' +
              '<h3>Got it. Engagement accepted.</h3>' +
              '<p>I will send the formal contracts and the first invoice in the next few days. Reach me at <a href="mailto:cody@codyasmith.com">cody@codyasmith.com</a> or call or text any time with questions.</p>' +
              '<p class="success-note">Confirmation sent to ' + emails + '.</p>' +
            '</div>';
          window.scrollTo({ top: container.offsetTop - 32, behavior: 'smooth' });
        } else {
          sendBtn.disabled = false;
          sendBtn.textContent = 'Send to Cody';
          var msg = (result.data && result.data.error) || 'Send failed. Email cody@codyasmith.com directly if this keeps happening.';
          alert(msg);
        }
      }).catch(function() {
        sendBtn.disabled = false;
        sendBtn.textContent = 'Send to Cody';
        alert('Connection error. Try again or email cody@codyasmith.com.');
      });
    });
  }

  update();
})();
</script>
</body>
</html>
