---
import Portal from '../../../layouts/Portal.astro';
import { getAllUsers, getAllClients } from '../../../lib/auth';
export const prerender = false;

const users = await getAllUsers();
const clients = await getAllClients();
---

<Portal title="Manage Users">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-semibold text-neutral-100">Users</h1>
    </div>

    <!-- Create user form -->
    <form id="create-user-form" class="bg-neutral-900/50 border border-white/5 rounded-xl p-6 mb-8">
      <h2 class="text-sm font-medium text-neutral-300 mb-4">Invite new user</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="user-name" class="block text-xs text-neutral-500 mb-1">Full name</label>
          <input
            type="text"
            id="user-name"
            name="name"
            required
            class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40"
            placeholder="Sven Johnson"
          />
        </div>
        <div>
          <label for="user-email" class="block text-xs text-neutral-500 mb-1">Email</label>
          <input
            type="email"
            id="user-email"
            name="email"
            required
            class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40"
            placeholder="sven@zipkithomes.com"
          />
        </div>
        <div>
          <label for="user-role" class="block text-xs text-neutral-500 mb-1">Role</label>
          <select id="user-role" name="role" class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40">
            <option value="client">Client</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label for="user-client" class="block text-xs text-neutral-500 mb-1">Client (for client role)</label>
          <select id="user-client" name="client_id" class="w-full px-3 py-2 bg-neutral-900 border border-white/10 rounded-lg text-neutral-100 text-sm focus:outline-none focus:border-amber-500/40">
            <option value="">— None —</option>
            {clients.map(c => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="mt-4 flex items-center gap-4">
        <button type="submit" class="px-4 py-2 bg-amber-500 text-neutral-950 font-medium text-sm rounded-lg hover:bg-amber-400 transition-colors">
          Create & send invite
        </button>
        <label class="flex items-center gap-2 text-xs text-neutral-500">
          <input type="checkbox" id="send-invite" checked class="rounded border-white/10 bg-neutral-900" />
          Send magic link email
        </label>
      </div>
      <p id="user-msg" class="mt-3 text-sm hidden"></p>
    </form>

    <!-- User list -->
    {users.length > 0 ? (
      <div class="space-y-3">
        {users.map(u => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-lg p-4 flex items-center justify-between group" data-user-row={u.id}>
            <div>
              <p class="text-sm font-medium text-neutral-200">{u.name}</p>
              <p class="text-xs text-neutral-500">{u.email}</p>
              {u.client_name && <p class="text-xs text-neutral-600 mt-0.5">{u.client_name}</p>}
            </div>
            <div class="flex items-center gap-3">
              <span class:list={[
                'text-xs px-2 py-0.5 rounded-full',
                u.role === 'admin' ? 'bg-amber-500/10 text-amber-400' : 'bg-neutral-700/50 text-neutral-400',
              ]}>
                {u.role}
              </span>
              {u.last_login_at && (
                <span class="text-xs text-neutral-600">
                  Last login: {new Date(u.last_login_at).toLocaleDateString()}
                </span>
              )}
              <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                <button
                  data-revoke-user={u.id}
                  class="text-xs text-neutral-500 hover:text-amber-400 transition-colors"
                  title="Force logout"
                >
                  Revoke sessions
                </button>
                <button
                  data-delete-user={u.id}
                  data-user-name={u.name}
                  class="text-xs text-neutral-500 hover:text-red-400 transition-colors"
                  title="Delete user"
                >
                  Delete
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-neutral-500">No users yet. Create one above.</p>
    )}
  </div>

  <script>
    // Revoke sessions
    document.querySelectorAll('[data-revoke-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.revokeUser!;
        const res = await fetch('/portal/api/admin/revoke-sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: userId }),
        });
        if (res.ok) {
          const data = await res.json();
          (btn as HTMLElement).textContent = `Revoked (${data.sessions_revoked})`;
          (btn as HTMLElement).classList.add('text-amber-400');
          setTimeout(() => {
            (btn as HTMLElement).textContent = 'Revoke sessions';
            (btn as HTMLElement).classList.remove('text-amber-400');
          }, 2000);
        }
      });
    });

    // Delete user
    document.querySelectorAll('[data-delete-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.deleteUser!;
        const userName = (btn as HTMLElement).dataset.userName!;
        if (!confirm(`Delete ${userName}? This will also revoke all their sessions.`)) return;

        const res = await fetch('/portal/api/admin/delete-user', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ user_id: userId }),
        });
        if (res.ok) {
          const row = document.querySelector(`[data-user-row="${userId}"]`);
          if (row) row.remove();
        } else {
          const data = await res.json();
          alert(data.error || 'Failed to delete user');
        }
      });
    });

    const form = document.getElementById('create-user-form') as HTMLFormElement;
    const msg = document.getElementById('user-msg')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const name = (document.getElementById('user-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('user-email') as HTMLInputElement).value.trim();
      const role = (document.getElementById('user-role') as HTMLSelectElement).value;
      const client_id = (document.getElementById('user-client') as HTMLSelectElement).value || null;
      const send_invite = (document.getElementById('send-invite') as HTMLInputElement).checked;

      const res = await fetch('/portal/api/admin/create-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, role, client_id, send_invite }),
      });

      const data = await res.json();
      if (res.ok) {
        msg.textContent = data.invite_sent
          ? `Created "${name}" — invite sent to ${email}`
          : `Created "${name}" — no invite sent`;
        msg.className = 'mt-3 text-sm text-emerald-400';
        msg.classList.remove('hidden');
        form.reset();
        setTimeout(() => location.reload(), 1000);
      } else {
        msg.textContent = data.error || 'Failed';
        msg.className = 'mt-3 text-sm text-red-400';
        msg.classList.remove('hidden');
      }
    });
  </script>
</Portal>
