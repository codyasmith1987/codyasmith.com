---
import Portal from '../../../layouts/Portal.astro';
import { getAllUsers, getAllClients } from '../../../lib/auth';
export const prerender = false;

const users = await getAllUsers();
const clients = await getAllClients();
---

<Portal title="Manage Users">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Users</h1>
    </div>

    <!-- Create user form -->
    <form id="create-user-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
      <p class="text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-5">Invite new user</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="user-name" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Full name</label>
          <input
            type="text"
            id="user-name"
            name="name"
            required
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="Sven Johnson"
          />
        </div>
        <div>
          <label for="user-email" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Email</label>
          <input
            type="email"
            id="user-email"
            name="email"
            required
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="sven@zipkithomes.com"
          />
        </div>
        <div>
          <label for="user-role" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Role</label>
          <select id="user-role" name="role" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
            <option value="client">Client</option>
            <option value="admin">Admin</option>
          </select>
        </div>
        <div>
          <label for="user-client" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Client (for client role)</label>
          <select id="user-client" name="client_id" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
            <option value="">— None —</option>
            {clients.map(c => (
              <option value={c.id}>{c.name}</option>
            ))}
          </select>
        </div>
      </div>
      <div class="mt-6 flex items-center gap-5">
        <button type="submit" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]">
          Create & send invite
        </button>
        <label class="flex items-center gap-2 text-xs text-neutral-400 cursor-pointer">
          <input type="checkbox" id="send-invite" checked class="rounded border-white/10 bg-neutral-900 accent-amber-500" />
          Send magic link email
        </label>
      </div>
      <p id="user-msg" class="mt-4 text-sm hidden"></p>
    </form>

    <!-- User list -->
    {users.length > 0 ? (
      <div class="space-y-3">
        {users.map(u => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-center justify-between group hover:border-white/10 transition-all duration-300" data-user-row={u.id}>
            <div>
              <p class="text-sm font-medium text-neutral-200">{u.name}</p>
              <p class="text-xs text-neutral-400">{u.email}</p>
              {u.client_name && <p class="text-xs text-neutral-400 mt-0.5">{u.client_name}</p>}
            </div>
            <div class="flex items-center gap-4">
              <span class:list={[
                'text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full',
                u.role === 'admin' ? 'bg-amber-500/10 text-amber-400' : 'bg-neutral-800 text-neutral-300',
              ]}>
                {u.role}
              </span>
              {u.last_login_at && (
                <span class="text-[10px] text-neutral-400">
                  {new Date(u.last_login_at).toLocaleDateString()}
                </span>
              )}
              <div class="flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <button
                  data-resend-user={u.id}
                  data-user-name={u.name}
                  class="text-xs text-neutral-400 hover:text-amber-400 transition-colors duration-300"
                >
                  Resend invite
                </button>
                <button
                  data-revoke-user={u.id}
                  class="text-xs text-neutral-400 hover:text-amber-400 transition-colors duration-300"
                >
                  Revoke sessions
                </button>
                <button
                  data-delete-user={u.id}
                  data-user-name={u.name}
                  class="text-xs text-neutral-400 hover:text-red-400 transition-colors duration-300"
                >
                  Delete
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No users yet</p>
        <p class="text-sm text-neutral-300">Invite your first user above.</p>
      </div>
    )}
  </div>

  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    // Resend invite
    document.querySelectorAll('[data-resend-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.resendUser!;
        const userName = (btn as HTMLElement).dataset.userName!;
        const original = (btn as HTMLElement).textContent;
        (btn as HTMLElement).textContent = 'Sending...';
        (btn as HTMLButtonElement).disabled = true;
        try {
          const res = await fetch('/portal/api/admin/resend-invite', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ user_id: userId }),
          });
          const data = await res.json();
          if (res.ok) {
            (btn as HTMLElement).textContent = data.invite_sent ? 'Sent ✓' : 'Link logged';
            (btn as HTMLElement).classList.add('text-emerald-400');
            (window as any).__toast(data.invite_sent ? `Invite sent to ${userName}` : 'Brevo not configured; link logged to server', data.invite_sent ? 'success' : 'info');
          } else {
            (btn as HTMLElement).textContent = 'Failed';
            (btn as HTMLElement).classList.add('text-red-400');
            (window as any).__toast(data.error || 'Failed to resend invite', 'error');
          }
        } catch {
          (btn as HTMLElement).textContent = 'Failed';
          (btn as HTMLElement).classList.add('text-red-400');
          (window as any).__toast('Connection error', 'error');
        }
        setTimeout(() => {
          (btn as HTMLElement).textContent = original;
          (btn as HTMLElement).classList.remove('text-emerald-400', 'text-red-400');
          (btn as HTMLButtonElement).disabled = false;
        }, 3000);
      });
    });

    // Revoke sessions
    document.querySelectorAll('[data-revoke-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.revokeUser!;
        const res = await fetch('/portal/api/admin/revoke-sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ user_id: userId }),
        });
        if (res.ok) {
          const data = await res.json();
          (btn as HTMLElement).textContent = `Revoked (${data.sessions_revoked})`;
          (btn as HTMLElement).classList.add('text-amber-400');
          setTimeout(() => {
            (btn as HTMLElement).textContent = 'Revoke sessions';
            (btn as HTMLElement).classList.remove('text-amber-400');
          }, 2000);
        }
      });
    });

    // Delete user
    document.querySelectorAll('[data-delete-user]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const userId = (btn as HTMLElement).dataset.deleteUser!;
        const userName = (btn as HTMLElement).dataset.userName!;
        const confirmed = await (window as any).__confirm({
          title: `Delete ${userName}`,
          message: 'This will permanently delete the user and revoke all their sessions.',
          confirmLabel: 'Delete user',
          danger: true,
        });
        if (!confirmed) return;

        const res = await fetch('/portal/api/admin/delete-user', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ user_id: userId }),
        });
        if (res.ok) {
          const row = document.querySelector(`[data-user-row="${userId}"]`) as HTMLElement;
          if (row) {
            row.style.opacity = '0';
            row.style.transform = 'translateY(-8px)';
            row.style.transition = 'all 0.3s ease';
            setTimeout(() => row.remove(), 300);
          }
        } else {
          const data = await res.json();
          (window as any).__toast(data.error || 'Failed to delete user', 'error');
        }
      });
    });

    const form = document.getElementById('create-user-form') as HTMLFormElement;
    const msg = document.getElementById('user-msg')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const name = (document.getElementById('user-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('user-email') as HTMLInputElement).value.trim();
      const role = (document.getElementById('user-role') as HTMLSelectElement).value;
      const client_id = (document.getElementById('user-client') as HTMLSelectElement).value || null;
      const send_invite = (document.getElementById('send-invite') as HTMLInputElement).checked;

      const res = await fetch('/portal/api/admin/create-user', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({ name, email, role, client_id, send_invite }),
      });

      const data = await res.json();
      if (res.ok) {
        msg.textContent = data.invite_sent
          ? `Created "${name}". Invite sent to ${email}.`
          : `Created "${name}". No invite sent.`;
        msg.className = 'mt-4 text-sm text-emerald-400';
        msg.classList.remove('hidden');
        form.reset();
        setTimeout(() => location.reload(), 1000);
      } else {
        msg.textContent = data.error || 'Failed';
        msg.className = 'mt-4 text-sm text-red-400';
        msg.classList.remove('hidden');
      }
    });
  </script>
</Portal>
