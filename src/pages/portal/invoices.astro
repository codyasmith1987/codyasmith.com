---
import Portal from '../../layouts/Portal.astro';
import { getClientVisibleInvoices, getInvoiceItems, getPaymentsByInvoice } from '../../lib/invoices';
export const prerender = false;

const user = Astro.locals.user!;
if (!user.client_id) return Astro.redirect('/portal/dashboard');

const invoices = await getClientVisibleInvoices(user.client_id);

// Enrich with items and payments
const enriched = await Promise.all(invoices.map(async (inv) => {
  const items = await getInvoiceItems(inv.id);
  const payments = await getPaymentsByInvoice(inv.id);
  return {
    ...inv,
    items: items.map(i => ({ description: i.description, quantity: i.quantity, unit_price: i.unit_price, amount: i.amount })),
    payments: payments.map(p => ({ amount: p.amount, paid_at: p.paid_at, payment_method: p.payment_method })),
  };
}));

const statusLabels: Record<string, string> = {
  draft: 'Draft',
  sent: 'Awaiting payment',
  paid: 'Paid',
  partial: 'Partially paid',
  overdue: 'Overdue',
  cancelled: 'Cancelled',
};

const statusColors: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  sent: 'bg-blue-500/10 text-blue-400',
  paid: 'bg-emerald-500/10 text-emerald-400',
  partial: 'bg-amber-500/10 text-amber-400',
  overdue: 'bg-red-500/10 text-red-400',
  cancelled: 'bg-neutral-700/30 text-neutral-500',
};
---

<Portal title="Invoices">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Invoices</h1>
      <p class="text-sm text-neutral-500 mt-2">Your billing history and payment status.</p>
    </div>

    {enriched.length > 0 ? (
      <div class="space-y-6">
        {enriched.map(inv => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-2xl overflow-hidden">
            {/* Invoice header */}
            <div class="p-8 pb-5">
              <div class="flex items-start justify-between mb-4">
                <div>
                  <p class="font-mono text-sm text-neutral-200">{inv.invoice_number}</p>
                  <div class="flex items-center gap-4 mt-1 text-xs text-neutral-600">
                    {inv.issued_date && <span>Issued: {inv.issued_date}</span>}
                    {inv.due_date && <span>Due: {inv.due_date}</span>}
                  </div>
                </div>
                <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[inv.status] || ''}`}>
                  {statusLabels[inv.status] || inv.status}
                </span>
              </div>

              {/* Payment progress */}
              {inv.total > 0 && (
                <div class="mb-4">
                  <div class="flex items-center justify-between mb-1.5">
                    <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-wide">
                      {inv.status === 'paid' ? 'Paid in full' : `$${inv.amount_paid.toFixed(2)} of $${inv.total.toFixed(2)}`}
                    </p>
                    <p class="text-lg font-mono font-semibold text-neutral-100">${inv.total.toFixed(2)}</p>
                  </div>
                  {inv.status !== 'paid' && inv.amount_paid > 0 && (
                    <div class="h-1.5 bg-neutral-800 rounded-full overflow-hidden">
                      <div class="h-full bg-amber-500/60 rounded-full" style={`width: ${Math.min(100, Math.round((inv.amount_paid / inv.total) * 100))}%`}></div>
                    </div>
                  )}
                </div>
              )}

              {inv.notes && <p class="text-sm text-neutral-500 mt-3">{inv.notes}</p>}
            </div>

            {/* Line items */}
            {inv.items.length > 0 && (
              <div class="border-t border-white/5">
                <table class="w-full text-sm">
                  <tbody>
                    {inv.items.map(item => (
                      <tr class="border-b border-white/5 last:border-0">
                        <td class="px-8 py-3 text-neutral-300">{item.description}</td>
                        <td class="px-4 py-3 text-right text-neutral-500 font-mono text-xs">{item.quantity} x ${item.unit_price.toFixed(2)}</td>
                        <td class="px-8 py-3 text-right text-neutral-200 font-mono">${item.amount.toFixed(2)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {/* Payments */}
            {inv.payments.length > 0 && (
              <div class="border-t border-white/5 px-8 py-4">
                <p class="text-[10px] font-mono text-neutral-700 uppercase tracking-wide mb-2">Payments</p>
                {inv.payments.map(p => (
                  <div class="flex items-center justify-between py-1.5">
                    <span class="text-xs text-neutral-500">{p.paid_at.split('T')[0]} {p.payment_method ? `via ${p.payment_method}` : ''}</span>
                    <span class="text-xs font-mono text-emerald-400">${p.amount.toFixed(2)}</span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No invoices yet</p>
        <p class="text-sm text-neutral-500">When we send you an invoice, it will appear here.</p>
      </div>
    )}
  </div>
</Portal>
