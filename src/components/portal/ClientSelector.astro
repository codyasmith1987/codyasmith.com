---
interface Props {
  clients: Array<{ id: string; name: string }>;
  id?: string;
}

const { clients, id = 'client-selector' } = Astro.props;
---

{clients.length > 0 && (
  <select
    id={id}
    class="px-3 py-2 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-400 text-xs focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
  >
    {clients.map(c => <option value={c.id}>{c.name}</option>)}
  </select>
)}
