---
// Public methodology page. Renders docs/naming/methodology.md from disk.
// Not linked from main nav. Linked from the dashboard email and PDF report.
//
// Inline markdown renderer here covers what the methodology doc uses:
// headings, paragraphs, bullet lists, inline code, bold, italic, links.
// We intentionally do not pull in a markdown library; the doc structure
// is stable and the renderer is small.

import Base from '../../layouts/Base.astro';
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';

export const prerender = false;

const mdPath = resolve(process.cwd(), 'docs/naming/methodology.md');
let mdContent = '';
try {
  mdContent = await readFile(mdPath, 'utf-8');
} catch (err) {
  mdContent = '# Methodology\n\nDocument unavailable.';
}

function escapeHtml(s: string): string {
  return s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function renderInline(s: string): string {
  // Order matters: code, links, bold, italic.
  let out = escapeHtml(s);
  // Inline code: `text`
  out = out.replace(/`([^`]+)`/g, '<code class="px-1.5 py-0.5 rounded bg-neutral-800 text-amber-400/90 font-mono text-[0.9em]">$1</code>');
  // Links: [text](url)
  out = out.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="text-amber-400 hover:text-amber-300 underline-offset-4 hover:underline">$1</a>');
  // Bold: **text**
  out = out.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-neutral-100">$1</strong>');
  // Italic: *text*
  out = out.replace(/(^|[^*])\*([^*]+)\*/g, '$1<em>$2</em>');
  return out;
}

function renderMarkdown(md: string): string {
  const lines = md.split('\n');
  const out: string[] = [];
  let i = 0;
  let inList = false;

  const closeList = () => {
    if (inList) {
      out.push('</ul>');
      inList = false;
    }
  };

  while (i < lines.length) {
    const line = lines[i];

    if (/^\s*$/.test(line)) {
      closeList();
      i += 1;
      continue;
    }

    // Headings
    const h1 = line.match(/^# (.+)/);
    const h2 = line.match(/^## (.+)/);
    const h3 = line.match(/^### (.+)/);
    if (h1) {
      closeList();
      out.push(`<h1 class="font-serif text-4xl md:text-5xl text-neutral-100 leading-tight mt-12 mb-6">${renderInline(h1[1])}</h1>`);
      i += 1;
      continue;
    }
    if (h2) {
      closeList();
      out.push(`<h2 class="font-serif text-2xl md:text-3xl text-neutral-100 leading-tight mt-10 mb-4">${renderInline(h2[1])}</h2>`);
      i += 1;
      continue;
    }
    if (h3) {
      closeList();
      out.push(`<h3 class="font-serif text-xl text-neutral-200 mt-8 mb-3">${renderInline(h3[1])}</h3>`);
      i += 1;
      continue;
    }

    // Bullet lists: lines starting with "- "
    if (/^- /.test(line)) {
      if (!inList) {
        out.push('<ul class="list-disc pl-6 my-4 space-y-2 text-neutral-300 text-base leading-relaxed">');
        inList = true;
      }
      const content = line.replace(/^- /, '');
      out.push(`<li>${renderInline(content)}</li>`);
      i += 1;
      continue;
    }

    // Numbered lists: lines starting with "1. " etc.
    if (/^\d+\. /.test(line)) {
      // Treat as bullet for simplicity (the methodology doc uses these for ordered process steps; visual order matters less than readability)
      if (!inList) {
        out.push('<ol class="list-decimal pl-6 my-4 space-y-2 text-neutral-300 text-base leading-relaxed">');
        inList = true;
      }
      const content = line.replace(/^\d+\. /, '');
      out.push(`<li>${renderInline(content)}</li>`);
      i += 1;
      continue;
    }

    // Paragraph: collect consecutive non-blank, non-heading, non-list lines.
    closeList();
    const para: string[] = [line];
    let j = i + 1;
    while (
      j < lines.length &&
      !/^\s*$/.test(lines[j]) &&
      !/^#{1,3} /.test(lines[j]) &&
      !/^- /.test(lines[j]) &&
      !/^\d+\. /.test(lines[j])
    ) {
      para.push(lines[j]);
      j += 1;
    }
    const joined = para.join(' ');
    out.push(`<p class="text-neutral-300 text-base leading-relaxed my-4">${renderInline(joined)}</p>`);
    i = j;
  }
  closeList();
  return out.join('\n');
}

const renderedHtml = renderMarkdown(mdContent);
---

<Base title="Naming methodology | Cody Smith" description="The research and conventions behind the naming preview tool. Position 1: naming as one variable among many.">
  <article class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="text-amber-400 font-mono text-xs tracking-[0.2em] uppercase mb-4">Methodology</p>
      <div class="prose-naming" set:html={renderedHtml}></div>

      <hr class="border-white/5 my-12" />

      <p class="text-neutral-500 text-sm leading-relaxed">
        Want to try the tool? <a href="/naming-preview" class="text-amber-400 hover:text-amber-300 underline-offset-4 hover:underline">Run a naming preview</a>.
      </p>
    </div>
  </article>

  <style>
    .prose-naming code { word-break: break-word; }
  </style>
</Base>
