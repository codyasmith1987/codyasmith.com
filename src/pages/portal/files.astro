---
import Portal from '../../layouts/Portal.astro';
import ClientSummary from '../../components/portal/ClientSummary.astro';
import { getFilesForClient, getAllFilesAdmin } from '../../lib/storage';
import { getAllClients } from '../../lib/auth';
import { buildFilesSummary } from '../../lib/client-page-summary';
export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';

const files = isAdmin
  ? await getAllFilesAdmin()
  : user.client_id
    ? await getFilesForClient(user.client_id)
    : [];

const clients = isAdmin ? await getAllClients() : [];

// Slice 17 — plain-language top summary. Reads the files table for
// the client and reports what arrived in the past 30 days.
const selectedClientId = isAdmin
  ? (Astro.url.searchParams.get('client_id') || clients[0]?.id || null)
  : (user.client_id ?? null);
const summary = selectedClientId ? await buildFilesSummary(selectedClientId) : null;

// Group files by month
const byMonth = new Map<string, typeof files>();
for (const f of files) {
  const month = f.month;
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(f);
}
const months = [...byMonth.keys()].sort().reverse();

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

function categoryLabel(cat: string): string {
  const labels: Record<string, string> = {
    invoice: 'Invoice',
    report: 'Report',
    spreadsheet: 'Spreadsheet',
    general: 'General',
  };
  return labels[cat] || cat;
}
---

<Portal title="Files">
  <div class="max-w-4xl mx-auto">
    {summary && <ClientSummary summary={summary} />}

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="portal-accent-text font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Deliverables</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Files</h1>
      </div>
    </div>

    {/* Admin upload form */}
    {isAdmin && (
      <form id="upload-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
        <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-5">Upload file</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Client</label>
            <select id="upload-client" name="client_id" required class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
              <option value="">Select...</option>
              {clients.map(c => <option value={c.id}>{c.name}</option>)}
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Month</label>
            <input type="month" id="upload-month" name="month" required
              value={new Date().toISOString().slice(0, 7)}
              class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300" />
          </div>
          <div>
            <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Category</label>
            <select id="upload-category" name="category" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-300 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
              <option value="report">Report</option>
              <option value="invoice">Invoice</option>
              <option value="spreadsheet">Spreadsheet</option>
              <option value="general">General</option>
            </select>
          </div>
          <div>
            <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">File</label>
            <input type="file" id="upload-file" name="file" required
              accept=".pdf,.docx,.xlsx,.xls,.csv,.png,.jpg,.jpeg,.webp"
              class="w-full text-sm text-neutral-500 file:mr-3 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-amber-500 file:text-neutral-950 hover:file:bg-amber-400 file:cursor-pointer file:transition-colors file:duration-300" />
          </div>
        </div>
        <div class="mt-6 flex items-center gap-4">
          <button type="submit" id="upload-btn" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)] disabled:opacity-50 disabled:hover:shadow-none">
            Upload
          </button>
          <p id="upload-msg" class="text-sm hidden"></p>
        </div>
      </form>
    )}

    {/* File list grouped by month */}
    {months.length > 0 ? (
      months.map(month => (
        <div class="mb-10">
          <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-4">
            {new Date(month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}
          </p>
          <div class="space-y-2">
            {byMonth.get(month)!.map(f => (
              <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-center justify-between group hover:border-white/10 transition-all duration-300">
                <div class="flex items-center gap-4 min-w-0">
                  <div class="min-w-0">
                    <p class="text-sm font-medium text-neutral-200 truncate">{f.original_name}</p>
                    <div class="flex items-center gap-3 mt-1">
                      <span class="text-[10px] font-mono text-neutral-600">{formatBytes(f.size_bytes)}</span>
                      <span class="text-[10px] text-neutral-700">{categoryLabel(f.category)}</span>
                      {'client_name' in f && <span class="text-[10px] text-neutral-700">{f.client_name}</span>}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a
                    href={`/portal/api/files/download?id=${f.id}`}
                    class="px-4 py-2 text-xs font-medium text-amber-400 border border-amber-500/20 rounded-lg hover:bg-amber-500/10 transition-all duration-300"
                  >
                    Download
                  </a>
                  {isAdmin && (
                    <button
                      data-delete-file={f.id}
                      class="px-4 py-2 text-xs text-neutral-600 border border-white/5 rounded-lg hover:text-red-400 hover:border-red-500/20 transition-all duration-300 opacity-0 group-hover:opacity-100"
                    >
                      Delete
                    </button>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    ) : (
      <div class="text-center py-24">
        <p class="font-serif text-2xl text-neutral-100 mb-3">No files yet</p>
        <p class="text-sm text-neutral-500 leading-relaxed max-w-xs mx-auto">
          {isAdmin ? 'Use the form above to upload reports, invoices, and deliverables.' : 'Your files and deliverables will appear here.'}
        </p>
      </div>
    )}
  </div>

  <script>
    // Upload handler
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const form = document.getElementById('upload-form') as HTMLFormElement | null;
    if (form) {
      const btn = document.getElementById('upload-btn') as HTMLButtonElement;
      const msg = document.getElementById('upload-msg')!;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Uploading...';
        msg.classList.add('hidden');

        const formData = new FormData();
        formData.append('file', (document.getElementById('upload-file') as HTMLInputElement).files![0]);
        formData.append('client_id', (document.getElementById('upload-client') as HTMLSelectElement).value);
        formData.append('month', (document.getElementById('upload-month') as HTMLInputElement).value);
        formData.append('category', (document.getElementById('upload-category') as HTMLSelectElement).value);

        try {
          const res = await fetch('/portal/api/files/upload', { method: 'POST', headers: { 'X-CSRF-Token': csrfToken }, body: formData });
          const data = await res.json();

          if (res.ok) {
            (window as any).__toast(`Uploaded "${data.filename}"`, 'success');
            setTimeout(() => location.reload(), 1500);
          } else {
            throw new Error(data.error || 'Upload failed');
          }
        } catch (err: any) {
          msg.textContent = err.message;
          msg.className = 'text-sm text-red-400';
          msg.classList.remove('hidden');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Upload';
        }
      });
    }

    // Delete handlers
    document.querySelectorAll('[data-delete-file]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const confirmed = await (window as any).__confirm({
          title: 'Delete file',
          message: 'This file will be permanently deleted. This cannot be undone.',
          confirmLabel: 'Delete',
          danger: true,
        });
        if (!confirmed) return;
        const fileId = (btn as HTMLElement).dataset.deleteFile;
        const res = await fetch('/portal/api/files/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ file_id: fileId }),
        });
        if (res.ok) {
          const row = (btn as HTMLElement).closest('.group');
          if (row) {
            row.style.opacity = '0';
            row.style.transform = 'translateY(-8px)';
            row.style.transition = 'all 0.3s ease';
            setTimeout(() => row.remove(), 300);
          }
        }
      });
    });
  </script>
</Portal>
