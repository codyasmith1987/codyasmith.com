---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
import { listManagedSites } from '../../../lib/client-sites';
export const prerender = false;

const clients = await getAllClients();

// Load managed sites per client so the row's "Sites" disclosure can
// render per-site page-count inputs. Each row drives the per-site
// ecosystem routing in the multi-site pricing pipeline (audit
// finding 1, locked 2026-05-24). Fails soft per client so a single
// query hiccup does not break the list.
const sitesByClient: Record<string, Awaited<ReturnType<typeof listManagedSites>>> = {};
for (const c of clients) {
  try {
    sitesByClient[c.id] = await listManagedSites(c.id);
  } catch {
    sitesByClient[c.id] = [];
  }
}

// Compute the eco chip text outside the JSX expression. Astro's JSX
// parser interprets bare < inside braces as JSX tag opens, which
// breaks inline numeric comparisons like `page_count < 30`. A helper
// function avoids the ambiguity.
function ecoChipLabel(pageCount: number | null): string {
  if (pageCount == null) return '→ primary eco';
  if (pageCount < 30) return '→ Eco A';
  if (pageCount <= 150) return '→ Eco B';
  return '→ Eco C';
}
---

<Portal title="Manage Clients">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Clients</h1>
    </div>

    <!-- Create client form -->
    <form id="create-client-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
      <p class="text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase mb-5">Add new client</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="client-name" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Business name</label>
          <input
            type="text"
            id="client-name"
            name="name"
            required
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="ZipKit Homes"
          />
        </div>
        <div>
          <label for="client-slug" class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-2">Slug (URL-safe)</label>
          <input
            type="text"
            id="client-slug"
            name="slug"
            required
            pattern="[a-z0-9\-]+"
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm font-mono focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="zipkit-homes"
          />
        </div>
      </div>
      <button type="submit" class="mt-6 px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]">
        Create client
      </button>
      <p id="client-msg" class="mt-4 text-sm hidden"></p>
    </form>

    <!-- Client list -->
    {clients.length > 0 ? (
      <div class="space-y-3">
        {clients.map(client => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 group hover:border-white/10 transition-all duration-300" data-client-row={client.id}>
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <p class="text-sm font-medium text-neutral-200" data-client-name-display={client.id}>{client.name}</p>
                <p class="text-xs font-mono text-neutral-400 mt-0.5">
                  <span>{client.slug}</span>
                  {client.domain && <span class="ml-2 text-neutral-500">| {client.domain}</span>}
                  {client.discount_rate > 0 && (
                    <span class="ml-2 text-amber-600" data-client-discount-display={client.id}>
                      | {(client.discount_rate * 100).toFixed(client.discount_rate * 100 % 1 === 0 ? 0 : 1)}% off
                    </span>
                  )}
                  {client.discount_rate === 0 && (
                    <span class="ml-2 text-neutral-400 hidden" data-client-discount-display={client.id}></span>
                  )}
                </p>
              </div>
              <div class="flex items-center gap-3">
                <span
                  data-client-badge={client.id}
                  class:list={[
                    'text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full',
                    client.active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500',
                  ]}
                >
                  {client.active ? 'Active' : 'Inactive'}
                </span>
                <button
                  data-edit-client={client.id}
                  class="text-xs text-neutral-400 hover:text-amber-600 transition-colors duration-300 opacity-0 group-hover:opacity-100"
                >
                  Edit
                </button>
                <button
                  data-toggle-client={client.id}
                  data-client-active={client.active ? '1' : '0'}
                  class="text-xs text-neutral-400 hover:text-amber-600 transition-colors duration-300 opacity-0 group-hover:opacity-100"
                >
                  {client.active ? 'Deactivate' : 'Activate'}
                </button>
              </div>
            </div>

            <!-- Managed sites with per-site page-count editors.
                 Renders when the client has 2+ managed sites; the
                 per-site routing only matters in multi-site
                 engagements. Single-site clients use the standard
                 page_count input on the wizard. -->
            {sitesByClient[client.id] && sitesByClient[client.id].length >= 2 && (
              <details class="mt-3 group" data-sites-slot={client.id}>
                <summary class="text-[10px] font-mono text-neutral-400 tracking-wide uppercase cursor-pointer hover:text-amber-600 transition-colors select-none">
                  Per-site page counts ({sitesByClient[client.id].length} managed sites)
                </summary>
                <div class="mt-3 p-3 bg-neutral-900/40 border border-white/5 rounded-md space-y-2">
                  <p class="text-[11px] text-neutral-400 leading-relaxed">Each managed site routes to its own ecosystem by its own page count. Primary pays full base monthly + onboarding. Each additional site pays 0.80 of its own ecosystem's base. Empty page count falls back to the primary's ecosystem for that site.</p>
                  {sitesByClient[client.id].map(site => (
                    <div class="grid grid-cols-12 gap-2 items-center" data-site-row={site.id}>
                      <span class:list={[
                        'col-span-2 text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded text-center',
                        site.is_primary
                          ? 'bg-amber-500/10 border border-amber-500/40 text-amber-700'
                          : 'bg-neutral-900 border border-white/10 text-neutral-400',
                      ]}>{site.is_primary ? 'primary' : 'site'}</span>
                      <span class="col-span-5 text-sm text-neutral-100 truncate font-mono">{site.domain}</span>
                      <input
                        type="number"
                        min="0"
                        data-site-page-count={site.id}
                        data-client-id={client.id}
                        value={site.page_count != null ? String(site.page_count) : ''}
                        placeholder="pages"
                        class="col-span-3 px-2 py-1.5 bg-neutral-900/50 border border-white/5 rounded text-neutral-200 text-sm font-mono focus:outline-none focus:border-amber-500/30"
                      />
                      <span
                        class="col-span-2 text-[10px] font-mono text-amber-700 text-right"
                        data-site-eco-chip={site.id}
                      >{ecoChipLabel(site.page_count)}</span>
                    </div>
                  ))}
                </div>
              </details>
            )}

            <!-- Edit form (hidden until Edit clicked) -->
            <div data-edit-slot={client.id} class="hidden mt-4 pt-4 border-t border-white/5">
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-1">Name</label>
                  <input type="text" data-edit-name={client.id} value={client.name}
                    class="w-full px-3 py-2 bg-neutral-900/50 border border-white/10 rounded-md text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
                </div>
                <div>
                  <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-1">Domain</label>
                  <input type="text" data-edit-domain={client.id} value={client.domain || ''} placeholder="example.com"
                    class="w-full px-3 py-2 bg-neutral-900/50 border border-white/10 rounded-md text-neutral-200 text-sm font-mono focus:outline-none focus:border-amber-500/30" />
                </div>
                <div>
                  <label class="block text-[10px] font-mono text-neutral-400 tracking-wide uppercase mb-1">Discount %</label>
                  <input type="number" step="0.01" min="0" max="100" data-edit-discount={client.id}
                    value={(client.discount_rate * 100).toString()}
                    placeholder="0"
                    class="w-full px-3 py-2 bg-neutral-900/50 border border-white/10 rounded-md text-neutral-200 text-sm font-mono focus:outline-none focus:border-amber-500/30" />
                </div>
              </div>
              <div class="mt-3 flex items-center gap-3">
                <button type="button" data-save-edit={client.id}
                  class="px-4 py-2 bg-amber-500 text-neutral-950 text-xs font-medium rounded-md hover:bg-amber-400 transition-colors">
                  Save
                </button>
                <button type="button" data-cancel-edit={client.id}
                  class="text-xs text-neutral-500 hover:text-neutral-300 transition-colors">
                  Cancel
                </button>
                <p data-edit-msg={client.id} class="text-[11px] hidden"></p>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No clients yet</p>
        <p class="text-sm text-neutral-500">Create your first client above to get started.</p>
      </div>
    )}
  </div>

  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    // Per-site page-count editors. Blur posts to the existing
    // client_sites endpoint (action=set_page_count). Optimistic UI
    // updates the ecosystem chip immediately; failure reverts and
    // toasts.
    document.querySelectorAll('[data-site-page-count]').forEach(input => {
      const inputEl = input as HTMLInputElement;
      const siteId = inputEl.dataset.sitePageCount!;
      const clientId = inputEl.dataset.clientId!;
      const ecoChip = document.querySelector(`[data-site-eco-chip="${siteId}"]`);
      let priorValue = inputEl.value;
      inputEl.addEventListener('blur', async () => {
        const raw = inputEl.value.trim();
        const newPc = raw === '' ? null : Number(raw);
        if (raw !== '' && (!Number.isFinite(newPc) || (newPc as number) < 0)) {
          inputEl.value = priorValue;
          (window as any).__toast?.('Page count must be a non-negative number.', 'error');
          return;
        }
        // Optimistic chip update.
        if (ecoChip) {
          if (newPc === null) ecoChip.textContent = '→ primary eco';
          else if (newPc < 30) ecoChip.textContent = '→ Eco A';
          else if (newPc <= 150) ecoChip.textContent = '→ Eco B';
          else ecoChip.textContent = '→ Eco C';
        }
        try {
          const res = await fetch('/portal/api/admin/clients/sites', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ client_id: clientId, action: 'set_page_count', site_id: siteId, page_count: newPc }),
          });
          if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            (window as any).__toast?.(data.error || 'Failed to save page count.', 'error');
            inputEl.value = priorValue;
            return;
          }
          (window as any).__toast?.('Page count saved.', 'success');
          priorValue = inputEl.value;
        } catch {
          (window as any).__toast?.('Network error saving page count.', 'error');
          inputEl.value = priorValue;
        }
      });
    });

    // Toggle active/inactive
    document.querySelectorAll('[data-toggle-client]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const button = btn as HTMLButtonElement;
        const clientId = button.dataset.toggleClient!;
        const isActive = button.dataset.clientActive === '1';

        if (isActive) {
          const confirmed = await (window as any).__confirm({
            title: 'Deactivate client',
            message: 'Their users won\'t be able to log in while deactivated.',
            confirmLabel: 'Deactivate',
            danger: true,
          });
          if (!confirmed) return;
        }

        await (window as any).__withButtonLoading(button, isActive ? 'Deactivating…' : 'Activating…', async () => {
          const res = await fetch('/portal/api/admin/toggle-client', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ client_id: clientId }),
          });
          if (res.ok) {
            const data = await res.json();
            const badge = document.querySelector(`[data-client-badge="${clientId}"]`)!;
            badge.textContent = data.active ? 'Active' : 'Inactive';
            badge.className = `text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${data.active ? 'bg-emerald-500/15 text-emerald-700' : 'bg-neutral-800 text-neutral-500'}`;
            button.textContent = data.active ? 'Deactivate' : 'Activate';
            button.dataset.clientActive = data.active ? '1' : '0';
            (window as any).__toast(`Client ${data.active ? 'activated' : 'deactivated'}.`, 'success');
          } else {
            (window as any).__toast('Failed to toggle client.', 'error');
          }
        });
      });
    });

    const form = document.getElementById('create-client-form') as HTMLFormElement;
    const msg = document.getElementById('client-msg')!;
    const nameInput = document.getElementById('client-name') as HTMLInputElement;
    const slugInput = document.getElementById('client-slug') as HTMLInputElement;

    // Auto-generate slug from name
    nameInput.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }
    });
    slugInput.addEventListener('input', () => { slugInput.dataset.manual = '1'; });

    // Edit per-client: name, domain, discount %.
    document.querySelectorAll('[data-edit-client]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.editClient!;
        document.querySelector(`[data-edit-slot="${id}"]`)?.classList.remove('hidden');
      });
    });
    document.querySelectorAll('[data-cancel-edit]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = (btn as HTMLElement).dataset.cancelEdit!;
        document.querySelector(`[data-edit-slot="${id}"]`)?.classList.add('hidden');
        const msgEl = document.querySelector(`[data-edit-msg="${id}"]`) as HTMLElement | null;
        if (msgEl) msgEl.classList.add('hidden');
      });
    });
    document.querySelectorAll('[data-save-edit]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const button = btn as HTMLButtonElement;
        const id = button.dataset.saveEdit!;
        const nameEl = document.querySelector(`[data-edit-name="${id}"]`) as HTMLInputElement;
        const domainEl = document.querySelector(`[data-edit-domain="${id}"]`) as HTMLInputElement;
        const discountEl = document.querySelector(`[data-edit-discount="${id}"]`) as HTMLInputElement;
        const msgEl = document.querySelector(`[data-edit-msg="${id}"]`) as HTMLElement;

        const name = nameEl.value.trim();
        const domainRaw = domainEl.value.trim();
        const discountPct = parseFloat(discountEl.value);
        // Discount input is a percentage (0-100). Stored as a decimal
        // (0-1.0). Clamping happens here so server gets a valid rate.
        const discountRate = Number.isFinite(discountPct) ? Math.max(0, Math.min(100, discountPct)) / 100 : 0;

        msgEl.textContent = 'Saving…';
        msgEl.className = 'text-[11px] text-neutral-500';
        msgEl.classList.remove('hidden');

        await (window as any).__withButtonLoading(button, 'Saving…', async () => {
          let res;
          try {
            res = await fetch('/portal/api/admin/clients/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
              body: JSON.stringify({
                client_id: id,
                name,
                domain: domainRaw,
                discount_rate: discountRate,
              }),
            });
          } catch (err: any) {
            msgEl.textContent = `Network error: ${err?.message || 'fetch failed'}`;
            msgEl.className = 'text-[11px] text-red-700';
            (window as any).__toast('Network error saving client.', 'error');
            return;
          }
          const rawText = await res.text();
          let data: any = null;
          try { data = rawText ? JSON.parse(rawText) : null; } catch {}
          if (res.ok && data && data.ok) {
            msgEl.textContent = `Saved. Discount stored as ${(discountRate * 100).toFixed(discountRate * 100 % 1 === 0 ? 0 : 1)}%.`;
            msgEl.className = 'text-[11px] text-emerald-700';
            const nameDisplay = document.querySelector(`[data-client-name-display="${id}"]`);
            if (nameDisplay) nameDisplay.textContent = name;
            (window as any).__toast(`Client "${name}" saved.`, 'success');
            setTimeout(() => location.reload(), 800);
          } else {
            const errMsg = (data && data.error) ? data.error : `HTTP ${res.status}${rawText ? ': ' + rawText.slice(0, 140) : ''}`;
            msgEl.textContent = errMsg;
            msgEl.className = 'text-[11px] text-red-700';
            (window as any).__toast(errMsg, 'error');
          }
        });
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const res = await fetch('/portal/api/admin/create-client', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          slug: slugInput.value.trim(),
        }),
      });

      const data = await res.json();
      if (res.ok) {
        msg.textContent = `Created "${data.name}"`;
        msg.className = 'mt-4 text-sm text-emerald-400';
        msg.classList.remove('hidden');
        form.reset();
        slugInput.dataset.manual = '';
        setTimeout(() => location.reload(), 800);
      } else {
        msg.textContent = data.error || 'Failed';
        msg.className = 'mt-4 text-sm text-red-400';
        msg.classList.remove('hidden');
      }
    });
  </script>
</Portal>
