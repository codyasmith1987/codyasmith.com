---
import Portal from '../../../layouts/Portal.astro';
import { getAwaitingAtSigningInvoices } from '../../../lib/invoices';
export const prerender = false;

const awaiting = await getAwaitingAtSigningInvoices();

const statusColors: Record<string, string> = {
  sent: 'bg-blue-500/10 text-blue-400',
  partial: 'bg-amber-500/10 text-amber-600',
  overdue: 'bg-red-500/10 text-red-400',
  payment_pending: 'bg-violet-500/10 text-violet-400',
};
const statusLabels: Record<string, string> = {
  payment_pending: 'Payment pending',
  carried_forward: 'Carried forward',
};

const today = Date.now();
function daysOutstanding(issued: string | null): number | null {
  if (!issued) return null;
  const t = Date.parse(issued + 'T00:00:00');
  if (Number.isNaN(t)) return null;
  return Math.max(0, Math.round((today - t) / 86400000));
}
---

<Portal title="Awaiting payment">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Awaiting at-signing payment</h1>
      <p class="text-sm text-neutral-500 mt-2">Signed engagements whose at-signing invoice has not cleared. Work begins once it does (contract section 5.2). Record a payment to auto-kick-off the engagement.</p>
    </div>

    {awaiting.length === 0 ? (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">All clear</p>
        <p class="text-sm text-neutral-500">No at-signing invoices are awaiting payment.</p>
      </div>
    ) : (
      <div class="space-y-3">
        {awaiting.map(inv => {
          const d = daysOutstanding(inv.issued_date);
          return (
            <a href={`/portal/admin/invoices/${inv.id}`} class="block bg-neutral-900/30 border border-white/5 rounded-xl p-5 hover:border-white/10 transition-all group">
              <div class="flex items-center justify-between gap-4">
                <div class="min-w-0">
                  <p class="text-sm font-medium text-neutral-200 group-hover:text-amber-600 transition-colors">{inv.client_name}</p>
                  <div class="flex items-center gap-4 mt-1 text-xs text-neutral-400 flex-wrap">
                    <span class="font-mono">{inv.invoice_number}</span>
                    {inv.issued_date && <span>Issued {inv.issued_date}</span>}
                    {d != null && <span class={d >= 7 ? 'text-amber-500' : ''}>{d} day{d === 1 ? '' : 's'} outstanding</span>}
                  </div>
                </div>
                <div class="flex items-center gap-4 shrink-0">
                  <div class="text-right">
                    <p class="text-sm font-mono text-neutral-300">${inv.total.toFixed(2)}</p>
                    {inv.amount_paid > 0 && (
                      <p class="text-[10px] text-neutral-400">Paid ${inv.amount_paid.toFixed(2)}</p>
                    )}
                  </div>
                  <span class={`text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${statusColors[inv.status] || 'bg-neutral-700/30 text-neutral-400'}`}>{statusLabels[inv.status] || inv.status}</span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Portal>
