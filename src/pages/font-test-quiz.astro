---
// Diagnostic page for Quiz overlay interaction with self-hosted fonts.
// Same as /font-test-base (BaseFontsTest layout, self-hosted woff2 via
// fonts.css, no personalization JS, no hero, no page-level components)
// PLUS the Quiz overlay component imported here.
//
// To test the Quiz path you must have a fresh state (Quiz hides itself
// via the cs-quiz-done flag in localStorage). On iPhone Safari, either
// open in Private Browsing or clear "codyasmith.com" site data first.
import BaseFontsTest from '../layouts/BaseFontsTest.astro';
import Quiz from '../components/Quiz.astro';
---
<BaseFontsTest title="Font test (Quiz overlay)">
  <div class="max-w-3xl mx-auto px-6 pt-32 pb-24">
    <h1 class="font-serif text-4xl md:text-5xl text-neutral-100 leading-tight mb-4">
      Font test, with Quiz overlay
    </h1>
    <p class="text-neutral-400 mb-4 max-w-2xl leading-relaxed">
      Same setup as <code class="font-mono text-amber-400">/font-test-base</code> plus the Quiz overlay component. No personalization JS, no hero, no other page-level content.
    </p>
    <p class="text-neutral-500 mb-12 max-w-2xl text-sm leading-relaxed">
      If the Quiz does not appear, your iPhone has <code class="font-mono">cs-quiz-done</code> in localStorage from earlier testing. Open this URL in iOS Safari Private Browsing, or clear codyasmith.com site data, then reload.
    </p>

    <div class="space-y-4">
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Instrument Serif 400</p>
        <p class="font-serif text-2xl text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Inter 400</p>
        <p class="font-sans text-2xl font-normal text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Inter 400 italic</p>
        <p class="font-sans text-2xl font-normal italic text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Inter 500</p>
        <p class="font-sans text-2xl font-medium text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Inter 600</p>
        <p class="font-sans text-2xl font-semibold text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Inter 700</p>
        <p class="font-sans text-2xl font-bold text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Lora 400</p>
        <p class="font-quote text-2xl font-normal text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Lora 400 italic</p>
        <p class="font-quote text-2xl font-normal italic text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">Lora 600</p>
        <p class="font-quote text-2xl font-semibold text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
      <div class="p-4 border border-neutral-800 rounded">
        <p class="font-mono text-[10px] tracking-[0.15em] uppercase text-neutral-500 mb-2">JetBrains Mono 400</p>
        <p class="font-mono text-2xl font-normal text-neutral-100 leading-snug">The fluorescent over my desk had a flicker on the left tube.</p>
      </div>
    </div>
  </div>
  <Quiz />
</BaseFontsTest>
