---
import Portal from '../../../layouts/Portal.astro';
import { getRecentActivity } from '../../../lib/activity';
import { getAllClients } from '../../../lib/auth';
export const prerender = false;

const clients = await getAllClients();

const clientFilter = Astro.url.searchParams.get('client') || '';
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1'));
const limit = 50;
const offset = (page - 1) * limit;

const { entries, total } = await getRecentActivity({
  clientId: clientFilter || undefined,
  limit,
  offset,
});

const totalPages = Math.ceil(total / limit);

function timeAgo(dateStr: string): string {
  const now = new Date();
  const then = new Date(dateStr + 'Z');
  const diff = now.getTime() - then.getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return 'just now';
  if (mins < 60) return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d ago`;
  return then.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

function actionIcon(action: string): string {
  const icons: Record<string, string> = {
    created: '+',
    updated: '~',
    deleted: '-',
    uploaded: '^',
    logged_in: '>',
    logged_out: '<',
    revoked: 'x',
  };
  return icons[action] || '.';
}

function actionColor(action: string): string {
  if (action === 'deleted' || action === 'revoked') return 'text-red-400 bg-red-500/10';
  if (action === 'created' || action === 'uploaded') return 'text-emerald-400 bg-emerald-500/10';
  if (action === 'logged_in' || action === 'logged_out') return 'text-blue-400 bg-blue-500/10';
  return 'text-amber-400 bg-amber-500/10';
}
---

<Portal title="Activity Log">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Activity Log</h1>
      </div>
      <form method="GET" class="flex items-center gap-3">
        <select name="client" class="px-3 py-2 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-400 text-xs focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
          <option value="">All clients</option>
          {clients.map(c => (
            <option value={c.id} selected={c.id === clientFilter}>{c.name}</option>
          ))}
        </select>
        <button type="submit" class="px-4 py-2 text-xs font-medium text-amber-400 border border-amber-500/20 rounded-lg hover:bg-amber-500/10 transition-all duration-300">
          Filter
        </button>
      </form>
    </div>

    {entries.length > 0 ? (
      <div class="space-y-1">
        {entries.map(entry => (
          <div class="flex items-start gap-4 py-3 px-4 rounded-lg hover:bg-white/[0.02] transition-all duration-300">
            <span class:list={[
              'w-7 h-7 rounded-lg flex items-center justify-center text-xs font-mono shrink-0 mt-0.5',
              actionColor(entry.action),
            ]}>
              {actionIcon(entry.action)}
            </span>
            <div class="flex-1 min-w-0">
              <p class="text-sm text-neutral-200">{entry.summary}</p>
              <div class="flex items-center gap-3 mt-1">
                <span class="text-[10px] font-mono text-neutral-700">{entry.entity_type}</span>
                <span class="text-[10px] text-neutral-700">{timeAgo(entry.created_at)}</span>
                {entry.user_name && (
                  <span class="text-[10px] text-neutral-700">{entry.user_name}</span>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-24">
        <p class="font-serif text-2xl text-neutral-100 mb-3">No activity yet</p>
        <p class="text-sm text-neutral-500 leading-relaxed max-w-xs mx-auto">
          Activity will appear here as actions are taken in the portal.
        </p>
      </div>
    )}

    {totalPages > 1 && (
      <div class="flex items-center justify-center gap-4 mt-10">
        {page > 1 && (
          <a
            href={`?page=${page - 1}${clientFilter ? `&client=${clientFilter}` : ''}`}
            class="px-4 py-2 text-xs text-neutral-400 border border-white/5 rounded-lg hover:border-amber-500/20 hover:text-amber-400 transition-all duration-300"
          >
            Previous
          </a>
        )}
        <span class="text-[10px] font-mono text-neutral-700">
          Page {page} of {totalPages}
        </span>
        {page < totalPages && (
          <a
            href={`?page=${page + 1}${clientFilter ? `&client=${clientFilter}` : ''}`}
            class="px-4 py-2 text-xs text-neutral-400 border border-white/5 rounded-lg hover:border-amber-500/20 hover:text-amber-400 transition-all duration-300"
          >
            Next
          </a>
        )}
      </div>
    )}

    <p class="text-center text-[10px] font-mono text-neutral-700 mt-6">
      {total} total event{total !== 1 ? 's' : ''}
    </p>
  </div>
</Portal>
