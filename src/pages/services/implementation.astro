        </div>
      </div>
    </div>
  </section>

  <section class="py-28 px-6 surface-2">
    <div class="max-w-5xl mx-auto">
      <div class="mb-16">
        <p class="text-amber-400 font-mono text-xs tracking-[0.2em] uppercase mb-4">Process</p>
