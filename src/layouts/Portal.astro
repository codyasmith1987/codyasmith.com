---
import '../styles/global.css';

export const prerender = false;

interface Props {
  title: string;
}

const { title } = Astro.props;
const user = Astro.locals.user;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/portal/dashboard', label: 'Dashboard', icon: 'chart' },
  { href: '/portal/keywords', label: 'Keywords', icon: 'search' },
  { href: '/portal/health', label: 'Site Health', icon: 'shield' },
  { href: '/portal/files', label: 'Files', icon: 'folder' },
];

const adminItems = [
  { href: '/portal/admin/clients', label: 'Clients', icon: 'users' },
  { href: '/portal/admin/users', label: 'Users', icon: 'key' },
  { href: '/portal/admin/csv', label: 'CSV Upload', icon: 'upload' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico?v=2" sizes="32x32" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-300 font-sans">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="hidden md:flex w-64 flex-col bg-neutral-900 border-r border-white/5">
        <div class="p-6 border-b border-white/5">
          <a href="/portal/dashboard" class="text-lg font-semibold text-neutral-100">codyasmith.com</a>
          <p class="text-xs text-neutral-500 mt-1">Client Portal</p>
        </div>

        <nav class="flex-1 p-4 space-y-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors',
                currentPath.startsWith(item.href)
                  ? 'bg-amber-500/10 text-amber-400'
                  : 'text-neutral-400 hover:text-neutral-200 hover:bg-white/5',
              ]}
            >
              {item.label}
            </a>
          ))}

          {user?.role === 'admin' && (
            <>
              <div class="pt-4 pb-2">
                <p class="px-3 text-xs font-medium text-neutral-600 uppercase tracking-wider">Admin</p>
              </div>
              {adminItems.map(item => (
                <a
                  href={item.href}
                  class:list={[
                    'flex items-center gap-3 px-3 py-2 rounded-lg text-sm transition-colors',
                    currentPath.startsWith(item.href)
                      ? 'bg-amber-500/10 text-amber-400'
                      : 'text-neutral-400 hover:text-neutral-200 hover:bg-white/5',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </>
          )}
        </nav>

        <div class="p-4 border-t border-white/5">
          <div class="flex items-center justify-between">
            <div class="min-w-0">
              <p class="text-sm font-medium text-neutral-200 truncate">{user?.name}</p>
              <p class="text-xs text-neutral-500 truncate">{user?.email}</p>
            </div>
            <form method="POST" action="/portal/auth/logout">
              <button type="submit" class="text-xs text-neutral-500 hover:text-red-400 transition-colors whitespace-nowrap ml-3">
                Log out
              </button>
            </form>
          </div>
        </div>
      </aside>

      <!-- Mobile header -->
      <div class="flex flex-col flex-1">
        <header class="md:hidden flex items-center justify-between p-4 bg-neutral-900 border-b border-white/5">
          <a href="/portal/dashboard" class="text-lg font-semibold text-neutral-100">Portal</a>
          <button id="mobile-menu-btn" class="text-neutral-400 hover:text-neutral-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </header>

        <!-- Mobile nav drawer -->
        <nav id="mobile-nav" class="hidden md:hidden bg-neutral-900 border-b border-white/5 p-4 space-y-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class:list={[
                'block px-3 py-2 rounded-lg text-sm',
                currentPath.startsWith(item.href) ? 'bg-amber-500/10 text-amber-400' : 'text-neutral-400',
              ]}
            >
              {item.label}
            </a>
          ))}
          {user?.role === 'admin' && adminItems.map(item => (
            <a
              href={item.href}
              class:list={[
                'block px-3 py-2 rounded-lg text-sm',
                currentPath.startsWith(item.href) ? 'bg-amber-500/10 text-amber-400' : 'text-neutral-400',
              ]}
            >
              {item.label}
            </a>
          ))}
          <form method="POST" action="/portal/auth/logout" class="pt-2">
            <button type="submit" class="text-xs text-neutral-500 hover:text-red-400">Log out</button>
          </form>
        </nav>

        <!-- Main content -->
        <main class="flex-1 p-6 md:p-8 overflow-auto">
          <slot />
        </main>
      </div>
    </div>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const nav = document.getElementById('mobile-nav');
      if (btn && nav) {
        btn.addEventListener('click', () => nav.classList.toggle('hidden'));
      }
    </script>
  </body>
</html>
