---
interface Props {
  id?: string;
  message?: string;
}

const { id = 'loading-state', message = 'Loading...' } = Astro.props;
---

<div id={id} class="text-center py-24">
  <div class="inline-block w-8 h-8 border-2 border-neutral-800 border-t-amber-500 rounded-full animate-spin mb-5" role="status" aria-label="Loading"></div>
  <p class="text-sm text-neutral-600">{message}</p>
</div>
