---
import Portal from '../../layouts/Portal.astro';

// Self-service password-set page. Middleware redirects authenticated
// users with no password set here, so first-time magic-link arrivals
// must establish a password before the portal opens. See
// security-audit-2026-05-12 round 3 SEC3-008.
//
// Layout used: standalone container (not Portal which assumes nav),
// because the user shouldn't see the rest of the portal until they
// finish this step.
const user = Astro.locals.user;
const csrfToken = Astro.locals.csrfToken || '';

if (!user) {
  return Astro.redirect('/portal/login');
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Set a password | Client Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Editorial type stack — match the rest of the site. */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,30,0;9..144,500,30,0;9..144,700,50,1;9..144,900,100,1&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <meta name="csrf-token" content={csrfToken} />
  </head>
  <body class="portal-editorial min-h-screen bg-neutral-950 text-neutral-300 font-sans flex items-center justify-center">
    <div class="w-full max-w-sm mx-auto px-6">
      <div class="text-center mb-10">
        <h1
          class="text-4xl text-neutral-100 mb-3"
          style="font-family: var(--font-display); font-variation-settings: 'opsz' 72, 'SOFT' 30, 'WONK' 0; letter-spacing: -0.022em; font-weight: 500;"
        >Set a password</h1>
        <p class="text-neutral-500 text-sm leading-relaxed">
          You signed in with a one-time link. Choose a password to keep using the portal.
        </p>
      </div>

      <form id="set-password-form" class="space-y-5">
        <div>
          <label for="password" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="new-password"
            minlength="12"
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
            placeholder="At least 12 characters"
          />
        </div>
        <div>
          <label for="confirm" class="block text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-2">Confirm password</label>
          <input
            type="password"
            id="confirm"
            name="confirm"
            required
            autocomplete="new-password"
            minlength="12"
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/10 rounded-lg text-neutral-100 placeholder-neutral-700 text-sm focus:outline-none focus:border-amber-500/40 focus:ring-1 focus:ring-amber-500/20 transition-colors duration-200"
            placeholder="Re-enter your password"
          />
        </div>
        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-colors duration-200 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Set password and continue
        </button>
      </form>

      <div id="error-message" class="hidden mt-6 p-4 bg-red-500/5 border border-red-500/15 rounded-lg text-sm text-red-400 leading-relaxed"></div>
    </div>

    <script>
      const form = document.getElementById('set-password-form') as HTMLFormElement;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      const errorEl = document.getElementById('error-message')!;
      const csrf = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.classList.add('hidden');

        const password = (form.querySelector('#password') as HTMLInputElement).value;
        const confirm = (form.querySelector('#confirm') as HTMLInputElement).value;
        if (password !== confirm) {
          errorEl.textContent = 'Passwords do not match.';
          errorEl.classList.remove('hidden');
          return;
        }

        btn.disabled = true;
        btn.textContent = 'Setting...';

        try {
          const res = await fetch('/portal/api/auth/set-own-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf },
            body: JSON.stringify({ password }),
          });
          const data = await res.json();

          if (res.ok) {
            // setPassword revokes existing sessions, including this one.
            // Send the user to login so they can sign in with the new
            // password they just set.
            window.location.href = '/portal/login?passwordSet=1';
          } else {
            errorEl.textContent = data.error || 'Could not set password.';
            errorEl.classList.remove('hidden');
            btn.disabled = false;
            btn.textContent = 'Set password and continue';
          }
        } catch {
          errorEl.textContent = 'Connection error. Try again.';
          errorEl.classList.remove('hidden');
          btn.disabled = false;
          btn.textContent = 'Set password and continue';
        }
      });
    </script>
  </body>
</html>
