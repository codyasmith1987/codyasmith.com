---
// Admin index for client_agreements. Lists every agreement with client,
// status, signing progress, and view/manage/cancel actions. Mirrors
// /portal/admin/proposals.astro in shape so the admin surface feels
// the same across both lists.

import Portal from '../../../layouts/Portal.astro';
import turso from '../../../lib/turso';
import { listAllAgreements, getSignersForAgreement, getSignaturesForAgreement } from '../../../lib/agreements';

export const prerender = false;

const user = Astro.locals.user;
if (!user || user.role !== 'admin') return Astro.redirect('/portal/dashboard');

const agreements = await listAllAgreements();

// Pull per-agreement signer + signature state. Bounded by the number
// of agreements; small list, fine.
const agreementSummaries = await Promise.all(agreements.map(async a => {
  const signers = await getSignersForAgreement(a.id);
  const signatures = await getSignaturesForAgreement(a.id, true);
  const activeBySigner: Record<string, any> = {};
  for (const s of signatures) if (!s.revoked_at) activeBySigner[s.signer_id] = s;
  return {
    ...a,
    signers: signers.map(s => ({ id: s.id, name: s.name_snapshot, signed: !!activeBySigner[s.id] })),
  };
}));

// Client name lookup.
const clientIds = Array.from(new Set(agreements.map(a => a.client_id)));
const clientRows = clientIds.length > 0
  ? await turso.execute({
      sql: `SELECT id, name FROM clients WHERE id IN (${clientIds.map(() => '?').join(',')})`,
      args: clientIds,
    })
  : { rows: [] as any[] };
const clientById: Record<string, string> = {};
for (const row of clientRows.rows as any[]) clientById[row[0]] = row[1];

// Available proposals to issue from (finalized, not already issued).
const existingProposalIds = new Set(agreements.filter(a => a.proposal_id).map(a => a.proposal_id));
const proposalsResult = await turso.execute(`
  SELECT id, slug, title, client_id, finalized_at
  FROM proposals
  WHERE finalized_at IS NOT NULL
  ORDER BY finalized_at DESC
`);
const availableProposals = (proposalsResult.rows as any[])
  .filter(r => !existingProposalIds.has(r[0]))
  .map(r => ({
    id: r[0] as string,
    slug: r[1] as string,
    title: r[2] as string,
    client_id: r[3] as string,
    client_name: clientById[r[3]] || '',
  }));

function fmtDate(s: string | null): string {
  if (!s) return '';
  const d = new Date(s.includes('T') ? s : s.replace(' ', 'T') + 'Z');
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

import { AGREEMENT_STATUS, badgeClass, lookupStatus, STATUS_PILL_BASE } from '../../../lib/admin-status-styling';
---

<Portal title="Agreements">
  <div class="max-w-4xl mx-auto">
    <div class="mb-10 flex items-start justify-between gap-6">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Agreements</h1>
        <p class="text-sm text-neutral-500 mt-2">Client services agreements: drafted, issued, partial, executed.</p>
      </div>
      <a
        href="/portal/admin/agreements/new"
        class="shrink-0 px-5 py-2.5 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300"
      >
        New agreement
      </a>
    </div>

    {availableProposals.length > 0 && (
      <div class="mb-8 p-4 bg-blue-500/5 border border-blue-500/20 rounded-xl">
        <p class="text-xs font-mono text-blue-300 mb-2 tracking-[0.18em] uppercase">Quick action</p>
        <p class="text-sm text-neutral-300 mb-3">Issue agreement from a finalized proposal:</p>
        <div class="flex flex-wrap gap-2">
          {availableProposals.map(p => (
            <a
              href={`/portal/admin/agreements/new?proposal=${p.id}`}
              class="px-3 py-1.5 bg-blue-500/10 border border-blue-500/30 rounded-md text-xs text-blue-300 hover:bg-blue-500/20 transition-colors"
            >
              {p.client_name}: {p.title}
            </a>
          ))}
        </div>
      </div>
    )}

    <details class="mb-6 group">
      <summary class="text-[10px] font-mono text-neutral-400 tracking-[0.15em] uppercase cursor-pointer hover:text-amber-600 transition-colors duration-300 select-none">Status guide</summary>
      <div class="mt-3 p-4 bg-neutral-900/30 border border-white/5 rounded-lg space-y-2 text-sm text-neutral-300">
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-neutral-700/30 text-neutral-500 mr-2">Draft</span>Saved but not yet sent to signers. No emails out yet.</p>
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 mr-2">Issued</span>Sent to signers. Invite emails are out and the contract page is live for signing.</p>
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-amber-500/15 text-amber-700 mr-2">Partial</span>One or more signers have signed; at least one still has not.</p>
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-700 mr-2">Executed</span>Every required signer has signed. The agreement is in force.</p>
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-amber-500/15 text-amber-700 mr-2">Revoked</span>I pulled it back after issuing but before any signature. Signers see the agreement is no longer active.</p>
        <p><span class="inline-block text-[10px] font-mono uppercase tracking-wide px-2 py-0.5 rounded bg-red-500/15 text-red-700 mr-2">Voided</span>Cancelled after at least one signature. The agreement was active and is now cancelled by either party.</p>
      </div>
    </details>

    {agreementSummaries.length > 0 ? (
      <div class="space-y-3">
        {agreementSummaries.map(a => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 group hover:border-white/10 transition-all duration-300">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-baseline gap-3 flex-wrap">
                  <p class="text-sm font-medium text-neutral-200">{clientById[a.client_id] || 'Unknown client'}</p>
                  <a href={`/portal/contracts/${a.slug}`} target="_blank" rel="noopener" class="text-[10px] font-mono text-neutral-400 hover:text-amber-600 transition-colors">/{a.slug}</a>
                  {(() => {
                    const info = lookupStatus(AGREEMENT_STATUS, a.status);
                    return <span class:list={[STATUS_PILL_BASE, badgeClass(info.token)]}>{info.label}</span>;
                  })()}
                </div>
                <p class="text-xs text-neutral-500 mt-1">{a.title}</p>

                {a.signers.length > 0 && (
                  <div class="flex items-center gap-4 mt-3 text-xs">
                    {a.signers.map(s => (
                      <span class="flex items-center gap-1.5">
                        {s.signed ? <span class="text-emerald-400">✓</span> : <span class="text-neutral-400">○</span>}
                        <span class:list={[s.signed ? 'text-neutral-300' : 'text-neutral-400']}>{s.name}</span>
                      </span>
                    ))}
                  </div>
                )}

                <div class="flex items-center gap-4 mt-3 text-[10px] font-mono text-neutral-500">
                  {a.created_at && <span>Created {fmtDate(a.created_at)}</span>}
                  {a.issued_at && <span>Issued {fmtDate(a.issued_at)}</span>}
                  {a.finalized_at && <span>Executed {fmtDate(a.finalized_at)}</span>}
                </div>
              </div>

              <div class="flex flex-col items-end gap-3 shrink-0">
                <div class="flex gap-2">
                  <a href={`/portal/admin/agreements/${a.id}`} class="px-3 py-1.5 bg-neutral-800/50 border border-white/10 rounded-md text-xs text-neutral-300 hover:bg-neutral-700/50 hover:text-neutral-100 transition-colors">Manage</a>
                  <a href={`/portal/contracts/${a.slug}`} target="_blank" rel="noopener" class="px-3 py-1.5 bg-neutral-800/50 border border-white/10 rounded-md text-xs text-neutral-300 hover:bg-neutral-700/50 hover:text-neutral-100 transition-colors">View</a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="text-sm text-neutral-500">No agreements yet.</p>
        <p class="text-xs text-neutral-400 mt-2">Issue one from a finalized proposal above, or start a new blank agreement.</p>
      </div>
    )}
  </div>
</Portal>
