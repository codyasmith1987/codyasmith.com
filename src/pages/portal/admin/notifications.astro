---
import Portal from '../../../layouts/Portal.astro';
export const prerender = false;
---

<Portal title="Notifications">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-10">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Notifications</h1>
      </div>
      <button id="mark-all-read" class="text-xs text-neutral-500 hover:text-amber-600 transition-colors hidden">Mark all read</button>
    </div>

    <div id="notif-loading" class="text-center py-16">
      <p class="text-sm text-neutral-400">Loading...</p>
    </div>

    <div id="notif-empty" class="text-center py-16 hidden">
      <p class="font-serif text-xl text-neutral-100 mb-2">All caught up</p>
      <p class="text-sm text-neutral-500">No notifications right now.</p>
    </div>

    <div id="notif-list" class="space-y-2 hidden"></div>
  </div>

  <script>
    function escapeHtml(s: any): string {
      if (s == null) return '';
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
    const list = document.getElementById('notif-list')!;
    const loading = document.getElementById('notif-loading')!;
    const empty = document.getElementById('notif-empty')!;
    const markAllBtn = document.getElementById('mark-all-read')!;

    const typeIcons: Record<string, string> = {
      approval_requested: '\u{1F4CB}',
      approval_responded: '\u2705',
      milestone_completed: '\u{1F3C1}',
      invoice_sent: '\u{1F4E8}',
      payment_received: '\u{1F4B0}',
      change_order_submitted: '\u{1F4DD}',
      change_order_approved: '\u2705',
      task_completed: '\u2714',
      data_update_requested: '\u{1F504}',
      document_issued: '\u{1F4C4}',
      general: '\u{1F514}',
    };

    async function loadNotifications() {
      try {
        const res = await fetch('/portal/api/notifications/', {
          headers: { Cookie: document.cookie },
        });
        const notifications = await res.json();
        loading.classList.add('hidden');

        if (!notifications.length) {
          empty.classList.remove('hidden');
          return;
        }

        const hasUnread = notifications.some((n: any) => !n.read);
        if (hasUnread) markAllBtn.classList.remove('hidden');

        list.innerHTML = notifications.map((n: any) => `
          <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-start gap-4 ${n.read ? 'opacity-50' : ''}" data-notif-id="${escapeHtml(n.id)}">
            <span class="text-lg shrink-0">${escapeHtml(typeIcons[n.type] || typeIcons.general)}</span>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <p class="text-sm font-medium text-neutral-200 line-clamp-2">${escapeHtml(n.title)}</p>
                ${!n.read ? `<button data-mark-read="${escapeHtml(n.id)}" class="text-[10px] text-neutral-400 hover:text-amber-600 transition-colors shrink-0">Mark read</button>` : ''}
              </div>
              ${n.body ? `<p class="text-xs text-neutral-500 mt-1">${escapeHtml(n.body)}</p>` : ''}
              <p class="text-[10px] text-neutral-500 mt-2">${escapeHtml(new Date(n.created_at).toLocaleString())}</p>
            </div>
          </div>
        `).join('');

        list.classList.remove('hidden');

        // Mark individual read
        list.querySelectorAll('[data-mark-read]').forEach(btn => {
          btn.addEventListener('click', async () => {
            await (window as any).__withButtonLoading(btn as HTMLButtonElement, 'Marking...', async () => {
              const id = (btn as HTMLElement).dataset.markRead;
              await fetch('/portal/api/notifications/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
                body: JSON.stringify({ id }),
              });
              const row = document.querySelector(`[data-notif-id="${id}"]`);
              if (row) row.classList.add('opacity-50');
              btn.remove();
              (window as any).__toast({ type: 'success', message: 'Marked as read' });
            });
          });
        });
      } catch {
        loading.innerHTML = '<p class="text-sm text-red-400">Failed to load notifications.</p>';
      }
    }

    // Mark all read
    markAllBtn.addEventListener('click', async () => {
      await (window as any).__withButtonLoading(markAllBtn as HTMLButtonElement, 'Marking...', async () => {
        await fetch('/portal/api/notifications/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ all: true }),
        });
        (window as any).__toast({ type: 'success', message: 'All marked as read' });
        setTimeout(() => location.reload(), 600);
      });
    });

    loadNotifications();
  </script>
</Portal>
