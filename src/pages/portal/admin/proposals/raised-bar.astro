---
import Portal from '../../../../layouts/Portal.astro';
import {
  getClientBySlug,
  getUserByEmail,
  createClient,
  createUser,
  createMagicLink,
} from '../../../../lib/auth';
import { validateCsrfToken } from '../../../../lib/csrf';
import { logger } from '../../../../lib/logger';
import { escapeHtml, stripCRLF } from '../../../../lib/email-safety';

export const prerender = false;

const user = Astro.locals.user;
const csrfToken = Astro.locals.csrfToken || '';
if (!user || user.role !== 'admin') {
  return Astro.redirect('/portal/dashboard');
}

const CLIENT_NAME = 'Raised Bar Group';
const CLIENT_SLUG = 'raised-bar-group';
const SIGNERS = [
  { name: 'Jason Roth', email: 'jasonroth1122@gmail.com' },
  { name: 'Kevin Adams', email: 'kevo.adams@gmail.com' },
];

type ActionResult = {
  ok: boolean;
  message: string;
  details?: string[];
};

let actionResult: ActionResult | null = null;

// Handle POST for provisioning + invite actions
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const submittedCsrf = formData.get('csrf-token')?.toString() || '';
    if (!validateCsrfToken(Astro.locals.session!.id, submittedCsrf)) {
      actionResult = { ok: false, message: 'CSRF validation failed. Reload and try again.' };
    } else {
      const action = formData.get('action')?.toString();
      const details: string[] = [];

      if (action === 'provision' || action === 'provision-and-invite') {
        // Ensure client exists
        let client = await getClientBySlug(CLIENT_SLUG);
        if (!client) {
          await createClient(CLIENT_NAME, CLIENT_SLUG);
          client = await getClientBySlug(CLIENT_SLUG);
          details.push(`Created client: ${CLIENT_NAME}`);
        } else {
          details.push(`Client already exists: ${CLIENT_NAME}`);
        }

        // Ensure users exist
        for (const signer of SIGNERS) {
          let existing = await getUserByEmail(signer.email);
          if (!existing) {
            await createUser(signer.email, signer.name, 'client', client!.id);
            details.push(`Created user: ${signer.name} (${signer.email})`);
          } else {
            details.push(`User already exists: ${signer.name} (${signer.email})`);
          }
        }

        // Send invites if requested
        if (action === 'provision-and-invite') {
          const brevoKey = import.meta.env.BREVO_API_KEY;
          const origin = import.meta.env.SITE || new URL(Astro.request.url).origin;

          for (const signer of SIGNERS) {
            const userRow = await getUserByEmail(signer.email);
            if (!userRow) {
              details.push(`Could not find ${signer.name} after creation; skipping invite.`);
              continue;
            }
            const token = await createMagicLink(userRow.id);
            const loginUrl = `${origin}/portal/auth/verify?token=${token}`;

            if (brevoKey) {
              try {
                const res = await fetch('https://api.brevo.com/v3/smtp/email', {
                  method: 'POST',
                  headers: {
                    'api-key': brevoKey,
                    'content-type': 'application/json',
                  },
                  body: JSON.stringify({
                    sender: { name: 'Cody Smith', email: 'cody@codyasmith.com' },
                    to: [{ email: signer.email, name: stripCRLF(signer.name) }],
                    subject: stripCRLF('Your engagement proposal is ready'),
                    htmlContent: `
                      <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; max-width: 480px; margin: 0 auto; padding: 40px 20px;">
                        <h2 style="color: #171717; margin-bottom: 16px;">Hey ${escapeHtml(signer.name.split(' ')[0])},</h2>
                        <p style="color: #525252; line-height: 1.6; margin-bottom: 12px;">
                          Your engagement proposal is ready in the portal at codyasmith.com. The portal is also where invoices, deliverables, and project status will live once we're working together.
                        </p>
                        <p style="color: #525252; line-height: 1.6; margin-bottom: 24px;">
                          Click below to log in. You'll be asked to set a password on first arrival. This link expires in 15 minutes; if it times out, just enter your email on the login page for a new one.
                        </p>
                        <a href="${escapeHtml(loginUrl)}" style="display: inline-block; background: #f59e0b; color: #0a0a0a; padding: 12px 24px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 14px;">
                          Log in to your Portal
                        </a>
                        <p style="color: #525252; line-height: 1.6; margin-top: 32px; font-size: 14px;">
                          Once you're in, your proposal is in the sidebar under "Proposals → Raised Bar."
                        </p>
                        <p style="color: #a3a3a3; font-size: 12px; margin-top: 24px;">
                          <a href="https://codyasmith.com" style="color: #a3a3a3;">codyasmith.com</a>
                        </p>
                      </div>
                    `,
                  }),
                });
                if (res.ok) {
                  details.push(`Sent invite to ${signer.name} (${signer.email})`);
                } else {
                  const errBody = await res.text();
                  details.push(`Brevo error for ${signer.email}: ${res.status} ${errBody.slice(0, 200)}`);
                }
              } catch (err: any) {
                details.push(`Send error for ${signer.email}: ${err?.message || String(err)}`);
              }
            } else {
              details.push(`No BREVO_API_KEY; manual link for ${signer.name}: ${loginUrl}`);
            }
          }
        }

        actionResult = {
          ok: true,
          message: action === 'provision-and-invite'
            ? 'Provision and invite complete.'
            : 'Provision complete (no invites sent).',
          details,
        };
      } else {
        actionResult = { ok: false, message: 'Unknown action.' };
      }
    }
  } catch (err: any) {
    logger.error('Seed Raised Bar error', err);
    actionResult = { ok: false, message: `Server error: ${err?.message || String(err)}` };
  }
}

// Current state for display
const client = await getClientBySlug(CLIENT_SLUG);
const jasonRow = await getUserByEmail(SIGNERS[0].email);
const kevinRow = await getUserByEmail(SIGNERS[1].email);

const allProvisioned = !!client && !!jasonRow && !!kevinRow;
---

<Portal title="Raised Bar Proposal (Admin)">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin · Proposals</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Raised Bar</h1>
      <p class="text-neutral-500 text-sm mt-3">Jason Roth and Kevin Adams. Proposal at <a class="text-amber-400 hover:text-amber-300" href="/portal/proposals/raised-bar">/portal/proposals/raised-bar</a>.</p>
    </div>

    {actionResult && (
      <div class:list={[
        'mb-8 p-5 rounded-xl border',
        actionResult.ok ? 'bg-emerald-500/5 border-emerald-500/20' : 'bg-red-500/5 border-red-500/20',
      ]}>
        <p class:list={['text-sm font-medium mb-2', actionResult.ok ? 'text-emerald-400' : 'text-red-400']}>
          {actionResult.message}
        </p>
        {actionResult.details && actionResult.details.length > 0 && (
          <ul class="text-xs text-neutral-400 font-mono space-y-1">
            {actionResult.details.map(d => <li>{d}</li>)}
          </ul>
        )}
      </div>
    )}

    <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-8">
      <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-5">Current state</p>
      <div class="space-y-3 text-sm">
        <div class="flex items-center justify-between">
          <span class="text-neutral-300">Client: {CLIENT_NAME}</span>
          <span class:list={['text-[10px] font-mono uppercase px-2.5 py-1 rounded-full', client ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500']}>
            {client ? 'Exists' : 'Missing'}
          </span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-neutral-300">{SIGNERS[0].name} ({SIGNERS[0].email})</span>
          <span class:list={['text-[10px] font-mono uppercase px-2.5 py-1 rounded-full', jasonRow ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500']}>
            {jasonRow ? 'Exists' : 'Missing'}
          </span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-neutral-300">{SIGNERS[1].name} ({SIGNERS[1].email})</span>
          <span class:list={['text-[10px] font-mono uppercase px-2.5 py-1 rounded-full', kevinRow ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500']}>
            {kevinRow ? 'Exists' : 'Missing'}
          </span>
        </div>
      </div>
    </div>

    <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8">
      <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-5">Actions</p>

      <form method="POST" class="space-y-4">
        <input type="hidden" name="csrf-token" value={csrfToken} />

        <button
          type="submit"
          name="action"
          value="provision-and-invite"
          class="block w-full px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300"
        >
          {allProvisioned ? 'Re-send invite emails to Jason and Kevin' : 'Provision client + users AND send invite emails'}
        </button>

        <button
          type="submit"
          name="action"
          value="provision"
          class="block w-full px-6 py-3 bg-neutral-800 border border-white/10 text-neutral-300 font-medium text-sm rounded-lg hover:border-amber-500/40 hover:text-amber-400 transition-all duration-300"
        >
          {allProvisioned ? 'Records already in place (no-op)' : 'Provision client + users only (no emails)'}
        </button>
      </form>

      <p class="text-xs text-neutral-600 mt-6">
        Provisioning is idempotent. Existing records are not overwritten. Invite emails generate a fresh magic link each send and replace prior unused links.
      </p>
    </div>
  </div>
</Portal>
