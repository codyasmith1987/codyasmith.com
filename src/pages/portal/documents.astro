---
// Client-facing documents aggregator. Lists agreements, finalized
// proposals, and data references in one place. Peer to /portal/files
// (which holds ad-hoc Cody uploads); this page lists system-generated
// records the client should be able to find.

import Portal from '../../layouts/Portal.astro';
import ClientSelector from '../../components/portal/ClientSelector.astro';
import { listAgreementsForClient } from '../../lib/agreements';
import { getIssuedReportsForClient, fileCategoryLabel } from '../../lib/storage';
import { listManagedSites } from '../../lib/client-sites';
import { getAllClients } from '../../lib/auth';
import turso from '../../lib/turso';

export const prerender = false;

const user = Astro.locals.user;
if (!user) return Astro.redirect('/portal/login');

const isAdmin = user.role === 'admin';
const clients = isAdmin ? await getAllClients() : [];
// A client sees their own documents; an admin views any client's via
// ?client_id, switching inline with the selector (peer to the live pages).
const clientId = isAdmin ? (Astro.url.searchParams.get('client_id') || null) : user.client_id;
let agreements: Array<{ slug: string; title: string; status: string; finalized_at: string | null; issued_at: string | null; created_at: string; pdf_file_id: string | null; }> = [];
let proposals: Array<{ slug: string; title: string; finalized_at: string | null; status: string }> = [];
type Report = Awaited<ReturnType<typeof getIssuedReportsForClient>>[number];
let reports: Report[] = [];
// Issued reports grouped by reporting month (newest first), then by site for
// multi-site clients. A null site_id is engagement-level (spans all sites,
// e.g. Strategic Recommendations).
let reportGroups: Array<{ month: string; sites: Array<{ key: string; label: string; reports: Report[] }> }> = [];
let reportsMultiSite = false;

if (clientId) {
  reports = await getIssuedReportsForClient(clientId);

  const managedSites = await listManagedSites(clientId);
  reportsMultiSite = managedSites.length > 1;
  const byMonth = new Map<string, Report[]>();
  for (const r of reports) {
    const arr = byMonth.get(r.month) || [];
    arr.push(r);
    byMonth.set(r.month, arr);
  }
  reportGroups = [...byMonth.keys()].sort().reverse().map(month => {
    const monthReports = byMonth.get(month)!;
    if (!reportsMultiSite) return { month, sites: [{ key: 'all', label: '', reports: monthReports }] };
    const bySite = new Map<string, Report[]>();
    for (const r of monthReports) {
      const key = r.site_id || 'engagement';
      const arr = bySite.get(key) || [];
      arr.push(r);
      bySite.set(key, arr);
    }
    const siteGroups: Array<{ key: string; label: string; reports: Report[] }> = [];
    for (const s of managedSites) {
      const rs = bySite.get(s.id);
      if (rs) siteGroups.push({ key: s.id, label: s.label || s.domain, reports: rs });
    }
    const eng = bySite.get('engagement');
    if (eng) siteGroups.push({ key: 'engagement', label: 'All sites', reports: eng });
    for (const [k, rs] of bySite) {
      if (k !== 'engagement' && !managedSites.find(s => s.id === k)) siteGroups.push({ key: k, label: 'Other', reports: rs });
    }
    return { month, sites: siteGroups };
  });

  const list = await listAgreementsForClient(clientId);
  agreements = list
    .filter(a => ['issued', 'partially_signed', 'executed'].includes(a.status))
    .map(a => ({
      slug: a.slug,
      title: a.title,
      status: a.status,
      finalized_at: a.finalized_at,
      issued_at: a.issued_at,
      created_at: a.created_at,
      pdf_file_id: a.pdf_file_id,
    }));
  const proposalsResult = await turso.execute({
    sql: `SELECT slug, title, finalized_at, status FROM proposals WHERE client_id = ? AND finalized_at IS NOT NULL ORDER BY finalized_at DESC`,
    args: [clientId],
  });
  proposals = (proposalsResult.rows as any[]).map(r => ({
    slug: r[0] as string,
    title: r[1] as string,
    finalized_at: r[2] as string | null,
    status: r[3] as string,
  }));
}

function fmtDate(s: string | null): string {
  if (!s) return '';
  const d = new Date(s.includes('T') ? s : s.replace(' ', 'T') + 'Z');
  if (isNaN(d.getTime())) return s;
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function fmtMonth(month: string): string {
  const d = new Date(month + '-01T00:00:00Z');
  if (isNaN(d.getTime())) return month;
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', timeZone: 'UTC' });
}

// Client-facing status labels: never show the raw DB enum to a client.
const agreementStatusLabel: Record<string, string> = {
  issued: 'Ready to sign',
  partially_signed: 'Awaiting the other signer',
  executed: 'Fully executed',
};
const proposalStatusLabel: Record<string, string> = {
  finalized: 'Accepted',
  published: 'Ready to review',
  draft: 'Draft',
};

const statusBadge: Record<string, string> = {
  draft: 'bg-neutral-700/30 text-neutral-400',
  issued: 'bg-blue-500/10 text-blue-400',
  partially_signed: 'bg-amber-500/10 text-amber-600',
  executed: 'bg-emerald-500/10 text-emerald-400',
  revoked: 'bg-amber-500/10 text-amber-600',
  voided: 'bg-red-500/10 text-red-400',
  finalized: 'bg-emerald-500/10 text-emerald-400',
};

function formatBytes(bytes: number): string {
  if (bytes < 1024) return bytes + ' B';
  if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
  return (bytes / 1048576).toFixed(1) + ' MB';
}

const empty = agreements.length === 0 && proposals.length === 0 && reports.length === 0;
---
<Portal title="Documents">
  <div class="max-w-4xl mx-auto">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <p class="text-amber-600 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Deliverables</p>
        <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Documents</h1>
        <p class="text-sm text-neutral-500 mt-2">Your agreements, proposals, and reports.</p>
      </div>
      {isAdmin && <ClientSelector clients={clients} />}
    </div>

    {isAdmin && !clientId && (
      <div class="p-6 bg-neutral-900/30 border border-white/5 rounded-xl text-sm text-neutral-400">
        Pick a client above to see their documents.
      </div>
    )}

    {clientId && empty && (
      <div class="text-center py-16">
        <p class="text-sm text-neutral-500">No documents yet.</p>
        <p class="text-xs text-neutral-400 mt-2">Your agreements, proposals, and reports will appear here as they're added.</p>
      </div>
    )}

    {clientId && reportGroups.length > 0 && (
      <div class="mb-10">
        <h2 class="text-xs font-mono uppercase tracking-[0.18em] text-amber-600 mb-4">Reports</h2>
        <div class="space-y-8">
          {reportGroups.map(group => (
            <div>
              <p class="text-[11px] font-mono uppercase tracking-[0.15em] text-neutral-300 mb-3">{fmtMonth(group.month)}</p>
              <div class="space-y-4">
                {group.sites.map(site => (
                  <div>
                    {reportsMultiSite && site.label && (
                      <p class="text-[10px] font-mono uppercase tracking-wide text-neutral-500 mb-2 ml-1">{site.label}</p>
                    )}
                    <div class="space-y-2">
                      {site.reports.map(r => (
                        <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 group hover:border-white/10 transition-all duration-300">
                          <div class="flex items-start justify-between gap-4">
                            <div class="min-w-0 flex-1">
                              <div class="flex items-baseline gap-3 flex-wrap">
                                <p class="text-sm font-medium text-neutral-200">{r.original_name}</p>
                                <span class="px-2 py-0.5 text-[10px] font-mono uppercase rounded bg-blue-500/10 text-blue-400">{fileCategoryLabel(r.category)}</span>
                              </div>
                              <div class="flex items-center gap-4 mt-2 text-[10px] font-mono text-neutral-500">
                                <span>Issued {fmtDate(r.issued_at)}</span>
                                <span>{formatBytes(r.size_bytes)}</span>
                              </div>
                            </div>
                            <a href={`/portal/api/files/download?id=${r.id}`} class="px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 rounded-md text-xs text-emerald-400 hover:bg-emerald-500/20 transition-colors shrink-0">Download</a>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {clientId && agreements.length > 0 && (
      <div class="mb-10">
        <h2 class="text-xs font-mono uppercase tracking-[0.18em] text-amber-600 mb-4">Agreements</h2>
        <div class="space-y-3">
          {agreements.map(a => (
            <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 group hover:border-white/10 transition-all duration-300">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <p class="text-sm font-medium text-neutral-200">{a.title}</p>
                    <span class={`px-2 py-0.5 text-[10px] font-mono uppercase rounded ${statusBadge[a.status] || statusBadge.draft}`}>{agreementStatusLabel[a.status] || a.status}</span>
                  </div>
                  <div class="flex items-center gap-4 mt-2 text-[10px] font-mono text-neutral-500">
                    {a.finalized_at && <span>Executed {fmtDate(a.finalized_at)}</span>}
                    {!a.finalized_at && a.issued_at && <span>Issued {fmtDate(a.issued_at)}</span>}
                    {!a.finalized_at && !a.issued_at && <span>Created {fmtDate(a.created_at)}</span>}
                  </div>
                </div>
                <div class="flex flex-col items-end gap-2 shrink-0">
                  <a href={`/portal/contracts/${a.slug}`} class="px-3 py-1.5 bg-neutral-800/50 border border-white/10 rounded-md text-xs text-neutral-300 hover:bg-neutral-700/50 hover:text-neutral-100 transition-colors">View</a>
                  {a.pdf_file_id && (
                    <a href={`/portal/api/files/download?id=${a.pdf_file_id}`} class="px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/30 rounded-md text-xs text-emerald-400 hover:bg-emerald-500/20 transition-colors">Download PDF</a>
                  )}
                  {!a.pdf_file_id && a.status === 'executed' && (
                    <span class="px-3 py-1.5 text-[10px] font-mono text-amber-500/80" title="The PDF could not be generated when this was executed. Contact Cody to have it regenerated.">PDF unavailable</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}

    {clientId && proposals.length > 0 && (
      <div class="mb-10">
        <h2 class="text-xs font-mono uppercase tracking-[0.18em] text-amber-600 mb-4">Proposals</h2>
        <div class="space-y-3">
          {proposals.map(p => (
            <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 group hover:border-white/10 transition-all duration-300">
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-3 flex-wrap">
                    <p class="text-sm font-medium text-neutral-200">{p.title}</p>
                    <span class={`px-2 py-0.5 text-[10px] font-mono uppercase rounded ${statusBadge[p.status] || statusBadge.draft}`}>{proposalStatusLabel[p.status] || p.status}</span>
                  </div>
                  <div class="flex items-center gap-4 mt-2 text-[10px] font-mono text-neutral-500">
                    {p.finalized_at && <span>Accepted {fmtDate(p.finalized_at)}</span>}
                  </div>
                </div>
                <a href={`/portal/proposals/${p.slug}`} class="px-3 py-1.5 bg-neutral-800/50 border border-white/10 rounded-md text-xs text-neutral-300 hover:bg-neutral-700/50 hover:text-neutral-100 transition-colors">View</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  {isAdmin && (
    <script define:vars={{ current: clientId || '' }}>
      // Admin client switch: server-rendered page, so navigate with the
      // selected client_id. Preselect the one currently in view.
      const sel = document.getElementById('client-selector');
      if (sel) {
        if (current) sel.value = current;
        sel.addEventListener('change', (e) => {
          const id = e.target.value;
          window.location.href = id ? `/portal/documents?client_id=${encodeURIComponent(id)}` : '/portal/documents';
        });
      }
    </script>
  )}
</Portal>
