---
interface Props {
  id?: string;
  title?: string;
  message: string;
  actionHref?: string;
  actionLabel?: string;
}

const {
  id = 'empty-state',
  title = 'Nothing here yet',
  message,
  actionHref,
  actionLabel,
} = Astro.props;
---

<div id={id} class="hidden text-center py-24">
  <p class="font-serif text-2xl text-neutral-100 mb-3">{title}</p>
  <p class="text-sm text-neutral-300 leading-relaxed max-w-xs mx-auto mb-8">{message}</p>
  {actionHref && actionLabel && (
    <a
      href={actionHref}
      class="inline-flex items-center justify-center px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]"
    >
      {actionLabel}
    </a>
  )}
</div>
