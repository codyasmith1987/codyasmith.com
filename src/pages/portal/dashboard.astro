---
import Portal from '../../layouts/Portal.astro';
import { getAllClients } from '../../lib/auth';
export const prerender = false;

const user = Astro.locals.user!;
const isAdmin = user.role === 'admin';
const clients = isAdmin ? await getAllClients() : [];
---

<Portal title="Dashboard">
  <style>
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes countUp {
      from { opacity: 0; transform: scale(0.8); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes pulseGlow {
      0%, 100% { box-shadow: 0 0 0 0 var(--glow-color); }
      50% { box-shadow: 0 0 40px 4px var(--glow-color); }
    }
    .story-section {
      opacity: 0;
      animation: fadeUp 0.6s ease-out forwards;
    }
    .story-section:nth-child(2) { animation-delay: 0.15s; }
    .story-section:nth-child(3) { animation-delay: 0.3s; }
    .story-section:nth-child(4) { animation-delay: 0.45s; }
    .score-glow {
      animation: pulseGlow 3s ease-in-out 1.8s 1;
    }
    .trophy-row {
      opacity: 0;
      animation: fadeUp 0.4s ease-out forwards;
    }
    .sim-result {
      opacity: 0;
      animation: fadeUp 0.35s ease-out forwards;
    }
    .checkup-card {
      opacity: 0;
      animation: fadeUp 0.4s ease-out forwards;
    }
  </style>

  <div class="max-w-2xl mx-auto">
    <div class="flex items-center justify-between mb-10">
      <p id="data-date" class="text-[10px] font-mono text-neutral-700 tracking-[0.15em] uppercase"></p>
      {isAdmin && clients.length > 0 && (
        <select id="client-selector" class="px-3 py-2 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-400 text-xs focus:outline-none focus:border-amber-500/30 transition-colors duration-300">
          {clients.map(c => <option value={c.id}>{c.name}</option>)}
        </select>
      )}
    </div>

    <div id="story" class="hidden">

      <!-- ═══════ CHAPTER 1: THE VERDICT ═══════ -->
      <section class="story-section mb-20">
        <div class="flex flex-col items-center text-center">
          <div id="score-wrap" class="relative w-44 h-44 mb-8 score-glow rounded-full" style="--glow-color: rgba(16,185,129,0);">
            <canvas id="score-ring"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span id="score-number" class="text-5xl font-bold tracking-tight" style="animation: countUp 0.8s ease-out 0.6s both;"></span>
            </div>
          </div>
          <h1 id="verdict" class="text-2xl md:text-3xl font-serif text-neutral-100 leading-snug mb-4 max-w-md"></h1>
          <p id="verdict-sub" class="text-sm text-neutral-500 leading-relaxed max-w-sm"></p>
        </div>
      </section>

      <!-- ═══════ CHAPTER 2: GOOGLE ═══════ -->
      <section class="story-section mb-20">
        <p class="text-[11px] text-neutral-600 tracking-widest uppercase mb-8 text-center">How people find you on Google</p>

        <!-- Simulated search -->
        <div id="search-sim" class="rounded-2xl overflow-hidden mb-8 border border-white/[0.04]">
          <!-- Search bar -->
          <div class="bg-neutral-900/80 px-5 py-4 flex items-center gap-3">
            <svg class="w-4 h-4 text-neutral-600 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <span id="sim-query" class="text-sm text-neutral-300"></span>
          </div>
          <!-- Results -->
          <div id="sim-results" class="bg-neutral-950/60 px-5 py-4 space-y-3"></div>
        </div>

        <!-- Wins — horizontal stat bar -->
        <div class="grid grid-cols-3 gap-2 mb-8">
          <div class="relative overflow-hidden bg-gradient-to-b from-emerald-500/[0.07] to-transparent border border-emerald-500/10 rounded-xl p-5 text-center">
            <p id="win-top3" class="text-3xl font-bold text-emerald-400 mb-1">0</p>
            <p class="text-[10px] text-emerald-400/50 leading-tight">searches where<br/>you're #1, #2, or #3</p>
          </div>
          <div class="relative overflow-hidden bg-gradient-to-b from-amber-500/[0.05] to-transparent border border-amber-500/10 rounded-xl p-5 text-center">
            <p id="win-page1" class="text-3xl font-bold text-amber-400 mb-1">0</p>
            <p class="text-[10px] text-amber-400/50 leading-tight">searches where you<br/>show up on page 1</p>
          </div>
          <div class="relative overflow-hidden bg-gradient-to-b from-neutral-400/[0.04] to-transparent border border-white/5 rounded-xl p-5 text-center">
            <p id="win-reach" class="text-3xl font-bold text-neutral-200 mb-1">0</p>
            <p class="text-[10px] text-neutral-500 leading-tight">people searching<br/>for these each month</p>
          </div>
        </div>

        <!-- Best keywords -->
        <div class="space-y-1" id="trophies"></div>

        <div class="text-center mt-5">
          <a href="/portal/keywords" class="text-[11px] text-neutral-600 hover:text-amber-400 transition-colors tracking-wide">ALL KEYWORDS →</a>
        </div>
      </section>

      <!-- ═══════ CHAPTER 3: CHECKUP ═══════ -->
      <section class="story-section mb-16">
        <p class="text-[11px] text-neutral-600 tracking-widest uppercase mb-8 text-center">Your website checkup</p>

        <div id="checkup" class="grid grid-cols-2 gap-3"></div>

        <div class="text-center mt-5">
          <a href="/portal/health" class="text-[11px] text-neutral-600 hover:text-amber-400 transition-colors tracking-wide">FULL REPORT →</a>
        </div>
      </section>

    </div>

    <!-- Loading state -->
    <div id="loading-state" class="text-center py-24">
      <div class="inline-block w-8 h-8 border-2 border-neutral-800 border-t-amber-500 rounded-full animate-spin mb-5"></div>
      <p class="text-sm text-neutral-600">Loading your dashboard...</p>
    </div>

    <!-- Error state -->
    <div id="error-state" class="hidden text-center py-24">
      <p class="font-serif text-2xl text-neutral-100 mb-3">Something went wrong</p>
      <p id="error-detail" class="text-sm text-neutral-500 mb-8 leading-relaxed"></p>
      <button onclick="loadDashboard()" class="px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]">Retry</button>
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-24">
      <p class="font-serif text-2xl text-neutral-100 mb-3">Nothing here yet</p>
      <p class="text-sm text-neutral-500 leading-relaxed max-w-xs mx-auto mb-8">Once we upload your first round of data, this is where your full report lives.</p>
      {isAdmin && (
        <a href="/portal/admin/csv" class="inline-flex items-center justify-center px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]">
          Upload CSVs
        </a>
      )}
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script define:vars={{ clientId: user.client_id, isAdmin, firstClientId: clients[0]?.id || '' }}>
    let activeClientId = isAdmin ? firstClientId : clientId;
    let scoreChart = null;

    const selector = document.getElementById('client-selector');
    if (selector) {
      selector.addEventListener('change', (e) => {
        activeClientId = e.target.value;
        loadDashboard();
      });
    }

    const CATS = [
      { key: 'images', label: 'Images', icon: '📸', ok: 'All images are optimized and accessible.', match: n => /^image/i.test(n) },
      { key: 'content', label: 'Content', icon: '📝', ok: 'Titles, headings, and descriptions are solid.', match: n => /^(h1|h2|content|meta|page title)/i.test(n) },
      { key: 'links', label: 'Links', icon: '🔗', ok: 'All links are working and well-structured.', match: n => /^(link|response)/i.test(n) },
      { key: 'security', label: 'Security', icon: '🔒', ok: 'Security headers are properly configured.', match: n => /^security/i.test(n) },
    ];

    // Friendly issue summaries
    const FRIENDLY = {
      'images': {
        high: 'Some images are causing real problems — broken, way too large, or completely inaccessible.',
        med: 'A number of images could be better — smaller files, better descriptions.',
        low: 'Small image tweaks. Nothing urgent.',
      },
      'content': {
        high: 'Page titles or headings have structural issues that confuse Google.',
        med: 'Some pages need better titles or descriptions to rank well.',
        low: 'Minor heading and content cleanups.',
      },
      'links': {
        high: 'Broken links on your site — visitors and Google are hitting dead ends.',
        med: 'Some links need cleanup or better anchor text.',
        low: 'Minor link housekeeping.',
      },
      'security': {
        high: 'Missing security settings that protect your visitors.',
        med: 'Some browser security headers should be added.',
        low: 'Optional security enhancements.',
      },
    };

    function computeScore(kws, issues) {
      let s = 50;
      if (kws.length > 0) {
        s += Math.round((kws.filter(k => k.position <= 10).length / kws.length) * 30);
        s += Math.round((kws.filter(k => k.position <= 3).length / kws.length) * 20);
      }
      const h = issues.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;
      const m = issues.filter(i => (i.priority||'').toLowerCase() === 'medium').length;
      s -= Math.min(30, h * 10 + m * 3);
      return Math.max(0, Math.min(100, s));
    }

    function scoreColor(s) {
      if (s >= 75) return '#10b981';
      if (s >= 50) return '#fbbf24';
      return '#ef4444';
    }

    async function loadDashboard() {
      const loadingEl = document.getElementById('loading-state');
      const errorEl = document.getElementById('error-state');
      const errorDetail = document.getElementById('error-detail');

      loadingEl.classList.remove('hidden');
      errorEl.classList.add('hidden');
      document.getElementById('empty-state').classList.add('hidden');
      document.getElementById('story').classList.add('hidden');

      if (!activeClientId) {
        loadingEl.classList.add('hidden');
        document.getElementById('empty-state').classList.remove('hidden');
        return;
      }

      try {
        const qs = `?client_id=${activeClientId}`;
        const [sumR, kwR, isR] = await Promise.all([
          fetch('/portal/api/dashboard/summary' + qs),
          fetch('/portal/api/dashboard/keywords' + qs + '&limit=200'),
          fetch('/portal/api/dashboard/issues' + qs),
        ]);

        if (!sumR.ok || !kwR.ok || !isR.ok) throw new Error('Failed to load dashboard data');

        const summary = await sumR.json();
        const kwData = await kwR.json();
        const isData = await isR.json();

        const kws = (kwData.keywords || []).filter(k => k.position);
        const issues = isData.issues || [];

        loadingEl.classList.add('hidden');

        if (!kws.length && !issues.length) {
          document.getElementById('empty-state').classList.remove('hidden');
          document.getElementById('story').classList.add('hidden');
          return;
        }
        document.getElementById('empty-state').classList.add('hidden');
        document.getElementById('story').classList.remove('hidden');

      const month = summary.current_month || kwData.month;
      if (month) {
        document.getElementById('data-date').textContent =
          new Date(month + '-01').toLocaleDateString('en-US', { year: 'numeric', month: 'long' });
      }

      const score = computeScore(kws, issues);
      const color = scoreColor(score);
      const page1 = kws.filter(k => k.position <= 10).length;
      const top3 = kws.filter(k => k.position <= 3).length;
      const highIss = issues.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;

      // ── CHAPTER 1 ──
      const sn = document.getElementById('score-number');
      sn.textContent = score;
      sn.style.color = color;

      // Glow color
      const wrap = document.getElementById('score-wrap');
      const glowAlpha = score >= 75 ? '0.12' : score >= 50 ? '0.08' : '0.08';
      const glowRgb = score >= 75 ? '16,185,129' : score >= 50 ? '251,191,36' : '239,68,68';
      wrap.style.setProperty('--glow-color', `rgba(${glowRgb},${glowAlpha})`);

      let verdict, sub;
      if (score >= 80) {
        verdict = 'Your website is in excellent shape.';
        sub = 'People are finding you on Google, your site is technically sound, and you\'re ahead of most competitors in your space. Let\'s keep it there.';
      } else if (score >= 65) {
        verdict = 'Looking good. A few things to tighten up.';
        sub = 'You\'re showing up where it counts. Cleaning up the items below will push you further — these are quick wins, not overhauls.';
      } else if (score >= 45) {
        verdict = 'Solid foundation. Room to grow.';
        sub = 'The building blocks are in place. The issues flagged below are what\'s standing between you and stronger Google visibility.';
      } else {
        verdict = 'Let\'s get to work.';
        sub = 'There are a handful of real issues keeping your site from performing the way it should. Every one of them is fixable — that\'s what we\'re here for.';
      }
      document.getElementById('verdict').textContent = verdict;
      document.getElementById('verdict-sub').textContent = sub;

      const ctx = document.getElementById('score-ring');
      if (scoreChart) scoreChart.destroy();
      scoreChart = new Chart(ctx, {
        type: 'doughnut',
        data: { datasets: [{ data: [score, 100 - score], backgroundColor: [color, 'rgba(38,38,38,0.3)'], borderWidth: 0 }] },
        options: {
          cutout: '78%', responsive: true, maintainAspectRatio: true,
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          animation: { animateRotate: true, duration: 1500, easing: 'easeOutQuart' },
        },
      });

      // ── CHAPTER 2 ──
      if (kws.length > 0) {
        const best = kws[0];
        document.getElementById('sim-query').textContent = best.keyword;

        // Build search simulation
        const sim = document.getElementById('sim-results');
        const pos = best.position;
        let html = '';
        const showPositions = [];
        for (let i = 1; i <= Math.min(Math.max(pos + 1, 4), 8); i++) {
          if (i > 3 && i < pos - 1 && pos > 5) {
            if (!showPositions.includes('dots')) showPositions.push('dots');
          } else {
            showPositions.push(i);
          }
        }

        showPositions.forEach((p, idx) => {
          const delay = 0.8 + idx * 0.12;
          if (p === 'dots') {
            html += `<div class="sim-result text-center py-1" style="animation-delay:${delay}s"><span class="text-neutral-800">⋯</span></div>`;
            return;
          }
          const isYou = p === pos;
          if (isYou) {
            html += `
              <div class="sim-result rounded-lg border border-emerald-500/20 bg-emerald-500/[0.06] px-4 py-3" style="animation-delay:${delay}s">
                <p class="text-xs text-emerald-400/70 mb-0.5">${best.url ? best.url.replace('https://', '').replace(/\/$/, '') : 'yoursite.com'}</p>
                <p class="text-sm text-emerald-300 font-medium">${best.keyword.charAt(0).toUpperCase() + best.keyword.slice(1)} — Your Site</p>
                <p class="text-xs text-emerald-500/40 mt-0.5">This is you, position #${pos}</p>
              </div>`;
          } else {
            html += `
              <div class="sim-result px-4 py-2.5 opacity-25" style="animation-delay:${delay}s">
                <div class="h-2 bg-neutral-800 rounded w-32 mb-1.5"></div>
                <div class="h-2.5 bg-neutral-800/70 rounded w-52"></div>
              </div>`;
          }
        });
        sim.innerHTML = html;

        // Wins
        const totalVol = kws.filter(k => k.position <= 10).reduce((s, k) => s + (k.search_volume || 0), 0);
        document.getElementById('win-top3').textContent = top3;
        document.getElementById('win-page1').textContent = page1;
        document.getElementById('win-reach').textContent = totalVol > 1000 ? Math.round(totalVol / 1000) + 'k+' : totalVol.toLocaleString();

        // Trophies
        const medals = ['🥇','🥈','🥉'];
        document.getElementById('trophies').innerHTML = kws.slice(0, 8).map((k, i) => {
          const medal = k.position <= 3 ? (medals[k.position-1] || '🏅') : k.position <= 10 ? '✓' : '·';
          const isMedal = k.position <= 3;
          const isPg1 = k.position <= 10;
          const delay = 1.2 + i * 0.08;
          return `
            <div class="trophy-row flex items-center gap-3 py-2.5 px-4 rounded-lg ${isMedal ? 'bg-emerald-500/[0.04]' : ''}" style="animation-delay:${delay}s">
              <span class="${isMedal ? 'text-lg' : isPg1 ? 'text-xs text-emerald-500 font-bold' : 'text-xs text-neutral-700'} w-7 text-center shrink-0">${medal}</span>
              <p class="text-sm ${isPg1 ? 'text-neutral-200' : 'text-neutral-500'} flex-1 truncate">${k.keyword}</p>
              <span class="text-xs font-mono tabular-nums ${isMedal ? 'text-emerald-400' : isPg1 ? 'text-neutral-400' : 'text-neutral-600'} shrink-0">#${k.position}</span>
              ${k.search_volume ? `<span class="text-[10px] text-neutral-700 w-14 text-right shrink-0">${k.search_volume >= 1000 ? (k.search_volume/1000).toFixed(1)+'k' : k.search_volume}/mo</span>` : ''}
            </div>`;
        }).join('');
      }

      // ── CHAPTER 3 ──
      if (issues.length > 0) {
        document.getElementById('checkup').innerHTML = CATS.map((cat, ci) => {
          const ci2 = issues.filter(i => cat.match(i.issue_name));
          const h = ci2.filter(i => ['critical','high'].includes((i.priority||'').toLowerCase())).length;
          const m = ci2.filter(i => (i.priority||'').toLowerCase() === 'medium').length;
          const total = ci2.length;
          const delay = 1.4 + ci * 0.1;

          let status, statusColor, borderCol, bgCol, friendly;
          if (total === 0) {
            status = '✓ All clear';
            statusColor = 'text-emerald-400';
            borderCol = 'border-emerald-500/10';
            bgCol = 'bg-emerald-500/[0.03]';
            friendly = cat.ok;
          } else if (h > 0) {
            status = `${h + m} issue${(h+m) > 1 ? 's' : ''} found`;
            statusColor = 'text-red-400';
            borderCol = 'border-red-500/15';
            bgCol = 'bg-red-500/[0.03]';
            friendly = FRIENDLY[cat.key]?.high || '';
          } else if (m > 0) {
            status = `${m} to improve`;
            statusColor = 'text-amber-400';
            borderCol = 'border-amber-500/15';
            bgCol = 'bg-amber-500/[0.03]';
            friendly = FRIENDLY[cat.key]?.med || '';
          } else {
            status = '✓ Mostly good';
            statusColor = 'text-emerald-400/70';
            borderCol = 'border-white/5';
            bgCol = '';
            friendly = FRIENDLY[cat.key]?.low || '';
          }

          return `
            <div class="checkup-card border ${borderCol} ${bgCol} rounded-2xl p-6" style="animation-delay:${delay}s">
              <div class="flex items-center justify-between mb-4">
                <span class="text-2xl">${cat.icon}</span>
              </div>
              <p class="text-sm font-medium text-neutral-200 mb-1">${cat.label}</p>
              <p class="text-xs ${statusColor} font-medium mb-3">${status}</p>
              <p class="text-[11px] text-neutral-600 leading-relaxed">${friendly}</p>
            </div>`;
        }).join('');
      }
      } catch (err) {
        loadingEl.classList.add('hidden');
        errorDetail.textContent = err.message || 'Could not connect to the server. Please try again.';
        errorEl.classList.remove('hidden');
      }
    }

    loadDashboard();
  </script>
</Portal>
