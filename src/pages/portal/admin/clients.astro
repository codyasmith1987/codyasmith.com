---
import Portal from '../../../layouts/Portal.astro';
import { getAllClients } from '../../../lib/auth';
export const prerender = false;

const clients = await getAllClients();
---

<Portal title="Manage Clients">
  <div class="max-w-3xl mx-auto">
    <div class="mb-10">
      <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-3">Admin</p>
      <h1 class="font-serif text-3xl md:text-4xl text-neutral-100">Clients</h1>
    </div>

    <!-- Create client form -->
    <form id="create-client-form" class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8 mb-10">
      <p class="text-[10px] font-mono text-neutral-600 tracking-[0.15em] uppercase mb-5">Add new client</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="client-name" class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Business name</label>
          <input
            type="text"
            id="client-name"
            name="name"
            required
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="ZipKit Homes"
          />
        </div>
        <div>
          <label for="client-slug" class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Slug (URL-safe)</label>
          <input
            type="text"
            id="client-slug"
            name="slug"
            required
            pattern="[a-z0-9\-]+"
            class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm font-mono focus:outline-none focus:border-amber-500/30 transition-colors duration-300"
            placeholder="zipkit-homes"
          />
        </div>
      </div>
      <button type="submit" class="mt-6 px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300 hover:shadow-[0_0_30px_rgba(245,158,11,0.2)]">
        Create client
      </button>
      <p id="client-msg" class="mt-4 text-sm hidden"></p>
    </form>

    <!-- Client list -->
    {clients.length > 0 ? (
      <div class="space-y-3">
        {clients.map(client => (
          <div class="bg-neutral-900/30 border border-white/5 rounded-xl p-5 flex items-center justify-between group hover:border-white/10 transition-all duration-300" data-client-row={client.id}>
            <div>
              <p class="text-sm font-medium text-neutral-200">{client.name}</p>
              <p class="text-xs font-mono text-neutral-600 mt-0.5">{client.slug}</p>
            </div>
            <div class="flex items-center gap-3">
              {client.active && (
                <a
                  href={`/portal/dashboard?as_client=1&client_id=${encodeURIComponent(client.id)}`}
                  class="text-[11px] text-amber-400 hover:text-amber-300 tracking-wide font-mono transition-colors"
                >
                  view as client →
                </a>
              )}
              <span
                data-client-badge={client.id}
                class:list={[
                  'text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full',
                  client.active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500',
                ]}
              >
                {client.active ? 'Active' : 'Inactive'}
              </span>
              <button
                data-toggle-client={client.id}
                data-client-active={client.active ? '1' : '0'}
                class="text-xs text-neutral-600 hover:text-amber-400 transition-colors duration-300 opacity-0 group-hover:opacity-100"
              >
                {client.active ? 'Deactivate' : 'Activate'}
              </button>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <p class="font-serif text-xl text-neutral-100 mb-2">No clients yet</p>
        <p class="text-sm text-neutral-500">Create your first client above to get started.</p>
      </div>
    )}
  </div>

  <script>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    // Toggle active/inactive
    document.querySelectorAll('[data-toggle-client]').forEach(btn => {
      btn.addEventListener('click', async () => {
        const clientId = (btn as HTMLElement).dataset.toggleClient!;
        const isActive = (btn as HTMLElement).dataset.clientActive === '1';

        if (isActive) {
          const confirmed = await (window as any).__confirm({
            title: 'Deactivate client',
            message: 'Their users won\'t be able to log in while deactivated.',
            confirmLabel: 'Deactivate',
            danger: true,
          });
          if (!confirmed) return;
        }

        const res = await fetch('/portal/api/admin/toggle-client', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ client_id: clientId }),
        });

        if (res.ok) {
          const data = await res.json();
          const badge = document.querySelector(`[data-client-badge="${clientId}"]`)!;
          badge.textContent = data.active ? 'Active' : 'Inactive';
          badge.className = `text-[10px] font-mono tracking-wide uppercase px-2.5 py-1 rounded-full ${data.active ? 'bg-emerald-500/10 text-emerald-400' : 'bg-neutral-800 text-neutral-500'}`;
          (btn as HTMLElement).textContent = data.active ? 'Deactivate' : 'Activate';
          (btn as HTMLElement).dataset.clientActive = data.active ? '1' : '0';
        }
      });
    });

    const form = document.getElementById('create-client-form') as HTMLFormElement;
    const msg = document.getElementById('client-msg')!;
    const nameInput = document.getElementById('client-name') as HTMLInputElement;
    const slugInput = document.getElementById('client-slug') as HTMLInputElement;

    // Auto-generate slug from name
    nameInput.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = nameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      }
    });
    slugInput.addEventListener('input', () => { slugInput.dataset.manual = '1'; });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.classList.add('hidden');

      const res = await fetch('/portal/api/admin/create-client', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          name: nameInput.value.trim(),
          slug: slugInput.value.trim(),
        }),
      });

      const data = await res.json();
      if (res.ok) {
        msg.textContent = `Created "${data.name}"`;
        msg.className = 'mt-4 text-sm text-emerald-400';
        msg.classList.remove('hidden');
        form.reset();
        slugInput.dataset.manual = '';
        setTimeout(() => location.reload(), 800);
      } else {
        msg.textContent = data.error || 'Failed';
        msg.className = 'mt-4 text-sm text-red-400';
        msg.classList.remove('hidden');
      }
    });
  </script>
</Portal>
