---
import Portal from '../../../../layouts/Portal.astro';
import { getTask, getMilestone, getProject } from '../../../../lib/contracts';
export const prerender = false;

const { id } = Astro.params;
const task = await getTask(id!);
if (!task) return Astro.redirect('/portal/admin/contracts');

const milestone = await getMilestone(task.milestone_id);
const project = milestone ? await getProject(milestone.project_id) : null;
---

<Portal title={task.title}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-6">
      <a href={`/portal/admin/milestones/${task.milestone_id}`} class="text-xs text-neutral-600 hover:text-amber-400 transition-colors">&larr; {milestone?.title || 'Milestone'}</a>
    </div>

    <div class="flex items-start justify-between mb-8">
      <div>
        <p class="text-amber-400 font-mono text-[10px] tracking-[0.2em] uppercase mb-2">Task</p>
        <h1 class="font-serif text-3xl text-neutral-100">{task.title}</h1>
      </div>
      <button id="delete-task" class="text-xs text-neutral-600 hover:text-red-400 transition-colors">Delete</button>
    </div>

    <div class="bg-neutral-900/30 border border-white/5 rounded-2xl p-8">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Status</label>
          <select id="f-status" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            {['todo', 'in_progress', 'review', 'done', 'blocked'].map(s => (
              <option value={s} selected={s === task.status}>{s.replace(/_/g, ' ')}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Priority</label>
          <select id="f-priority" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            {['low', 'normal', 'high', 'urgent'].map(p => (
              <option value={p} selected={p === task.priority}>{p}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Due date</label>
          <input type="date" id="f-due" value={task.due_date || ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Estimated hours</label>
          <input type="number" id="f-est" step="0.5" value={task.estimated_hours ?? ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Actual hours</label>
          <input type="number" id="f-actual" step="0.5" value={task.actual_hours ?? ''} class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30" />
        </div>
        <div>
          <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Client visible</label>
          <select id="f-visible" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">
            <option value="1" selected={task.client_visible === 1}>Yes</option>
            <option value="0" selected={task.client_visible === 0}>No</option>
          </select>
        </div>
      </div>
      <div class="mt-5">
        <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Description (internal)</label>
        <textarea id="f-desc" rows="3" class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">{task.description || ''}</textarea>
      </div>
      <div class="mt-5">
        <label class="block text-[10px] font-mono text-neutral-600 tracking-wide uppercase mb-2">Client update text</label>
        <textarea id="f-client-text" rows="2" placeholder="What the client sees about this task..." class="w-full px-4 py-3 bg-neutral-900/50 border border-white/5 rounded-lg text-neutral-200 text-sm focus:outline-none focus:border-amber-500/30">{task.client_update_text || ''}</textarea>
      </div>
      <button id="save-task" class="mt-6 px-6 py-3 bg-amber-500 text-neutral-950 font-semibold text-sm rounded-lg hover:bg-amber-400 transition-all duration-300">Save changes</button>
    </div>
  </div>

  <script define:vars={{ taskId: id, milestoneId: task.milestone_id }}>
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';

    document.getElementById('save-task')?.addEventListener('click', async () => {
      const res = await fetch(`/portal/api/admin/tasks/${taskId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
        body: JSON.stringify({
          status: document.getElementById('f-status').value,
          priority: document.getElementById('f-priority').value,
          due_date: document.getElementById('f-due').value || null,
          estimated_hours: document.getElementById('f-est').value ? Number(document.getElementById('f-est').value) : null,
          actual_hours: document.getElementById('f-actual').value ? Number(document.getElementById('f-actual').value) : null,
          client_visible: Number(document.getElementById('f-visible').value),
          description: document.getElementById('f-desc').value.trim() || null,
          client_update_text: document.getElementById('f-client-text').value.trim() || null,
        }),
      });
      if (res.ok) window.__toast({ type: 'success', message: 'Task updated' });
      else window.__toast({ type: 'error', message: 'Failed to save' });
    });

    document.getElementById('delete-task')?.addEventListener('click', async () => {
      const confirmed = await window.__confirm({
        title: 'Delete task', message: 'This task will be permanently deleted.',
        confirmLabel: 'Delete', danger: true,
      });
      if (!confirmed) return;
      const res = await fetch(`/portal/api/admin/tasks/${taskId}`, {
        method: 'DELETE', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
      });
      if (res.ok) {
        window.__toast({ type: 'success', message: 'Task deleted' });
        setTimeout(() => window.location.href = `/portal/admin/milestones/${milestoneId}`, 600);
      } else window.__toast({ type: 'error', message: 'Failed to delete' });
    });
  </script>
</Portal>
